[Desktop Entry]
Exec=smart-video-processor --new-instance %F
Icon=${SNAP}/meta/gui/smart-video-processor.png
Type=Application
Terminal=false
Name=Smart Video Processor
Comment=Automated video processing. Re-Organize, Re-mux, Re-encode, adds metadata and icon when needed.
Categories=AudioVideo;
MimeType=video/x-matroska;video/x-msvideo;video/mp4;
Keywords=encode;organize;video;movie;show;
