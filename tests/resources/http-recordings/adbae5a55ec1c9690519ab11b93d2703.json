"{\"status\":\"success\",\"data\":{\"id\":81797,\"name\":\"ワンピース\",\"slug\":\"one-piece\",\"image\":\"https://artworks.thetvdb.com/banners/series/81797/posters/5eec847d52a04.jpg\",\"nameTranslations\":[\"deu\",\"eng\",\"fra\",\"heb\",\"ita\",\"jpn\",\"kor\",\"nld\",\"por\",\"rus\",\"spa\",\"zho\",\"pt\",\"cat\",\"ara\",\"msa\",\"tur\",\"srp\",\"tha\",\"vie\",\"zhtw\",\"pol\",\"nep\",\"ind\",\"fin\",\"ukr\"],\"overviewTranslations\":[\"deu\",\"eng\",\"fra\",\"heb\",\"ita\",\"jpn\",\"kor\",\"nld\",\"por\",\"rus\",\"spa\",\"zho\",\"pt\",\"cat\",\"ara\",\"msa\",\"tur\",\"srp\",\"vie\",\"zhtw\",\"pol\",\"nep\",\"ind\",\"fin\",\"ukr\"],\"aliases\":[{\"language\":\"zho\",\"name\":\"海贼王\"},{\"language\":\"zho\",\"name\":\"海贼王TV\"},{\"language\":\"vie\",\"name\":\"Đảo Hải Tặc\"},{\"language\":\"zhtw\",\"name\":\"海賊王\"},{\"language\":\"zhtw\",\"name\":\"ONE PIECE\"},{\"language\":\"jpn\",\"name\":\"Wan Pisu\"},{\"language\":\"nep\",\"name\":\"वान पीस\"},{\"language\":\"ara\",\"name\":\"ون بيس\"},{\"language\":\"ara\",\"name\":\"القطعة الواحدة\"},{\"language\":\"ara\",\"name\":\"القطعة النادرة\"},{\"language\":\"eng\",\"name\":\"One Piece (1998)\"},{\"language\":\"eng\",\"name\":\"One Piece Log: Fish-Man Island Saga\"},{\"language\":\"eng\",\"name\":\"One Piece: Egghead Island (1089-Current)\"},{\"language\":\"ita\",\"name\":\"One Piece - All'arrembaggio!\"},{\"language\":\"ita\",\"name\":\"All'arrembaggio!\"}],\"firstAired\":\"1999-10-20\",\"lastAired\":\"2026-08-16\",\"nextAired\":\"2026-08-16\",\"score\":3236299,\"status\":{\"id\":1,\"name\":\"Continuing\",\"recordType\":\"series\",\"keepUpdated\":true},\"originalCountry\":\"jpn\",\"originalLanguage\":\"jpn\",\"defaultSeasonType\":1,\"isOrderRandomized\":false,\"lastUpdated\":\"2026-08-16 18:17:32\",\"averageRuntime\":25,\"episodes\":[{\"id\":361887,\"seriesId\":81797,\"name\":\"Je suis Luffy ! Celui qui deviendra Roi des pirates !\",\"aired\":\"1999-10-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les pirates d'Alvida pillent un navire et découvrent un tonneau contenant un étrange garçon nommé Luffy qui a pour mission de trouver le légendaire One Piece et de devenir le Roi des pirates.\",\"overviewTranslations\":null,\"image\":\"/banners/v4/episode/361887/screencap/604df7d3ecf3a.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":1,\"absoluteNumber\":1,\"seasonNumber\":1,\"lastUpdated\":\"2025-10-30 00:07:58\",\"finaleType\":null,\"year\":\"1999\"},{\"id\":361888,\"seriesId\":81797,\"name\":\"Le grand manieur de sabre ! Roronoa Zoro, chasseur de pirates !\",\"aired\":\"1999-11-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Accompagné de Kobby, Luffy part à la recherche du célèbre chasseur de primes Roronoa Zoro. Le garçon au chapeau de paille est bien déterminé à en faire un membre de son équipage. Cependant, ce dernier est retenu prisonnier dans une base navale de la marine.\",\"overviewTranslations\":null,\"image\":\"/banners/v4/episode/361888/screencap/604df7f785903.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":2,\"absoluteNumber\":2,\"seasonNumber\":1,\"lastUpdated\":\"2025-10-30 02:53:55\",\"finaleType\":null,\"year\":\"1999\"},{\"id\":361889,\"seriesId\":81797,\"name\":\"Morgan vs Luffy ! Qui est cette belle inconnue ?\",\"aired\":\"1999-11-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy réussit à libérer Zoro de ses chaines. Après un chantage pour le moins douteux, Zoro accepte de rejoindre l’équipage de Luffy. Ils doivent maintenant livrer bataille contre le colonel Morgan !\",\"overviewTranslations\":null,\"image\":\"/banners/v4/episode/361889/screencap/604df8b796ccd.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":3,\"absoluteNumber\":3,\"seasonNumber\":1,\"lastUpdated\":\"2025-10-30 02:59:49\",\"finaleType\":null,\"year\":\"1999\"},{\"id\":361890,\"seriesId\":81797,\"name\":\"Le passé de Luffy ! L’apparition de Shanks Le Roux.\",\"aired\":\"1999-12-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Se laissant porter par les vagues, Luffy raconte à Zoro comment il a obtenu son fameux chapeau de paille ! L’occasion de découvrir les origines de ses étranges pouvoirs…\",\"overviewTranslations\":null,\"image\":\"/banners/v4/episode/361890/screencap/604df8f7a790c.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":4,\"absoluteNumber\":4,\"seasonNumber\":1,\"lastUpdated\":\"2025-10-30 03:04:13\",\"finaleType\":null,\"year\":\"1999\"},{\"id\":361891,\"seriesId\":81797,\"name\":\"Pouvoirs mystérieux épouvantables ! Capitaine Baggy le Clown !\",\"aired\":\"1999-12-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy, attrapé puis lâché sur une île par un oiseau géant tombe nez à nez avec une jeune fille : Nami. Cette dernière est poursuivie par des pirates, mais Luffy vole à son secours. Malheureusement pour lui, Nami va se servir de lui pour arriver à ses fins… C’est à ce moment-là que le capitaine Baggy le Clown fait son entrée en scène !\",\"overviewTranslations\":null,\"image\":\"/banners/v4/episode/361891/screencap/604df915cd549.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":5,\"absoluteNumber\":5,\"seasonNumber\":1,\"lastUpdated\":\"2025-10-30 03:07:37\",\"finaleType\":null,\"year\":\"1999\"},{\"id\":361894,\"seriesId\":81797,\"name\":\"Situation désespérée ! Morge, le dresseur de fauves contre Luffy !\",\"aired\":\"1999-12-29\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy est retenu prisonnier dans une cage et la situation semble désespérée ! Zoro entame alors un combat contre Baggy et parvient à sauver Luffy in extremis. Entre temps, Morge, un des hommes de Baggy, fait son apparition accompagné d’un immense lion…\",\"overviewTranslations\":null,\"image\":\"/banners/v4/episode/361894/screencap/604dfa115b207.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":6,\"absoluteNumber\":6,\"seasonNumber\":1,\"lastUpdated\":\"2025-10-30 03:10:18\",\"finaleType\":null,\"year\":\"1999\"},{\"id\":361895,\"seriesId\":81797,\"name\":\"Combat acharné : Zoro, le manieur de sabres vs Cabaji, l’acrobate.\",\"aired\":\"1999-12-29\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et Zoro combattent l’équipage de Baggy le Clown ! L’affrontement entre Zoro et Cabaji fait rage, tandis que Nami est à la recherche de la carte de Grand Line.\",\"overviewTranslations\":null,\"image\":\"/banners/v4/episode/361895/screencap/604dfa349236e.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":7,\"absoluteNumber\":7,\"seasonNumber\":1,\"lastUpdated\":\"2025-10-30 03:15:46\",\"finaleType\":null,\"year\":\"1999\"},{\"id\":361896,\"seriesId\":81797,\"name\":\"Qui sortira vainqueur ? Le bras de fer des pouvoirs des fruits du Démon !\",\"aired\":\"1999-12-29\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le combat entre Luffy et Baggy continue. Ce dernier révèle les surprenantes origines de ses pouvoirs, alors que la fin du combat est proche ! Nami, quant à elle, décide rejoindre Zoro et Luffy, pour un temps seulement.\",\"overviewTranslations\":null,\"image\":\"/banners/v4/episode/361896/screencap/604dfa5033a48.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":8,\"absoluteNumber\":8,\"seasonNumber\":1,\"lastUpdated\":\"2025-10-30 03:18:12\",\"finaleType\":\"season\",\"year\":\"1999\"},{\"id\":361897,\"seriesId\":81797,\"name\":\"Le justicier menteur : Capitaine Usopp\",\"aired\":\"2000-01-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy, Zoro et Nana débarquent dans un village particulièrement calme où ils font la rencontre d'Usopp, mythomane incorrigible qui s'imagine pirate à défaut de ne pouvoir l'être.\",\"overviewTranslations\":null,\"image\":\"/banners/v4/episode/361897/screencap/604dfc9500a38.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":9,\"absoluteNumber\":9,\"seasonNumber\":1,\"lastUpdated\":\"2025-12-01 04:57:39\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361898,\"seriesId\":81797,\"name\":\"Un étranger des plus étranges : Django, l'hypnotiseur\",\"aired\":\"2000-01-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Un type bizarre fait son apparition dans le village: il se dit hypnotiseur et s'appelle Jango. En réalité, Jango a été employé dans une mission bien précise: tuer Kaya, la jeune fille malade qu'aime Usopp.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361898.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":10,\"absoluteNumber\":10,\"seasonNumber\":1,\"lastUpdated\":\"2025-12-01 05:02:58\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361899,\"seriesId\":81797,\"name\":\"Un plan machiavélique ! Le capitaine Kuro\",\"aired\":\"2000-01-26\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le capitaine Kuro et sa bande s'apprêtent à attaquer le village et à tuer Kaya! Usopp tente d'avertir les habitants. Malheureusement personne ne le croit, car il a toujours menti jusqu'à présent...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361899.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":11,\"absoluteNumber\":11,\"seasonNumber\":1,\"lastUpdated\":\"2025-12-01 05:14:21\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361900,\"seriesId\":81797,\"name\":\"Un affrontement violent ! La grande bataille contre l'équipage du Chat Noir !\",\"aired\":\"2000-02-02\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les pirates de Jango l'hypnotiseur débarquent sur l'île. Mais Usopp est bien décidé à ne pas les laisser faire. D'autant plus que Nami, Zoro et Luffy décident finalement de lui donner un coup de main pour défendre son village\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361900.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":12,\"absoluteNumber\":12,\"seasonNumber\":1,\"lastUpdated\":\"2025-12-01 05:16:32\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361901,\"seriesId\":81797,\"name\":\"Le duo de choc ! Les frères Siamois contre Zoro !\",\"aired\":\"2000-02-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy est tombé dans un sommeil hypnotique ainsi que tout l'équipage de Jango. Mais ce dernier sort sa botte secrète: les Nyaban Brothers dont il ne reste plus que Zoro pour s'en occuper.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361901.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":13,\"absoluteNumber\":13,\"seasonNumber\":1,\"lastUpdated\":\"2025-12-01 05:20:31\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361902,\"seriesId\":81797,\"name\":\"Luffy se réveille - La rébellion de Mademoiselle Kaya\",\"aired\":\"2000-02-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le capitaine Kuro, qui en avait marre d'attendre, débarque lui aussi sur les lieux et il n'est pas du tout content. Il donne 5 minutes à ses pirates pour se débarrasser des gêneurs, sinon il tue tout le monde de ses propres mains.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361902.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":14,\"absoluteNumber\":14,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:03:57\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361903,\"seriesId\":81797,\"name\":\"La bataille contre Kuro ! La détermination d'Usopp\",\"aired\":\"2000-02-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Alors que Usopp ne semble pas en démordre avec la protection à tout prix de Kaya, on en apprend un peu plus sur le passé du capitaine Kuro.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361903.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":15,\"absoluteNumber\":15,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:04:24\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361904,\"seriesId\":81797,\"name\":\"Protégez Kaya ! La bande à Usopp entre en jeu !\",\"aired\":\"2000-03-01\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Usopp a chargé sa bande de pirates, composés de trois gamins du village, d'escorter Kaya loin de Kuro. Malheureusement, Jango est à leur poursuite. Pendant ce temps, Kuro et Luffy continuent à s'affronter.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361904.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":16,\"absoluteNumber\":16,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:04:41\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361906,\"seriesId\":81797,\"name\":\"L'explosion de colère ! Kuro contre Luffy : le combat final\",\"aired\":\"2000-03-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy parvient finalement à écraser Kuro dans un élan de révolte. Le village est donc sauvé. Usopp, quant à lui, s'apprête à prendre une décision importante...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361906.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":17,\"absoluteNumber\":17,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:05:05\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361907,\"seriesId\":81797,\"name\":\"Un animal étrange : Gaimon et ses drôles d'amis\",\"aired\":\"2000-03-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'équipe de Luffy débarque sur une île pleine de mystères, où se trouverait un très grand trésor qu'aucun pirate n'a réussi à prendre. Ils y seront accueillis par un homme pour le moins bizarre: Gaimon.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361907.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":18,\"absoluteNumber\":18,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:07:59\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361908,\"seriesId\":81797,\"name\":\"Le passé des trois sabres ! La promesse de Zoro et Kuina\",\"aired\":\"2000-03-22\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Dans cet épisode, nous replongeons dans l'enfance de Zoro, le jour où il rentra dans un dojo apprendre les techniques du sabre. C'est là qu'il rencontra Kuina, une jeune fille désireuse de devenir la plus grande épéiste du monde et que personne n'arrivait à battre. Zoro se souvient de la promesse qu'ils s'étaient alors faites tous les deux...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361908.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":19,\"absoluteNumber\":19,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:08:15\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361909,\"seriesId\":81797,\"name\":\"Un fameux cuistot ! Sanji sur le navire-restaurant\",\"aired\":\"2000-04-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et sa bande dégradent involontairement le toit d'un restaurant des mers. Notre capitaine au chapeau de paille essaie de se faire pardonner auprès du chef. Pendant ce temps, un étrange employé, qui se dit assistant du chef et non simple serveur, tourne au ridicule un marine venu épater sa copine.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361909.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":20,\"absoluteNumber\":20,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:08:31\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361910,\"seriesId\":81797,\"name\":\"Un invité indésirable ! Le repas de Sanji et les obligations de Gyn\",\"aired\":\"2000-04-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le restaurant voit arriver un client particulier: un pirate réputé dangereux, qui s'est échappé du bateau du marine, où on l'avait laissé sans nourriture depuis très longtemps. Mais à la grande surprise des autres clients, le staff du restaurant semble parfaitement à l'aise avec cette situation....\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361910.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":21,\"absoluteNumber\":21,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:08:52\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361911,\"seriesId\":81797,\"name\":\"Une armada impressionnante ! Le terrible amiral Don Krieg\",\"aired\":\"2000-04-26\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'un des plus terrifiants pirates fait son entrée dans le restaurant: Don Krieg. Il a l'air exténué et supplie qu'on lui serve à manger. Mais son attitude a plutôt l'air louche et donne matière à s'inquiéter!\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361911.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":22,\"absoluteNumber\":22,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:11:30\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361912,\"seriesId\":81797,\"name\":\"Sauvez le Baratie ! Le grand pirate Zeff aux Pieds Rouges\",\"aired\":\"2000-05-03\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Don Krieg est sur le point d'attaquer le restaurant le Baratie. Mais le chef et tout son staff ne sont pas prêts d'accepter le sort qui les attend. D'autant plus que le chef en question, Zeff, n'est autre qu'un célèbre ancien pirate lui aussi...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361912.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":23,\"absoluteNumber\":23,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:13:39\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361913,\"seriesId\":81797,\"name\":\"Mihawk, l'Oeil de Faucon ! La défaite de Zoro, le légendaire manieur de sabre\",\"aired\":\"2000-05-10\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'homme que Zoro avait l'intention de rencontrer et d'affronter à la Grand Line fait une apparition soudaine et pour le moins inattendue: Mihawk. Venu pour faire son compte à Don Krieg, il va finalement se battre contre Zoro...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361913.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":24,\"absoluteNumber\":24,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:13:52\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361914,\"seriesId\":81797,\"name\":\"Explosion de coups de pied ! Sanji contre Pearl Bouclier d'Acier\",\"aired\":\"2000-05-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Sanji veut à tout prix protéger le restaurant dont il veut devenir le chef un jour. Pour cela, il est prêt à affronter un redoutable pirate appartenant à l'équipage de Don Krieg: Pearl, surnommé le mur d'acier!\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361914.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":25,\"absoluteNumber\":25,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:14:08\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361915,\"seriesId\":81797,\"name\":\"Le rêve de Zeff et Sanji ! Le miracle de All Blue\",\"aired\":\"2000-05-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zeff est sous la menace des pirates. Mais Sanji veut à tout prix le protéger, lui et son oeuvre, le restaurant Baratie. Il se rappelle alors sa rencontre avec le vieux chef, qui avait sacrifié sa jambe pour le jeune Sanji...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361915.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":26,\"absoluteNumber\":26,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:14:23\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361916,\"seriesId\":81797,\"name\":\"Un ennemi démoniaque sans coeur. Gyn, le vice-amiral\",\"aired\":\"2000-05-31\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Gin doit obéir à Don Krieg et donc tuer Sanji. Il se révèle être en réalité non pas un simple pirate mais un commandant très redouté pour sa froideur. Mais Gin se souvient que Sanji lui a sauvé la vie, ce qui rend la tâche plus ardue...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361916.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":27,\"absoluteNumber\":27,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:14:45\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361917,\"seriesId\":81797,\"name\":\"Je ne mourrai pas ! Combat acharné : Luffy VS Don Krieg\",\"aired\":\"2000-06-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy affronte enfin Don Krieg dans un combat qui semble rapidement tourner à l'avantage de ce dernier!\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361917.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":28,\"absoluteNumber\":28,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:14:58\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361918,\"seriesId\":81797,\"name\":\"Fin du combat acharné ! L'ultime noeud dans le ventre\",\"aired\":\"2000-06-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Don Krieg et Luffy s'affrontent toujours et la fin pour l'un d'entre eux deux semble être très proche...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361918.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":29,\"absoluteNumber\":29,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:15:13\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361919,\"seriesId\":81797,\"name\":\"L'heure du départ ! Le cuisinier marin embarque avec Luffy\",\"aired\":\"2000-06-28\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La bande de Don Krieg est finalement battue et c'est l'heure de faire le bilan pour Sanji. Il rêve un jour d'aller voir le \\\"All Blue\\\", une mer mythique où se trouve une grande variété de poissons, mais n'a pas envie de quitter le Baratie. C'est donc un choix cornélien qui se pose à lui...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361919.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":30,\"absoluteNumber\":30,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:15:31\",\"finaleType\":\"season\",\"year\":\"2000\"},{\"id\":361920,\"seriesId\":81797,\"name\":\"Le plus ingrat des mers de l'Est : Arlong, le pirate homme-poisson !\",\"aired\":\"2000-07-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy va à la recherche de Nami partie elle-même chercher la tête d'un pirate dénommé Arlong, sur son île où il entouré de toute sa bande d'hommes poissons. Mais il ne se doute pas que la force de ces derniers est réputée dix fois supérieure à celle des humains...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361920.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":31,\"absoluteNumber\":31,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:15:52\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361921,\"seriesId\":81797,\"name\":\"La sorcière du village de Cocoyashi ! La dirigeante du clan Arlong\",\"aired\":\"2000-07-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nami semble avoir rejoint le côté d'Arlong. En étant son bras-droit, elle s'est mis à dos tout le village de Kokoyashi ainsi que sa grande soeur, Nojiko. Mais ce que personne ne sait, c'est que Nami a un objectif bien précis et qu'elle n'est pas la \\\"sorcière\\\" qu'on dit...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361921.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":32,\"absoluteNumber\":32,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:16:21\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361922,\"seriesId\":81797,\"name\":\"La disparition d'Usopp ! A quand le débarquement de Luffy ?\",\"aired\":\"2000-07-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nami a éveillé les soupçons de la bande de pirates homme poissons. Son plan risque d'être découvert à cause de Zoro. Au même moment, Usopp a été capturé et emmené au QG. Nami voit alors en lui un bon moyen de retrouver la confiance d'Arlong: en le tuant...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361922.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":33,\"absoluteNumber\":33,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:16:42\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361923,\"seriesId\":81797,\"name\":\"L'équipage se retrouve ! La vérité sur Nami selon Usopp\",\"aired\":\"2000-07-26\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Usopp est bien vivant et il court raconter à Zoro, Luffy et Sanji la vérité au sujet de Nami. Cette dernière semble particulièrement tendue en raison de la présence de son ancien équipage...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361923.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":34,\"absoluteNumber\":34,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:16:55\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361924,\"seriesId\":81797,\"name\":\"Retour vers le passé ! La combattante Belmer\",\"aired\":\"2000-08-02\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nojiko raconte son enfance et celle de Nami à l’équipage de Luffy. Quand elles étaient petites filles, Belmer, leur mère adoptive, les sauve d’une vie de misère…\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361924.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":35,\"absoluteNumber\":35,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:17:12\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361925,\"seriesId\":81797,\"name\":\"Il faut survivre ! Le lien éternel de Belmer et de Nami !\",\"aired\":\"2000-08-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nojiko raconte le passé de Nami et le choc émotionnel subi par les deux jeunes filles lorsqu'elles ont perdu leur \\\"mère\\\", Bellemere. Cette dernière a sacrifié sa propre existence afin de les maintenir en vie. Nojiko et Nami ont donc été épargnées, mais n'ont pas suivi le même chemin. La première est restée à Cocoyashi, auprès des siens, et la seconde a rejoint de force la bande d'Arlong...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361925.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":36,\"absoluteNumber\":36,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:17:31\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361926,\"seriesId\":81797,\"name\":\"Luffy arrive ! La fin de la trahison !\",\"aired\":\"2000-08-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Arlong a finalement rompu sa promesse, car il a envoyé des marines chercher le butin de Nami, caché dans la maison de Bellemere. Nami est dévastée moralement mais elle continue à vouloir avant tout protéger le village et ses habitants. Ces derniers refusent leur sort et décident de prendre les armes pour affronter Arlong et sa bande... C'est là qu'intervient Luffy!\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361926.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":37,\"absoluteNumber\":37,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:17:48\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361927,\"seriesId\":81797,\"name\":\"Luffy en grand danger ! Le clan de Luffy VS les hommes-poissons\",\"aired\":\"2000-08-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy, Sanji, Zoro et Usopp rentrent dans le QG du gang d'Arlong. C'est le début de la confrontation qui devra libérer le village. Cependant, nos héros n'ont pas encore pleinement conscience de la force surhumaine que possèdent les homme-poissons...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361927.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":38,\"absoluteNumber\":38,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:44:10\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361928,\"seriesId\":81797,\"name\":\"Luffy s'immerge ! Zoro VS Octy !\",\"aired\":\"2000-08-30\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro doit affronter Hachi, l'homme-pieuvre dont la particularité est de pouvoir maîtriser simultanément six sabres! Le San Tou Ryu (utilisation de trois sabres) de Zoro va-t-il suffir?\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361928.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":39,\"absoluteNumber\":39,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:44:31\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361929,\"seriesId\":81797,\"name\":\"Les glorieux guerriers ! Les combats acharnés de Sanji et Usopp !\",\"aired\":\"2000-09-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Sanji affronte Kuroobi, un homme-poisson expert en karaté. Mais il se place dans une position très difficile: en effet, il plonge de plein gré dans l'eau et prend le risque ainsi de perdre la moitié de sa force tandis que son ennemi voit la sienne augmenter. Pendant ce temps, Usopp a également de la peine à se débarrasser de son adversaire...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361929.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":40,\"absoluteNumber\":40,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:44:46\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361930,\"seriesId\":81797,\"name\":\"Luffy, tu es le meilleur ! La courageuse Nami et le chapeau de paille\",\"aired\":\"2000-09-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nami fait son entrée pour clamer haut et fort qu'elle s'apprête à tuer Arlong. Mais au même moment, grâce au temps gagné par Zoro, Sanji parvient à libérer Luffy du fond de la mer. Les choses sérieuses peuvent donc commencer!\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361930.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":41,\"absoluteNumber\":41,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:44:59\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361931,\"seriesId\":81797,\"name\":\"Arlong, l'homme-requin. Le danger vient de la mer !\",\"aired\":\"2000-09-27\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le combat final entre Luffy et Arlong vient de commencer! Luffy va vite s'apercevoir que les dents de son adversaire sont durs comme l'acier et qu'elles repoussent à l'infini! Mais rien est impossible pour notre héros, qui va rapidement trouver des parades...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361931.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":42,\"absoluteNumber\":42,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:45:21\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361932,\"seriesId\":81797,\"name\":\"La chute de l'empire des hommes-poissons ! Nami est ma partenaire !\",\"aired\":\"2000-09-27\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"C'est un combat très violent qui oppose Luffy à Arlong, mais finalement notre héros au chapeau de paille parvient à anéantir la base des homme-poissons et terrasse le tyran.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361932.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":43,\"absoluteNumber\":43,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:45:48\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361933,\"seriesId\":81797,\"name\":\"Partir le sourire aux lèvres ! Au revoir, Cocoyashi, mon village !\",\"aired\":\"2000-10-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le village de Cocoyashi est enfin libérée. C'est la fête au village et Nami a enfin l'esprit libre, elle qui a dû longtemps cacher son jeu pour épargner ceux qu'elle aime. Mais c'est l'heure de partir pour l'équipage de Luffy!\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361933.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":44,\"absoluteNumber\":44,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:46:08\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361934,\"seriesId\":81797,\"name\":\"La tête mise à prix ! Luffy au chapeau de paille devient une célébrité mondiale !\",\"aired\":\"2000-10-25\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy découvre que sa tête est mise à prix: il vaut 30 millions. Pour son équipage et lui, la route sera ainsi un plus difficile que prévue car tous les chasseurs de primes vont probablement être à leur trousse!\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361934.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":45,\"absoluteNumber\":45,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:46:21\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361935,\"seriesId\":81797,\"name\":\"A la poursuite de Luffy ! Les aventures de Baggy rétréci !\",\"aired\":\"2000-11-01\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et Nami s'étaient rencontrés alors que cette dernière tentait de se débarrasser d'un certain pirate au nez de clown, Buggy. Cet épisode nous donne des nouvelles de lui. Nous suivons ainsi ses dernières péripéties dans l'océan...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361935.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":46,\"absoluteNumber\":46,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:46:35\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361936,\"seriesId\":81797,\"name\":\"Vous l'attendiez depuis longtemps... Le capitaine Baggy est de retour !\",\"aired\":\"2000-11-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Buggy le pirate a été sauvé par une mystérieuse demoiselle, qui veut visiblement avoir la tête de Luffy. Ensemble, ils partent d'abord à la recherche de l'ancien équipage du pirate clown. Les membres de ce dernier ne se doutent même pas que leur capitaine est encore en vie!\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361936.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":47,\"absoluteNumber\":47,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:46:48\",\"finaleType\":\"season\",\"year\":\"2000\"},{\"id\":361937,\"seriesId\":81797,\"name\":\"La ville où tout a commencé et où tout a fini ! L'arrivée à Logue Town !\",\"aired\":\"2000-11-22\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et son équipage débarque sur Logue Town: l'endroit où est né et mort le seigneur des pirates, Gold Roger. Luffy cherche absolument le lieu de son exécution. Mais il ne se doute pas que Logue Town est une ville dont aucun pirate n'a pu partir une fois dedans. En effet, le redoutable Capitaine Smoker veille...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361937.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":48,\"absoluteNumber\":48,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:47:06\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361938,\"seriesId\":81797,\"name\":\"Sandai Kitetsu et Yubashiri ! Les nouveaux sabres de Zoro !\",\"aired\":\"2000-11-22\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro a fait la rencontre d'une jeune fille très douée avec les sabres. Malheureusement pour lui, elle fait partie des Marines et se révèle être une collègue de Capitaine Smoker. Pour le moment, Zoro est la quête de deux nouveaux sabres, c'est tout ce qui lui importe...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361938.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":49,\"absoluteNumber\":49,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:47:28\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361939,\"seriesId\":81797,\"name\":\"Usopp VS Daddy Masterson ! Duel sous le soleil !\",\"aired\":\"2000-11-29\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Suite à des circonstances particulières, Usopp se voit contraint de faire un duel contre un homme connu de tous les pirates: Daddy. Ce dernier est un proche du Capitaine Smoker et lui aussi un ancien marine. Autant dire que notre ami Usopp se trouve dans de beaux draps !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361939.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":50,\"absoluteNumber\":50,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:47:44\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361940,\"seriesId\":81797,\"name\":\"Une bataille culinaire des plus brûlantes ! Sanji VS le séduisant chef\",\"aired\":\"2000-12-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Sanji se voit lancer un défi lui aussi: une jeune et belle femme du nom de Carmen l'invite à concourir contre elle pour devenir le meilleur de chef de tout l'East Blue. Sanji se décide finalement à participer au concours quand il vit le trophée en jeu: un poisson très rare qui a des traits d'éléphant...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361940.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":51,\"absoluteNumber\":51,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:47:59\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361941,\"seriesId\":81797,\"name\":\"La revanche de Baggy ! L'homme qui sourit sur l'échafaud !\",\"aired\":\"2000-12-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy retrouve le chemin du lieu d'exécution de Gold Roger. Au même temps, une voix de femme l'apostrophe: il s'agit d'Alvida, la pirate pour qui travaillait Coby au début de la série. Cette dernière est cependant méconnaissable après avoir mangé un Fruit du Démon. Elle présente alors son partenaire, lui aussi une vieille connaissance de Luffy, le Capitaine Buggy!\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361941.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":52,\"absoluteNumber\":52,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 12:48:16\",\"finaleType\":null,\"year\":\"2000\"},{\"id\":361942,\"seriesId\":81797,\"name\":\"La légende est en marche ! En route pour Grande Line !\",\"aired\":\"2001-01-10\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy a réussi par un coup de chance à échapper à Buggy. Mais ses ennuis ne vont s'arrêter pour autant, puisque le Capitaine Smoker est à ses trousses. Pendant ce temps, Zoro affronte le Major Tashigi, qui ressemble comme deux gouttes d'eau à son amie d'enfance...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361942.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":53,\"absoluteNumber\":53,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:08:23\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361943,\"seriesId\":81797,\"name\":\"Le présentiment d'une nouvelle aventure ! Une fille mystérieuse : Apis !\",\"aired\":\"2001-01-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'équipage de Luffy trouve dans la mer une mystérieuse fillette. Elle s'appelle Apis et dit avoir pris la fuite des Marines... Ces derniers vont rapidement faire leur apparition pour la récupérer!\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361943.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":54,\"absoluteNumber\":54,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:08:43\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361944,\"seriesId\":81797,\"name\":\"Le dragon sacré ! Le secret d'Apis et lîle légendaire !\",\"aired\":\"2001-01-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nos héros ont décidé de ramener Apis dans son île d'origine. Là-bas, ils découvriront le secret de la fillette et les raisons qui poussent les marines à la capturer.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361944.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":55,\"absoluteNumber\":55,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:08:56\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361945,\"seriesId\":81797,\"name\":\"L'attaque d'Erik ! La grande évasion de l'île du vaisseau de Guerre !\",\"aired\":\"2001-01-31\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et sa bande ont pris la décision de donner un coup de main à Apis et de ramener son dragon, Ryuuji, dans son île originelle. Cette dernière porte bien son nom puisqu'elle s'appelle Lost Island et qu'elle ne se trouve sur aucune carte...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361945.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":56,\"absoluteNumber\":56,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:09:13\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361946,\"seriesId\":81797,\"name\":\"Une île isolée sur la mer lointaine. La légendaire île perdue !\",\"aired\":\"2001-02-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'équipage du Going Merry prend finalement la direction de Lost Island, car Ryuuji vient de se souvenir de son emplacement. Pendant ce temps, les Marines dirigés par Erik remarquent ce changement de cap et décident de faire barrage à nos héros.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361946.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":57,\"absoluteNumber\":57,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:09:26\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361947,\"seriesId\":81797,\"name\":\"Duel dans les ruines ! Zoro VS Erik !\",\"aired\":\"2001-02-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'équipage de Luffy parvient à Lost Island avec à son bord le dragon. Mais rapidement, nos héros comprennent que l'endroit où doit reposer Ryuuji ne se trouve pas là...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361947.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":58,\"absoluteNumber\":58,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:09:43\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361948,\"seriesId\":81797,\"name\":\"Luffy complètement encerclé ! Le plan secret de l'amiral Nelson\",\"aired\":\"2001-02-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le Going Merry se fait bloquer par l'énorme flotte de l'Amiral Nelson, qui souhaite plus que tout dérober le dragon pour obtenir la jeunesse éternelle. Malheureusement pour lui, Erik compte bien prendre tout le butin sans en partager une miette !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361948.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":59,\"absoluteNumber\":59,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:09:58\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361949,\"seriesId\":81797,\"name\":\"Objet volant non identifié ! La légende revit !\",\"aired\":\"2001-02-28\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy n'a pas l'intention de laisser l'Amiral Nelson et Erik s'emparer de Ryuuji. De plus, le dragon commence à perdre ses forces et on ne trouve toujours pas Lost Island...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361949.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":60,\"absoluteNumber\":60,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:10:31\",\"finaleType\":\"season\",\"year\":\"2001\"},{\"id\":361950,\"seriesId\":81797,\"name\":\"La défense des dragons ! Vol au dessus de Red Line !\",\"aired\":\"2001-03-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'équipage du Going Merry quitte l'île d'Apis pour se rendre enfin à Grand Line. Nami remarque un détail étrange sur la carte: pour arriver à Grand Line, il faut passer par une montagne, la Red Line...\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361950.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":61,\"absoluteNumber\":61,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:10:47\",\"finaleType\":\"season\",\"year\":\"2001\"},{\"id\":361955,\"seriesId\":81797,\"name\":\"Le premier obstacle ? Laboon la baleine géante apparaît\",\"aired\":\"2001-03-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'équipage du chapeau de paille, après un voyage mouvementé par-dessus une montagne, finit dans le ventre d'une baleine géante qui est à l'affût des pirates !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361955.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":62,\"absoluteNumber\":62,\"seasonNumber\":1,\"lastUpdated\":\"2026-03-01 18:51:30\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361956,\"seriesId\":81797,\"name\":\"Promesse entre hommes ! Luffy et la baleine promettent de se revoir\",\"aired\":\"2001-03-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy échange des coups avec Laboon la baleine, et Nami est angoissée d'apprendre que la navigation sur Grand Line n'est pas une partie de plaisir.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361956.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":63,\"absoluteNumber\":63,\"seasonNumber\":1,\"lastUpdated\":\"2026-03-01 18:53:35\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361957,\"seriesId\":81797,\"name\":\"Une ville accueillant les pirates ? Débarquement à Whiskey Peak\",\"aired\":\"2001-04-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Une violente tempête de neige s'abat sur la troupe du Vogue Merry, mais une fois l'équipage du chapeau de paille arrivé à Whisky Peak, les autochtones les invitent à une fête très agitée.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361957.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":64,\"absoluteNumber\":64,\"seasonNumber\":1,\"lastUpdated\":\"2026-03-01 18:54:07\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361958,\"seriesId\":81797,\"name\":\"Les trois sabres explosifs ! Zoro VS Baroque Works !\",\"aired\":\"2001-04-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Des chasseurs de prime rôdent, et la plupart des chapeaux de paille sont ivres morts. Seul Zoro est encore assez sobre pour brandir une épée.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361958.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":65,\"absoluteNumber\":65,\"seasonNumber\":1,\"lastUpdated\":\"2026-03-01 18:54:37\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361959,\"seriesId\":81797,\"name\":\"Un combat sérieux ! Luffy VS Zoro, l'étrange grand duel !\",\"aired\":\"2001-04-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Une mystérieuse princesse doit être protégée d'un assassin qui se cure le nez, mais Luffy et Zoro sont trop occupés à en découdre pour se soucier de crottes de nez explosives.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361959.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":66,\"absoluteNumber\":66,\"seasonNumber\":1,\"lastUpdated\":\"2026-03-01 18:55:00\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361960,\"seriesId\":81797,\"name\":\"Escortons la princesse Vivi ! Départ de l'équipage pirate de Luffy\",\"aired\":\"2001-04-29\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'équipage du chapeau de paille quitte Whisky Peak avec pour mission de ramener la princesse d'Alabasta vers son royaume tout en la protégeant d'une armée de cruels assassins.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361960.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":67,\"absoluteNumber\":67,\"seasonNumber\":1,\"lastUpdated\":\"2026-03-01 18:55:52\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361961,\"seriesId\":81797,\"name\":\"Courage Kobby ! Journal de Kobby et Hermep à la marine\",\"aired\":\"2001-05-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Pendant que l'équipage fait route vers Little Garden avec la princesse, une vieille connaissance de Luffy et Zoro, le colonel Morgan, s'échappe d'un navire-prison de la marine.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361961.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":68,\"absoluteNumber\":68,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:15:06\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361962,\"seriesId\":81797,\"name\":\"La décision de Kobby et Hermep ! Le coeur paternel du vice-amiral Garp\",\"aired\":\"2001-05-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Kobby et Hermep s'entraînent nuit et jour afin de prouver qu'ils sont assez costauds pour devenir marines. Un affrontement violent contre le vice-amiral Garp va déterminer s'ils en valent la peine.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361962.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":69,\"absoluteNumber\":69,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:21:41\",\"finaleType\":\"season\",\"year\":\"2001\"},{\"id\":361964,\"seriesId\":81797,\"name\":\"L'île préhistorique ! L'ombre cachée dans Little Garden !\",\"aired\":\"2001-05-27\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La bande de Luffy est en manque de provisions. Ils s'arrêtent donc à Little Garden pour trouver quelque chose à manger. Malheureusement pour eux, ils risquent plutôt de servir de repas.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361964.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":70,\"absoluteNumber\":70,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:22:11\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361965,\"seriesId\":81797,\"name\":\"Un combat de titans ! Les géants Dorry et Broggy\",\"aired\":\"2001-06-03\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Non seulement il y a des dinosaures en liberté sur l'île de Little Garden, mais l'équipage du chapeau de paille se retrouve bientôt au beau milieu d'un match revanche gargantuesque.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361965.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":71,\"absoluteNumber\":71,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:22:32\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361966,\"seriesId\":81797,\"name\":\"Luffy se fâche ! Un piège idiot dans un duel sacré\",\"aired\":\"2001-06-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Usopp et Luffy sont passionnés par le combat sans fin que se livrent Dorry et Broggy. Toutefois, la fascination tourne à l'indignation quand Monkey flaire un relent de trahison.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361966.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":72,\"absoluteNumber\":72,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:25:44\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361967,\"seriesId\":81797,\"name\":\"Les pleurs de la victoire de Broggy ! La conclusion d'Elbaf\",\"aired\":\"2001-06-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy a le sang qui bout et a soif de vengeance contre les assassins qui ont saboté le duel entre Dorry et Broggy, mais il se trouve coincé sous un énorme rocher.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361967.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":73,\"absoluteNumber\":73,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:26:01\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361968,\"seriesId\":81797,\"name\":\"La bougie diabolique ! Larmes de regret et larmes de colère\",\"aired\":\"2001-07-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Pendant que Luffy lutte pour se libérer, ses amis tombent entre les mains de Baroque Works. Bien que les chances ne soient pas de leur côté, les chapeaux de paille n'abandonnent jamais !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361968.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":74,\"absoluteNumber\":74,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:26:16\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361970,\"seriesId\":81797,\"name\":\"Un pouvoir magique attaque Luffy ! Le Colors Trap\",\"aired\":\"2001-08-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Tandis qu'Usopp et Karoo tentent de devancer M. 5 et Miss Valentine, Luffy tente de détruire le piédestal de cire menaçant la vie de ses amis.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361970.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":75,\"absoluteNumber\":75,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:27:03\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361971,\"seriesId\":81797,\"name\":\"La contre-attaque ! L'ingéniosité d'Usopp et la bille enflammée !\",\"aired\":\"2001-08-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Avec ses amis sur le point d'être définitivement ensevelis dans la cire, Usopp a l'opportunité parfaite d'être courageux et de rendre son père fier de lui.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361971.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":76,\"absoluteNumber\":76,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:27:15\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361972,\"seriesId\":81797,\"name\":\"Au revoir l'île des géants ! Direction Alabasta !\",\"aired\":\"2001-08-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après avoir échappé de peu à la mort, l'équipage de Luffy et la princesse mettent les voiles pour Alabasta, mais quelque chose d'énorme et dangereux surgit sur leur passage.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361972.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":77,\"absoluteNumber\":77,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:27:25\",\"finaleType\":\"season\",\"year\":\"2001\"},{\"id\":361973,\"seriesId\":81797,\"name\":\"Nami est malade ? Au-delà de la neige tombant sur l'océan\",\"aired\":\"2001-08-26\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nami attrape une fièvre épouvantable, et les chapeaux de paille ne savent pas quoi faire. On dirait que Grand Line veut faire une autre victime.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361973.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":78,\"absoluteNumber\":78,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:27:36\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361974,\"seriesId\":81797,\"name\":\"Une embuscade ! Le Bliking et Wapol le glouton\",\"aired\":\"2001-09-02\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"En cherchant un médecin, l'équipage rencontre le pirate Wapol. Pendant ce temps, Smoker parvient à intercepter la conversation entre M. 0 et Sanji et prévoit d'aller à Alabasta.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361974.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":79,\"absoluteNumber\":79,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:27:47\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361975,\"seriesId\":81797,\"name\":\"Une île sans docteur ? Aventure dans le pays sans nom !\",\"aired\":\"2001-09-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'équipage de Straw Hat parvient à gagner la confiance des personnes qui les ont attaquées et sont emmenés au village, à l'exception de Zoro et Carue, qui gardent le navire. Luffy et Sanji doivent emmener Nami chez le seul médecin de l'île qui vit au sommet d'une montagne. Vivi et Usopp découvrent le passé de l'île et le pirate Wapol de Dalton.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361975.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":80,\"absoluteNumber\":80,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:28:03\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361977,\"seriesId\":81797,\"name\":\"Es-tu heureux ? Le docteur appelé sorcière !\",\"aired\":\"2001-09-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Alors que Sanji et Luffy se battent hors de la nature sauvage, le pire cauchemar de l'insulaire se réalise, alors que Wapol retourne sur l'île. On découvre que le médecin est de l'autre côté de l'île, et Usopp, Vivi et Dalton se précipitent pour la trouver. Dalton revient cependant en apprenant le retour de Wapol.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361977.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":81,\"absoluteNumber\":81,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:28:13\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361978,\"seriesId\":81797,\"name\":\"La détermination de Dalton ! L'armée de Wapol débarque sur l'île\",\"aired\":\"2001-10-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Dalton fait face à Wapol, mais ne se fait toucher que par des flèches lancées par son ancien camarade Chess. Une avalanche arrête la bataille, mais blesse Sanji. Luffy doit porter Nami et Sanji chez le médecin et commence son ascension.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361978.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":82,\"absoluteNumber\":82,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:28:27\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361979,\"seriesId\":81797,\"name\":\"L'île qui vit sous la neige ! Escalader le Drum Rocky !\",\"aired\":\"2001-10-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La Lapahn aide Luffy à s'échapper de Wapol, lui donnant suffisamment de temps pour grimper au château où vit le médecin Kureha. Vivi, Usopp et Zoro traitent avec l'armée du roi afin de sauver Dalton. Le Nami en convalescence rencontre une étrange créature.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361979.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":83,\"absoluteNumber\":83,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:28:39\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361980,\"seriesId\":81797,\"name\":\"Le renne au nez bleu ! Le secret de Chopper\",\"aired\":\"2001-10-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nami demande à Chopper de rejoindre l'équipage, mais il n'est pas intéressé. Kureha raconte à Nami une partie des antécédents de Chopper. Après avoir réalisé les capacités de Chopper, Luffy est impatient de le faire rejoindre l'équipage.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361980.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":84,\"absoluteNumber\":84,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:28:53\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361982,\"seriesId\":81797,\"name\":\"Le rêve du banni ! Le toubib charlatan Hiluluk !\",\"aired\":\"2001-10-28\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Doctorine continue de dire comment Chopper a vécu sa vie et comment le médecin charlatan Hiruluk a pris soin de lui.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361982.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":85,\"absoluteNumber\":85,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:30:24\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361983,\"seriesId\":81797,\"name\":\"Les cerisiers de Hiluluk et la volonté héritée\",\"aired\":\"2001-11-04\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Plus du passé de Chopper est révélé, y compris le sort des cruautés du docteur Hiruluk et Wapol en tant que roi. Pendant ce temps, Wapol atteint le château où réside l'équipage.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361983.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":86,\"absoluteNumber\":86,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:30:36\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361985,\"seriesId\":81797,\"name\":\"Contre l'armée de Wapol ! Les pouvoirs du fruit du glouton !\",\"aired\":\"2001-11-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Wapol est déterminé à faire tomber le drapeau de Hiruluk, et pour ce faire, il engage Sanji, Luffy et Chopper dans un combat.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361985.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":87,\"absoluteNumber\":87,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:30:48\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361986,\"seriesId\":81797,\"name\":\"Un fruit du démon de type Zoan ! Les sept transformations de Chopper\",\"aired\":\"2001-11-18\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Chopper démontre les capacités de Rumble Balls lors de la lutte contre Chessmarimo. Dalton est découvert par l'avalanche.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361986.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":88,\"absoluteNumber\":88,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:31:03\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361988,\"seriesId\":81797,\"name\":\"Quand l'autorité du royaume disparait ! Le drapeau des convictions flotte pour toujours\",\"aired\":\"2001-11-25\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après avoir essayé tous les tours du château, Wapol est finalement traqué par Luffy. Les villageois ainsi que Zoro, Vivi et Usopp commencent leur ascension vers le château par un téléphérique.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361988.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":89,\"absoluteNumber\":89,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:31:17\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361989,\"seriesId\":81797,\"name\":\"Les cerisiers de Hiluluk ! Le miracle de Drum Rocky\",\"aired\":\"2001-12-02\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après avoir finalement été convaincu de rejoindre l'équipe, Chopper annonce ses intentions au Dr. Kureha, qui ne le prend pas trop bien; mais après s'être échappée du château, elle a décidé de donner à toute l'équipe de Straw Hat un cadeau d'adieu.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361989.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":90,\"absoluteNumber\":90,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:31:28\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361992,\"seriesId\":81797,\"name\":\"Adieu, île de Drum ! Je pars en mer !\",\"aired\":\"2001-12-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Chopper rejoint l'équipage de Chapeau de Paille alors qu'ils poursuivent leur voyage dans la patrie de Vivi.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361992.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":91,\"absoluteNumber\":91,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:31:40\",\"finaleType\":\"season\",\"year\":\"2001\"},{\"id\":361994,\"seriesId\":81797,\"name\":\"Le héros d'Alabasta. Une ballerine sur le navire !\",\"aired\":\"2001-12-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'équipage vient à la rescousse d'un homme qui a plusieurs apparences à l'approche d'Alabasta.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361994.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":92,\"absoluteNumber\":92,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:31:55\",\"finaleType\":\"season\",\"year\":\"2001\"},{\"id\":361996,\"seriesId\":81797,\"name\":\"En avant vers le pays du désert ! La Dance Powder et l'armée rebelle !\",\"aired\":\"2001-12-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'équipage accoste à Alabasta avec très peu de temps pour arrêter la rébellion. Sanji et Chopper sont chargés de rassembler des vivres en vue d'un dangereux voyage à travers le désert.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361996.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":93,\"absoluteNumber\":93,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:32:08\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":361998,\"seriesId\":81797,\"name\":\"Les grands héros se retrouvent ! Ace aux poings ardents.\",\"aired\":\"2001-12-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Pendant leur séjour à Nanohana, les chapeaux de paille rencontrent Smoker et Tashigi. Un puissant pirate nommé Portgas D. Ace apparaît et se révèle être le frère aîné de Luffy.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/361998.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":94,\"absoluteNumber\":94,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:32:20\",\"finaleType\":null,\"year\":\"2001\"},{\"id\":362000,\"seriesId\":81797,\"name\":\"Ace et Luffy ! Passion et fraternité !\",\"aired\":\"2002-01-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les joyeuses retrouvailles d'Ace et Luffy sont brutalement interrompues par les Billions de Baroque Works.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362000.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":95,\"absoluteNumber\":95,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:32:31\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362002,\"seriesId\":81797,\"name\":\"Elmar la ville verte. Rencontre avec les Kung Fu Dugongs !\",\"aired\":\"2002-01-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Avant de pouvoir commencer leur traversée du désert, Luffy et son équipage sont arrêtés sur le rivage par les mignons - mais redoutables - Kung Fu Dugongs.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362002.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":96,\"absoluteNumber\":96,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:32:45\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362003,\"seriesId\":81797,\"name\":\"Aventures dans le pays des sables ! Les démons de la terre brûlante.\",\"aired\":\"2002-01-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'équipage de Luffy croise des oiseaux perfides et des plantes carnivores pendant leur odyssée dans le désert, et juste au moment où ils pensent que la voie est libre, un grand danger émerge de sous le sable.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362003.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":97,\"absoluteNumber\":97,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:33:00\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362005,\"seriesId\":81797,\"name\":\"Les pirates du désert : Des hommes libres !\",\"aired\":\"2002-01-27\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les chapeaux de paille croisent la route des Balbaros, les pirates du désert, et une belle mésaventure arrive à Ace quand il se retrouve séparé du groupe.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362005.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":98,\"absoluteNumber\":98,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:33:14\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362006,\"seriesId\":81797,\"name\":\"La fierté d’un imposteur. Kamyu, rebelle de cœur !\",\"aired\":\"2002-02-03\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La princesse Vivi élabore un plan pour tester la motivation d'un gang de soi-disant rebelles.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362006.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":99,\"absoluteNumber\":99,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:33:26\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362008,\"seriesId\":81797,\"name\":\"Koza, guerrier rebelle ! La promesse faite à Vivi !\",\"aired\":\"2002-02-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'équipage continue leur voyage vers Yuba où des retrouvailles aigres-douces avec un ami d'enfance attendent la princesse Vivi.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362008.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":100,\"absoluteNumber\":100,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:33:38\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362010,\"seriesId\":81797,\"name\":\"Un duel de feu ! Ace contre Scorpion.\",\"aired\":\"2002-03-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Ace découvre que Barbe Noire n'est pas à Alabasta après tout, et quitte le groupe pour continuer à le chercher. Il laisse à Luffy un mystérieux morceau de papier, expliquant qu'il les laissera se revoir.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362010.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":101,\"absoluteNumber\":101,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:33:48\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362012,\"seriesId\":81797,\"name\":\"Perdus dans les ruines ! Vivi, l’esprit d’équipe et l’avenir de la nation !\",\"aired\":\"2002-02-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro, Chopper et Luffy parviennent à se perdre et à tomber sur d'énormes ruines souterraines.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362012.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":102,\"absoluteNumber\":102,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:34:00\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362013,\"seriesId\":81797,\"name\":\"Rendez-vous à 20h00 au Spiders café ! Les agents spéciaux se rassemblent !\",\"aired\":\"2002-03-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les assassins de Baroque Works se rassemblent au Spiders Café, et les chapeaux de paille arrivent à Yuba et s'aperçoivent qu'elle est complètement ensablée.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362013.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":103,\"absoluteNumber\":103,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:34:13\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362014,\"seriesId\":81797,\"name\":\"Luffy VS Vivi ! Un serment d'amitié !\",\"aired\":\"2002-03-10\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Crocodile se présente aux assassins de Baroque Works et révèle ses desseins diaboliques pour Alabasta. Après avoir quitté Yuba, Luffy prend des positions qui forcent Vivi à réévaluer sa mission.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362014.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":104,\"absoluteNumber\":104,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:34:25\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362016,\"seriesId\":81797,\"name\":\"Alabasta se prépare au combat ! Rainbase, la cité des rêves !\",\"aired\":\"2002-03-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'équipage se dirigent vers Rainbase pour affronter Crocodile. Kaloo atteint finalement le palais et donne l'avertissement de Vivi au roi Cobra.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362016.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":105,\"absoluteNumber\":105,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:34:40\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362017,\"seriesId\":81797,\"name\":\"Une situation désespérée! Piège au Rain-Dinners!\",\"aired\":\"2002-03-25\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy mène un raid sur le casino de Crocodile. Son manque de préparation le fait atterrir derrière les barreaux avec le colonel Smoker.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362017.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":106,\"absoluteNumber\":106,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:34:51\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362018,\"seriesId\":81797,\"name\":\"Opération Utopia enclenchée ! Les rebelles sont en marche.\",\"aired\":\"2002-04-14\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Pendant que les chapeaux de paille sont en taule, le roi Cobra s'adresse au peuple affamé de Nanohana.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362018.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":107,\"absoluteNumber\":107,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:35:04\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362020,\"seriesId\":81797,\"name\":\"Les terribles Banana-crocos ! Mister Prince entre en scène !\",\"aired\":\"2002-04-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'imposteur royal a poussé l'armée rebelle à vouloir mettre fin à tout prix au règne de Cobra. Pendant ce temps, Luffy et ses camarades se retrouvent dans les ennuis jusqu'au cou, et même au-delà.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362020.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":108,\"absoluteNumber\":108,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:35:16\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362021,\"seriesId\":81797,\"name\":\"Un tour de clé pour la liberté ! La Ciro-Boule!\",\"aired\":\"2002-04-28\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Sanji intervient à la dernière minute pour forcer les crocos à expulser la clé de la cage de Luffy, mais les voraces reptiles crachent autre chose à la place.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362021.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":109,\"absoluteNumber\":109,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:35:28\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362022,\"seriesId\":81797,\"name\":\"Un combat à mort ! Luffy VS Crocodile !\",\"aired\":\"2002-05-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Crocodile arrache Vivi du dos d'un crabe géant, mais Luffy ne le laisse pas faire. L'homme élastique va se mesurer à l'homme des sables dans un combat qui s'achèvera dans un bain de sang.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362022.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":110,\"absoluteNumber\":110,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:35:42\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362023,\"seriesId\":81797,\"name\":\"Une fuite miraculeuse ! Les animaux d'Alabasta!\",\"aired\":\"2002-05-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy est laissé pour mort par Crocodile, mais est aidé par la mystérieuse Miss All-Sunday. Le reste des Chapeaux de Paille atteignent Alubarna.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362023.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":111,\"absoluteNumber\":111,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:35:56\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362025,\"seriesId\":81797,\"name\":\"Les rebelles contre l'armée du roi! La confrontation finale aura lieu à Alubarna!\",\"aired\":\"2002-05-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La bataille décisive est sur le point de commencer à Alubarna. Sanji, Vivi, Chopper, Nami, Zoro et Usopp arrivent dans la ville déguisés. Ils sont repérés par les Agents Officiels qui se séparent pour les contrecarrer. Vivi tente d'arrêter les émeutiers mais, sans être entendue, risque d'être dépassée. Karl la protège et lui sauve la vie.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362025.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":112,\"absoluteNumber\":112,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:36:07\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362026,\"seriesId\":81797,\"name\":\"La douleur d'Alubarna! Le chef d'escadron Kaloo se lance au combat!\",\"aired\":\"2002-06-03\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les tentatives de Vivi pour arrêter l'armée rebelle sont vaines, et elle est attaquée par M. 2 Bon Clay, mais parvient à s'échapper. Pendant ce temps, la bataille entre Usopp et Chopper contre l'équipe Mr. 4 commence.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362026.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":113,\"absoluteNumber\":113,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:36:22\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362028,\"seriesId\":81797,\"name\":\"Le rêve d'un ami! Duel sur la quatrième avenue de la taupinière!\",\"aired\":\"2002-06-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les choses semblent désespérées pour Usopp et Chopper car ils continuent de souffrir de chaque attaque lancée par l'équipe Mr.4. Cependant, le vent pourrait commencer à tourner à mesure qu'Usopp apprend ce que signifie vraiment être un homme.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362028.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":114,\"absoluteNumber\":114,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:36:49\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362029,\"seriesId\":81797,\"name\":\"La performance du jour! L'assemblage facial!\",\"aired\":\"2002-06-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Bien que sévèrement battus et meurtris, Usopp et Chopper ont finalement vaincu l'équipe Mr.4. Cependant, M. 2 a compris la faiblesse de Sanji.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362029.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":115,\"absoluteNumber\":115,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:38:36\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362030,\"seriesId\":81797,\"name\":\"Il s'est transformé en Nami! Bonclay et son coup de ballet!\",\"aired\":\"2002-06-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Bien que M. 2 découvre la faiblesse de Sanji, Sanji bat toujours son adversaire après un combat à égalité. Pendant ce temps, avant que Vivi puisse donner l'ordre de faire sauter le palais, Crocodile apparaît.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362030.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":116,\"absoluteNumber\":116,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:38:47\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362031,\"seriesId\":81797,\"name\":\"Avis de tempête! Le bâton climatique de Nami!\",\"aired\":\"2002-06-30\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nami affronte Miss Doublefinger et essaie en même temps de découvrir sa nouvelle arme, le Klima Takt (Climate Baton).\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362031.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":117,\"absoluteNumber\":117,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:39:05\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362032,\"seriesId\":81797,\"name\":\"Le secret de la famille royale! Une arme antique Pluton!\",\"aired\":\"2002-07-14\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Tandis que Crocodile révèle à Vivi l'ancienne arme Pluton, Nami tente de vaincre Miss Doublefinger avec son attaque la plus puissante : le Tornado Tempo.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362032.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":118,\"absoluteNumber\":118,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:39:19\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362033,\"seriesId\":81797,\"name\":\"Le secret d'une épée puissante ! La force qui tranche l'acier et le souffle des choses\",\"aired\":\"2002-07-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Alors que le combat de Miss Doublefinger avec Nami était difficile, Zoro a encore plus de mal à combattre M.1 : un homme qui peut changer tout son corps en acier - quelque chose que Zoro ne peut pas couper. Alors que Zoro approche de la mort, il doit découvrir le secret du « souffle de toutes choses ».\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362033.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":119,\"absoluteNumber\":119,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:39:31\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362034,\"seriesId\":81797,\"name\":\"Le combat est terminé ! Kohza brandit le drapeau blanc\",\"aired\":\"2002-08-04\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Lorsque Vivi révèle le plan de Crocodile à Kohza, il tente d'arrêter les combats, mais est abattu. Crocodile révèle qu'il a installé une énorme bombe dans la ville.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362034.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":120,\"absoluteNumber\":120,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 13:39:52\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362035,\"seriesId\":81797,\"name\":\"Quelque part la voix de Vivi ! Le héros tombe du ciel !\",\"aired\":\"2002-08-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Alors que Kohza tente d'arrêter l'armée rebelle, les deux camps se battent à nouveau grâce à l'intervention de Baroque Works. Vivi est jetée vers une mort certaine lorsque Luffy la sauve et défie Crocodile à un deuxième tour.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362035.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":121,\"absoluteNumber\":121,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:45:41\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362037,\"seriesId\":81797,\"name\":\"Croco de sable et Luffy d'eau ! Le second round du duel !\",\"aired\":\"2002-08-18\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy combat Crocodile avec plus de succès cette fois en utilisant de l'eau, mais perd quand même ce round. Pendant ce temps, les autres Chapeaux de Paille se dépêchent de localiser la bombe avant qu'elle n'explose. Nico Robin oblige le roi à l'emmener au tombeau où est caché le Poneglyphe Pluton.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362037.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":122,\"absoluteNumber\":122,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:46:24\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362038,\"seriesId\":81797,\"name\":\"Ca sent le croco ! Luffy cours vers le tombeau de la famille royale !\",\"aired\":\"2002-08-25\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Crocodile rejoint Robin dans la tombe et lui ordonne de traduire le Ponéglyphe. Robin lui dit que Pluton n'a pas été mentionné et qu'il s'agissait uniquement d'histoire, mais Crocodile comprend qu'elle mentait et la poignarde en réponse. Lorsque Luffy se remet du dernier round de combat, il poursuit Crocodile dans la tombe.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362038.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":123,\"absoluteNumber\":123,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:47:14\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362040,\"seriesId\":81797,\"name\":\"L'heure du cauchemar approche ! Voici la base secrète du clan Suna Suna\",\"aired\":\"2002-09-01\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy se bat avec Crocodile en utilisant du sang sur ses poings. Pendant ce temps, Vivi trouve la bombe et rassemble les Chapeaux de Paille.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362040.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":124,\"absoluteNumber\":124,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:47:44\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362041,\"seriesId\":81797,\"name\":\"Des ailes majestueuses ! Mon nom est Pell, le gardien divin de ce pays\",\"aired\":\"2002-09-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Vivi trouve la bombe à l'intérieur de la tour de l'horloge, mais la paire d'œuvres baroques de M. 7 est là pour la protéger. Vivi les vainc, mais elle se rend compte que la bombe ne peut pas être arrêtée si facilement.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362041.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":125,\"absoluteNumber\":125,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:48:08\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362042,\"seriesId\":81797,\"name\":\"Je vais te surpasser ! Il pleut à Alabasta !\",\"aired\":\"2002-09-18\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy bat Crocodile en le frappant à travers un substrat rocheux solide. Lorsque Crocodile tombe, les gouttes de pluie calment les soldats.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362042.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":126,\"absoluteNumber\":126,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:48:29\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362044,\"seriesId\":81797,\"name\":\"Adieu les armes ! Les pirates et la justice à plusieurs facettes.\",\"aired\":\"2002-10-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Maintenant que la bataille est terminée, l’issue est connue. Igaram apparaît avec la preuve de l'innocence de Cobra, ainsi que Kohza qui raconte tout. Tashigi et Smoker sont tous deux récompensés pour avoir affronté Crocodile, mais aucun d'eux ne pense que c'est juste, étant donné que les pirates du Chapeau de Paille ont fait tout le travail.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362044.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":127,\"absoluteNumber\":127,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:48:51\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362045,\"seriesId\":81797,\"name\":\"La fête des pirates et le plan de fuite d'Alabasta !\",\"aired\":\"2002-10-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy est sauvé de la tombe effondrée où il a combattu Crocodile et amené dans le palais de Cobra pour se reposer. A son réveil, un magnifique banquet est organisé pour les pirates, puis les Chapeaux de Paille sont invités à profiter du hammam thermal à l'intérieur du palais.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362045.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":128,\"absoluteNumber\":128,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:49:12\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362046,\"seriesId\":81797,\"name\":\"Tout a commencé ce jour-là ! Vivi raconte ses aventures\",\"aired\":\"2002-10-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"C'est le jour du discours de Vivi et de sa décision de continuer ou non à être avec les Chapeaux de Paille. Pendant ce temps, Bon Clay et son équipage tentent de protéger les Chapeaux de Paille de Hina.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362046.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":129,\"absoluteNumber\":129,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:49:33\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362048,\"seriesId\":81797,\"name\":\"Le parfum du danger ! Le septième membre est Nico Robin !\",\"aired\":\"2002-10-27\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les Marines échouent encore une fois à attraper les Chapeaux de Paille. Après avoir échappé aux Marines, Nico Robin (Mme All Sunday) apparaît de l'intérieur du navire des Chapeaux de Paille.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362048.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":130,\"absoluteNumber\":130,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:49:55\",\"finaleType\":\"season\",\"year\":\"2002\"},{\"id\":362049,\"seriesId\":81797,\"name\":\"La toute première patiente ! Révélations sur la Rumble Ball.\",\"aired\":\"2002-11-03\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'aventure à Alabasta à peine terminée, l'équipage découvrent une île isolée où ils peuvent reconstituer leurs stocks de provisions. Chopper est chargé de garder le bateau, mais lui et Robin préfèrent consacrer leur après-midi à l'exploration.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362049.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":131,\"absoluteNumber\":131,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:50:16\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362050,\"seriesId\":81797,\"name\":\"Rébellion d'un navigateur ! Le rêve de Nami !\",\"aired\":\"2002-11-10\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Quand un démarcheur de vente par correspondance se perd en mer, Nami trouve le papier nécessaire à la création de cartes. L'équipage du chapeau de paille cherche le moyen de survivre à un redoutable cyclone.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362050.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":132,\"absoluteNumber\":132,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:50:35\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362051,\"seriesId\":81797,\"name\":\"Comment on transmet une recette ! Sanji, le pro du Curry !\",\"aired\":\"2002-11-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Un brouillard épais entraîne une rencontre rapprochée de type culinaire quand Robin repêche un marine. L'apprenti cuisinier s'inquiète au sujet de la qualité de son curry, et Sanji se trouve être pile la bonne personne pour affiner sa recette.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362051.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":133,\"absoluteNumber\":133,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:53:42\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362052,\"seriesId\":81797,\"name\":\"Explosion de couleurs ! Usopp et le feu d'artifice géant !\",\"aired\":\"2002-11-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Une éclaircie fournit l'opportunité parfaite à Usopp d'aider une petite fille à réaliser son rêve de lancer le plus grand feu d'artifice du monde.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362052.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":134,\"absoluteNumber\":134,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:54:01\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362053,\"seriesId\":81797,\"name\":\"Un célèbre chasseur de pirates. Zoro, le sabreur errant !\",\"aired\":\"2002-12-01\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Des problèmes d'argent forcent Zoro à en découdre avec Dick le bandit et sa perfide bande de voyous. Ces obsédés de la gâchette hors-la-loi terrorisent un village paisible, et le sabreur des chapeaux de paille vise à arrêter leur règne de terreur.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362053.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":135,\"absoluteNumber\":135,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:54:19\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362054,\"seriesId\":81797,\"name\":\"Zeny de l'Île aux chèvres ! Un bateau pirate dans la montagne !\",\"aired\":\"2002-12-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Un tir de barrage de canons de la marine force l'équipage du chapeau de paille à chercher refuge sur une île inconnue. Après l'accostage, l'équipage rencontre un étrange vieil homme qui vit parmi un troupeau de chèvres.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362054.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":136,\"absoluteNumber\":136,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:54:39\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362055,\"seriesId\":81797,\"name\":\"Alors, ça marche les affaires ? Le rêve de Zeny l'usurier !\",\"aired\":\"2002-12-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le vieux Zeny a fait fortune en prêtant de l'argent aux magouilleurs, mais il a toujours rêvé de devenir pirate lui-même. Maintenant que des marines décident de tendre un piège aux chapeaux de paille, l'ermite rusé va peut-être finalement réaliser son vœu.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362055.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":137,\"absoluteNumber\":137,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:54:55\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362056,\"seriesId\":81797,\"name\":\"Le trésor caché de l'île aux chèvres ! L'équipage de Zeny le pirate à l'abordage !\",\"aired\":\"2002-12-22\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zeny en a bien plus que pour son argent en embarquant pour son premier voyage en tant que pirate.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362056.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":138,\"absoluteNumber\":138,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:55:14\",\"finaleType\":null,\"year\":\"2002\"},{\"id\":362057,\"seriesId\":81797,\"name\":\"Une brume mystérieuse aux couleurs arc-en-ciel… Henzo, le vieil homme de l'île de Ruruka.\",\"aired\":\"2003-01-05\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'équipage fait halte dans une ville portuaire affligée par un maire qui taxe tout et n'importe quoi. Pendant leur dîner, Luffy et Robin sympathisent avec un scientifique farfelu obsédé par la brume arc-en-ciel.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362057.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":139,\"absoluteNumber\":139,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:55:30\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362058,\"seriesId\":81797,\"name\":\"Habitants d'un pays hors du temps. Les Pirates à la citrouille !\",\"aired\":\"2003-01-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy, Usopp, Robin et Zoro se font piéger dans la brume arc-en-ciel accompagnés de Henzo.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362058.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":140,\"absoluteNumber\":140,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 11:55:47\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362059,\"seriesId\":81797,\"name\":\"Le mal du pays ! Un cimetière de pirates dont nul ne revient !\",\"aired\":\"2003-01-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et son équipage cherchent un moyen de sortir de Apes Concert, mais la brume arc-en-ciel est un vrai labyrinthe de folie dont il est impossible de s'enfuir. De retour sur le rivage, Nami, Chopper et Sanji risquent les travaux forcés à vie pour ne pas avoir payé une taxe.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362059.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":141,\"absoluteNumber\":141,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:06:20\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362060,\"seriesId\":81797,\"name\":\"Bataille générale ! Le plan de Wetton et la Tour Arc-en-ciel !\",\"aired\":\"2003-01-26\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nami entre dans la brume avec pour mission de sauver ses camarades, et peut-être d'en profiter pour chasser quelques trésors.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362060.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":142,\"absoluteNumber\":142,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:06:36\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362061,\"seriesId\":81797,\"name\":\"La légende reprend ! L'aventure continue par delà la brume !\",\"aired\":\"2003-02-02\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La confrontation avec le maire Wetton s'intensifie vers un bouquet final quand les chapeaux de paille se démènent pour s'échapper de la brume arc-en-ciel.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362061.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":143,\"absoluteNumber\":143,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:06:53\",\"finaleType\":\"season\",\"year\":\"2003\"},{\"id\":362062,\"seriesId\":81797,\"name\":\"Le log détraqué ? Masira, le roi du repêchage !\",\"aired\":\"2003-02-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'équipage se fait presque écrabouiller par la chute des débris d'un bateau âgé de plus de 200 ans. Est-ce que les rumeurs sur l'existence d'une île céleste seraient fondées ?\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362062.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":144,\"absoluteNumber\":144,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:07:14\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362063,\"seriesId\":81797,\"name\":\"Apparition de monstres ! N'approchez pas de Barbe Blanche !\",\"aired\":\"2003-02-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Toujours à la recherche du chemin vers l'île céleste, les chapeaux de paille établissent une route vers Jaya. Pendant ce temps, Ace aux poings ardents s'invite à une fête à bord d'un vaisseau gouverné par Baggy le clown.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362063.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":145,\"absoluteNumber\":145,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:07:35\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362064,\"seriesId\":81797,\"name\":\"Arrêtez de rêver ! Mock Town, la ville méprisante !\",\"aired\":\"2003-02-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Comme les chapeaux de paille jettent l'ancre dans une ville envahie de coupe-jarrets, Nami demande aux garçons de se tenir tranquilles. Mais quand les pirates de Bellamy viennent chercher la bagarre, Luffy risque de devoir trahir sa promesse.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362064.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":146,\"absoluteNumber\":146,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:07:57\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362065,\"seriesId\":81797,\"name\":\"Des pirates distingués ! L'homme racontant  ses rêves et le roi de la fouille sous-marine.\",\"aired\":\"2003-03-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Grâce à son habileté, Robin déniche un rêveur solitaire qui pourrait connaître la route vers l'île céleste.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362065.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":147,\"absoluteNumber\":147,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:08:14\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362066,\"seriesId\":81797,\"name\":\"Une famille légendaire ! Norland le menteur.\",\"aired\":\"2003-03-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et ses amis atteignent la demeure de Montblanc Cricket, l'homme qui détient la clé du chemin vers l'île céleste.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362066.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":148,\"absoluteNumber\":148,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:08:46\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362067,\"seriesId\":81797,\"name\":\"Cap sur les nuages ! A la recherche du South Bird.\",\"aired\":\"2003-03-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Montblanc Cricket accepte d'aider l'équipage à atteindre l'île céleste, mais ils doivent d'abord s'aventurer dans les plus sombres profondeurs d'une forêt infestée d'araignées pour capturer un mystérieux oiseau ayant un sens de l'orientation affûté.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362067.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":149,\"absoluteNumber\":149,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:09:06\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362068,\"seriesId\":81797,\"name\":\"Les rêves ne se réalisent pas ? Bellamy contre les Forces Spéciales Simiesques.\",\"aired\":\"2003-04-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Pendant que les chapeaux de paille affrontent toutes sortes de bestioles forestières bizarres en cherchant à capturer un South Bird, Montblanc et ses acolytes simiesques sont brutalement attaqués par les pirates de Bellamy.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362068.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":150,\"absoluteNumber\":150,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:23:59\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362069,\"seriesId\":81797,\"name\":\"L'homme qui valait 100 millions ! Le plus grand conseil du monde et Barbe Noire le pirate !\",\"aired\":\"2003-04-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy a tendu l'autre joue lors de sa première rencontre avec Bellamy, mais maintenant, il vient lui régler son compte pour le vieux Montblanc. Pendant ce temps, un effrayant équipage pirate prend pour cible l'équipage en vue d'acquérir une mauvaise réputation.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362069.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":151,\"absoluteNumber\":151,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:24:23\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362070,\"seriesId\":81797,\"name\":\"Le bateau part dans le ciel ! Chevauchons le Knock-Up Stream.\",\"aired\":\"2003-04-27\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Grâce à quelques modifications au Vogue Merry, les chapeaux de paille sont sur la route de cette île dans le ciel. Mais avec les pirates de Barbe Noire à leurs trousses, naviguer sur les courants verticaux sera tout sauf facile.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362070.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":152,\"absoluteNumber\":152,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:24:42\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362071,\"seriesId\":81797,\"name\":\"La mer de nuages. Le chevalier des Cieux et la porte du Paradis.\",\"aired\":\"2003-05-04\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Atteindre la mer de nuages s'avère plus facile qu'y survivre quand des créatures des mers attaquent le Vogue Merry.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362071.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":153,\"absoluteNumber\":153,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:25:02\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362072,\"seriesId\":81797,\"name\":\"Skypiea, le royaume divin. Les anges de la plage des nuages.\",\"aired\":\"2003-05-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après avoir été pris en stop par une crevette rapide, les chapeaux de paille atteignent le monde de Skypiea.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362072.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":154,\"absoluteNumber\":154,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:25:26\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362073,\"seriesId\":81797,\"name\":\"Terre sainte interdite ! L'île de Dieu et du jugement divin !\",\"aired\":\"2003-05-18\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'empressement de Nami de visiter le domaine interdit d'Upper Yard la mène face à la colère divine, et les chapeaux de paille subissent le jugement divin pour ne pas pouvoir s'acquitter de leurs frais d'immigration.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362073.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":155,\"absoluteNumber\":155,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:25:47\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362074,\"seriesId\":81797,\"name\":\"Déjà des criminels ! Les défenseurs de la loi de Skypiea.\",\"aired\":\"2003-06-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les chapeaux de paille ne sont pas étrangers à la vie du mauvais côté de la loi, mais les frais d'immigration impayés et l'attaque de Nami sur un béret blanc valent à l'équipage de Luffy la peine de mort par exil sur un nuage errant.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362074.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":156,\"absoluteNumber\":156,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:26:17\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362075,\"seriesId\":81797,\"name\":\"Pourra-t-on s'en tirer ? Les ordalies commencent !\",\"aired\":\"2003-06-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nami, Zoro, Chopper et Robin sont piégés à bord du Vogue Merry qui se retrouve réquisitionné par un homard monstrueux. Pour secourir son équipage, Luffy doit s'aventurer sur les terres sacrées d'Upper Yard.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362075.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":157,\"absoluteNumber\":157,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:26:46\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362076,\"seriesId\":81797,\"name\":\"Piège à Lovely Street ! Ener, le dieu tout-puissant.\",\"aired\":\"2003-06-22\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Conis aide Luffy et ses camarades à monter leur opération de secours, mais l'homme-élastique a l'impression que quelque chose cloche.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362076.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":158,\"absoluteNumber\":158,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:27:12\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362077,\"seriesId\":81797,\"name\":\"En avant, le Corbeau ! Droit sur l'autel sacrificiel.\",\"aired\":\"2003-07-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro se mesure à un requin céleste affamé dans l'ombre de l'autel sacrificiel. De l'autre côté d'Upper Yard, Luffy, Sanji et Usopp essaient de survivre à leur visite sur une île qui veut leur mort.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362077.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":159,\"absoluteNumber\":159,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:27:33\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362078,\"seriesId\":81797,\"name\":\"Chances de survie : 10% ! Le prélat Satori et le pouvoir du Mantra !\",\"aired\":\"2003-07-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy, Sanji et Usopp s'embrouillent avec Satori et ses nuages surprises explosifs garnis de serpents.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362078.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":160,\"absoluteNumber\":160,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:32:30\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362079,\"seriesId\":81797,\"name\":\"Les dangers de l'Ordalie des ballons ! Combat à mort dans la forêt de l'égarement !\",\"aired\":\"2003-07-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Usopp et Sanji essaient de reprendre le contrôle du Corbeau, et Luffy provoque un violent déluge de ballons explosifs en attaquant Satori. Pendant ce temps, Chopper siffle le chevalier des Cieux pour éviter de devenir un renne sacrifié.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362079.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":161,\"absoluteNumber\":161,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:32:50\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362080,\"seriesId\":81797,\"name\":\"Chopper en danger ! L'ancien dieu face au prélat Shura.\",\"aired\":\"2003-08-03\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Chopper combat bravement pour empêcher Shura de brûler le Vogue Merry, mais le petit renne n'est pas de taille contre un prélat céleste.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362080.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":162,\"absoluteNumber\":162,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:33:14\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362081,\"seriesId\":81797,\"name\":\"Quel mystère ! Ordalie des fils et ordalie de l'amour.\",\"aired\":\"2003-08-10\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Quand Gan Forr est gravement brûlé pendant son combat contre Shura, Chopper rassemble son courage pour faire un acte de foi en défiant la mort. Ailleurs, Luffy a peut-être découvert une façon de battre Satori.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362081.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":163,\"absoluteNumber\":163,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:33:45\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362082,\"seriesId\":81797,\"name\":\"Ranimons la flamme de Shandora ! Wiper le guerrier.\",\"aired\":\"2003-08-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les Shandia se préparent pour une attaque totale contre leurs adversaires prélats, Chopper rencontre les mystérieuses créatures qui lui ont sauvé la vie, et Nami fait une incroyable découverte concernant les origines d'Upper Yard.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362082.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":164,\"absoluteNumber\":164,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:34:12\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362083,\"seriesId\":81797,\"name\":\"Jaya, la Cité d'Or dans le Ciel ! Objectif : le sanctuaire divin !\",\"aired\":\"2003-08-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Pendant que les Shandia poursuivent leur combat pour le contrôle d'Upper Yard, les chapeaux de paille fêtent leurs retrouvailles en s'échangeant leurs histoires autour d'un feu de camp et se régalent avec un barbecue de requins célestes.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362083.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":165,\"absoluteNumber\":165,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:34:37\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362084,\"seriesId\":81797,\"name\":\"La veillée de la ruée vers l'or ! Nos pensées vont à la Vearth !\",\"aired\":\"2003-09-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La recherche de la précieuse Vearth par Laki entraîne la blessure d'un de ses camarades de Shandora pendant la bataille contre Om. À la nuit tombée, sur Upper Yard, les chapeaux de paille rêvent d'or pendant qu'ils dansent avec les loups.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362084.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":166,\"absoluteNumber\":166,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:35:11\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362085,\"seriesId\":81797,\"name\":\"Le Dieu Ener apparaît ! Aubade pour les survivants !\",\"aired\":\"2003-09-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La divinité électrisante de Skypiea, le dieu Ener, accorde à ses prélats le pouvoir absolu dans leur chasse aux chapeaux de paille. Usopp a un plan pour que le Vogue Merry mystérieusement réparé retourne sur l'eau, mais il implique d'utiliser Chopper comme appât.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362085.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":167,\"absoluteNumber\":167,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:35:35\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362086,\"seriesId\":81797,\"name\":\"Les crocs du serpent ! Le jeu de survie débute !\",\"aired\":\"2003-10-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les chapeaux de paille se dispersent quand ils débusquent un boa géant pendant leur quête d'or, et Gan Forr raconte l'histoire tragique de l'arrivée au ciel de Jaya. Pendant ce temps, Wiper prépare les Shandia à une attaque du sanctuaire d'Ener.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362086.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":168,\"absoluteNumber\":168,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:36:21\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362087,\"seriesId\":81797,\"name\":\"Le « Reject », une arme suicidaire ? Wiper le démon est bien résolu !\",\"aired\":\"2003-10-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Alors que le dieu sans cœur d'Upper Yard attend impatiemment le début du jeu de survie, les Shandia sont sauvagement piégés par l'ordalie des fils, et Luffy se dirige vers le combat de sa vie.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362087.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":169,\"absoluteNumber\":169,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:59:25\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362088,\"seriesId\":81797,\"name\":\"Duel aérien acharné ! Zoro le pirate face au guerrier Braham.\",\"aired\":\"2003-10-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro se dépêche de perfectionner une technique mortelle connue sous le nom d'attaque de lame aérienne. Le geste s'avère difficile à maîtriser, mais il pourrait être la clé pour que le sabreur puisse survivre au combat contre Braham, le guerrier Shandia.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362088.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":170,\"absoluteNumber\":170,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 12:59:49\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362089,\"seriesId\":81797,\"name\":\"Le hurlement de Burn Bazooka ! Luffy le pirate face à Wiper, le démon furieux.\",\"aired\":\"2003-10-26\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Sanji et Usopp sont mis à genoux par le pouvoir électrisant de Dieu, Luffy est presque calciné par le Burn Bazooka de Wiper, et Nami se joint à Gan Forr dans un affrontement contre deux tueurs identiques.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362089.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":171,\"absoluteNumber\":171,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:01:08\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362090,\"seriesId\":81797,\"name\":\"L'Ordalie des marais. Chopper, le pirate, contre Gedatsu le prélat.\",\"aired\":\"2003-11-02\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Chopper déchaîne la fureur de sa Rumble Ball pendant une visqueuse baston contre un prélat d'Upper Yard qui crache des vaso-nimbus.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362090.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":172,\"absoluteNumber\":172,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:01:38\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362091,\"seriesId\":81797,\"name\":\"Une puissance invincible ! La vraie nature d'Ener enfin révélée !\",\"aired\":\"2003-11-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nami et le chevalier des Cieux font équipe pour anéantir deux méchants amateurs en forme de ballon, et le dieu Ener s'appuie sur son incroyable invincibilité pour torturer un noble guerrier Shandia.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362091.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":173,\"absoluteNumber\":173,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:02:08\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362092,\"seriesId\":81797,\"name\":\"La cité perdue existe bel et bien ! Les magnifiques ruines de Shandora.\",\"aired\":\"2003-11-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Robin est interrompue par Yama, un des fervents serviteurs d'Ener, dans sa recherche de la mythique cité d'or. Quand le guerrier destructeur démolit quelques ruines antiques, il provoque la fureur des multiples poings de Robin.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362092.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":174,\"absoluteNumber\":174,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:02:37\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362093,\"seriesId\":81797,\"name\":\"Chances de survie : 0 % ! Chopper, le pirate, contre Om, le prélat !\",\"aired\":\"2003-12-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le prélat Om réduit Chopper au silence avec une attaque dont très peu, voire personne, ont réchappé. Pendant ce temps, Luffy commence à remarquer quelque chose d'étrange dans sa grotte qui ressemble à une prison, et quatre terrifiants guerriers se préparent au combat.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362093.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":175,\"absoluteNumber\":175,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:03:06\",\"finaleType\":null,\"year\":\"2003\"},{\"id\":362094,\"seriesId\":81797,\"name\":\"Escaladons le Giant Jack ! Lutte mortelle dans les ruines supérieures !\",\"aired\":\"2004-01-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro, Gan Forr, Wiper, Om et un chien boxeur s'affrontent dans une mêlée générale dans les ruines supérieures. Pendant que la bataille fait rage, Luffy essaie de se frayer une sortie à coups de poing de l'estomac d'un boa venimeux.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362094.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":176,\"absoluteNumber\":176,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:04:04\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362095,\"seriesId\":81797,\"name\":\"L'ultime épreuve de l'Ordalie du fer ! Le barbelé blanc de la mort !\",\"aired\":\"2004-01-18\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro et Wiper ont l'intention de tabasser le même méchant, mais le découvriront-ils à temps pour survivre à un combat à mort désastreux entouré de barbelé blanc ? Dans les profondeurs de l'estomac du boa, Nami et Luffy profitent de ce qui ressemble à des retrouvailles éphémères.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362095.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":177,\"absoluteNumber\":177,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:04:36\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362096,\"seriesId\":81797,\"name\":\"Une lame jaillissante !  Zoro le pirate contre le prélat Om !\",\"aired\":\"2004-01-25\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Impatient de terminer le combat, Zoro pointe l'énorme puissance destructrice de son 108 Klesha Slash sur le sinistre prélat Om. Ailleurs, Dieu demande à Robin de l'aider à chercher la légendaire cloche d'or.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362096.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":178,\"absoluteNumber\":178,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:05:07\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362097,\"seriesId\":81797,\"name\":\"Les ruines supérieures s'effondrent ! Quintet pour un final.\",\"aired\":\"2004-02-01\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le dieu Ener déclenche son carnage destiné à exterminer les êtres célestes de Skypiea, et les ruines de Shandora deviennent le théâtre du jeu sanglant appelé survie.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362097.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":179,\"absoluteNumber\":179,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:05:59\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362098,\"seriesId\":81797,\"name\":\"Affrontement dans les ruiines antiques ! Le but du Dieu Ener.\",\"aired\":\"2004-02-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Gan Forr, Wiper, Zoro et Robin joignent leurs forces pour attaquer le dieu Ener. Malgré leur offensive féroce, les quatre guerriers se montrent incapables de blesser la divinité tonnante jusqu'à ce que Wiper fasse usage d'une pierre mythique.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362098.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":180,\"absoluteNumber\":180,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:07:08\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362099,\"seriesId\":81797,\"name\":\"La Fairy Vearth pour ambition ! L'Arche Maxim !\",\"aired\":\"2004-02-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le dieu Ener se remet étonnamment des blessures qui auraient dû mettre fin à son règne de terreur. Zoro et Wiper rassemblent leurs forces pour résister une dernière fois, et Nami doit choisir entre ses amis et sa survie.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362099.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":181,\"absoluteNumber\":181,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:07:53\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362100,\"seriesId\":81797,\"name\":\"Enfin, ils s'affrontent ! Luffy le Pirate contre le Dieu Ener !\",\"aired\":\"2004-02-22\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy émerge de sa tombe serpentiforme avec une seule idée en tête, la vengeance. Pendant que l'homme élastique part égaliser les chances contre le dieu Ener, Conis fonce avertir son peuple de la catastrophe imminente.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362100.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":182,\"absoluteNumber\":182,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:08:29\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362101,\"seriesId\":81797,\"name\":\"Le Maxim s'envole ! Le « Despear » entre en action !\",\"aired\":\"2004-02-29\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Pendant que les citoyens du ciel fuient pour sauver leur vie, Ener met en route la mort de Skypiea. Luffy est determiné à arrêter le fou furieux, mais il doit d'abord trouver le moyen de mettre la main sur cet ignoble saint homme.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362101.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":183,\"absoluteNumber\":183,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:08:56\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362102,\"seriesId\":81797,\"name\":\"La chute de Luffy ! Le jugement divin et le souhait de Nami.\",\"aired\":\"2004-03-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Une poignée d'or précipite Luffy vers la mort, Sanji et Usopp organisent une mission de secours en vol, et Nami se prépare à une confrontation électrisante avec le dieu Ener.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362102.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":184,\"absoluteNumber\":184,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:09:21\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362103,\"seriesId\":81797,\"name\":\"Deux héros se réveillent ! Combat pour un amour enflammé !\",\"aired\":\"2004-03-14\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Usopp arrive juste à temps pour sauver Nami d'un éclair mortel, mais même leurs pouvoirs combinés ne sont pas de taille contre Ener. Pendant qu'ils galèrent à trouver un moyen de s'enfuir, Sanji cherche une façon discrète de saboter l'arche de Dieu.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362103.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":185,\"absoluteNumber\":185,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:09:44\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362104,\"seriesId\":81797,\"name\":\"Capriccio du désespoir ! Destruction imminente de l'île céleste !\",\"aired\":\"2004-03-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Bien qu'il soit ralenti par un bras enrobé d'or, Luffy grimpe rapidement le long d'un haricot géant pour équilibrer les forces contre Ener. Ailleurs, le peuple de Skypiea ressent les secousses de la colère divine.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362104.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":186,\"absoluteNumber\":186,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:10:20\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362105,\"seriesId\":81797,\"name\":\"Guidés par le son de la cloche ! Le grand guerrier et l'explorateur.\",\"aired\":\"2004-03-28\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Un flashback dévoile un aperçu des vies de deux personnalités légendaires de l'histoire de Skypiea : Montblanc Norland et le féroce guerrier Calgara.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362105.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":187,\"absoluteNumber\":187,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:10:45\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362106,\"seriesId\":81797,\"name\":\"La malédiction est levée ! Les larmes du grand guerrier.\",\"aired\":\"2004-03-28\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le souvenir de la légende de Montblanc Norland et Calgara le guerrier continue avec l'histoire de l'apparition soudaine de l'amitié entre ces deux hommes très différents, et de sa disparition tout aussi soudaine.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362106.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":188,\"absoluteNumber\":188,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-05 13:11:09\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362107,\"seriesId\":81797,\"name\":\"Des amis éternels ! La cloche du serment résonne à travers la mer !\",\"aired\":\"2004-04-04\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Montblanc Norland et le guerrier Calgara arrivent à régler leur différend avant de se séparer, mais les lois de la nature et de l'homme s'entendent pour les maintenir à distance pour toujours.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362107.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":189,\"absoluteNumber\":189,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-06 04:50:32\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362108,\"seriesId\":81797,\"name\":\"Angel Island est anéantie ! L'effet dévastateur du Raigo.\",\"aired\":\"2004-04-25\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Ener frappe Angel Island avec un éclair dévastateur, et Luffy continue sa montée héroïque le long du haricot géant. L'homme élastique refuse de s'arrêter tant qu'il n'aura pas fait sonner la cloche en or, à n'importe quel prix.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362108.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":190,\"absoluteNumber\":190,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-06 04:51:03\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362109,\"seriesId\":81797,\"name\":\"Abattez le Giant Jack ! Un ultime espoir de fuite !\",\"aired\":\"2004-05-02\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Tandis qu'Ener continue ses tirs de barrage détonants, Nami fomente un plan pour donner à Luffy une chance de plus dans un match revanche contre Dieu. Zoro est au centre du projet, mais il pourrait bien ne pas survivre à sa mission.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362109.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":191,\"absoluteNumber\":191,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-06 04:51:34\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362110,\"seriesId\":81797,\"name\":\"Miracle sur l'île sacrée ! Love Song pour les anges.\",\"aired\":\"2004-05-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La vivacité d'esprit de Nami rapproche Luffy de Dieu, et le capitaine au chapeau de paille se lance lui-même au cœur d'une sinistre tempête.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362110.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":192,\"absoluteNumber\":192,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-06 04:52:12\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362111,\"seriesId\":81797,\"name\":\"La fin du combat ! Fantasia qui résonne fièrement au loin !\",\"aired\":\"2004-05-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Au lendemain du combat épique de Luffy contre Ener, le soleil chasse les tempêtes au loin, et les citoyens des nuages d'Angel Island focalisent leur attention sur la reconstruction de leur patrie.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362111.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":193,\"absoluteNumber\":193,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 20:50:20\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362112,\"seriesId\":81797,\"name\":\"J'étais en ces lieux ! L'Histoire tissée au fil des Ponéglyphes.\",\"aired\":\"2004-06-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Robin tente de déchiffrer l'énigme d'un mystérieux ponéglyphe, Usopp fait du troc avec les autochtones, et Luffy fait main basse sur les trésors inestimables de la légendaire cité d'or.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362112.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":194,\"absoluteNumber\":194,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 20:50:48\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362113,\"seriesId\":81797,\"name\":\"Retour à la Mer bleue ! Une dernière partition chargée d'émotions !\",\"aired\":\"2004-06-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Avec un peu d'aide de la part de leurs nouveaux amis, et d'une pieuvre géante, les chapeaux de paille disent adieu à Skypiea et commencent leur descente vers la mer bleue.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362113.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":195,\"absoluteNumber\":195,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 20:51:55\",\"finaleType\":\"season\",\"year\":\"2004\"},{\"id\":362114,\"seriesId\":81797,\"name\":\"Etat d’alerte déclaré ! Un bateau de pirates notoires s’est infiltré !\",\"aired\":\"2004-06-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après une effrayante dégringolade depuis les nuages, les chapeaux de paille se retrouvent piégés dans une forteresse impénétrable de la marine. L'équipe est séparée, le Vogue Merry est saisi, et des rumeurs de fantômes prennent de l'ampleur.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362114.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":196,\"absoluteNumber\":196,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 20:52:14\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362115,\"seriesId\":81797,\"name\":\"Sanji le cuistot ! Prouver sa valeur dans les cuisines de la Marine !\",\"aired\":\"2004-07-04\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Pendant que Nami cherche le Vogue Merry, Luffy et Sanji se font passer pour des chefs célèbres et finissent par participer à un concours contre une très jolie maître queux.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362115.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":197,\"absoluteNumber\":197,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 20:52:32\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362116,\"seriesId\":81797,\"name\":\"Zoro est capturé ! Chopper opère d’urgence !\",\"aired\":\"2004-07-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro est emprisonné et interrogé, et le très mauvais choix de cachette de Chopper le conduit dans une salle d'opération en compagnie d'un médecin qui ne supporte pas la vue du sang.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362116.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":198,\"absoluteNumber\":198,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 20:53:14\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362117,\"seriesId\":81797,\"name\":\"Le filet se resserre ! Une seconde arrestation !\",\"aired\":\"2004-07-18\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"À cause de son appétit insatiable, Luffy révèle son identité, et un autre membre de son équipage finit en prison quand deux des chapeaux de paille essaient de duper le vice-amiral Jonathan avec le même déguisement.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362117.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":199,\"absoluteNumber\":199,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 20:53:37\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362118,\"seriesId\":81797,\"name\":\"La détermination de Luffy et Sanji ! Le grand plan de sauvetage !\",\"aired\":\"2004-08-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le vice-amiral Jonathan tend un piège aux chapeaux de paille, mais Luffy et Sanji ont décidé de tout risquer pour aider leurs camarades à se faire la belle. Est-ce qu'un souvenir du ciel leur sauvera la mise, ou est-ce que leur fuite sera sabordée par un crime.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362118.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":200,\"absoluteNumber\":200,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 20:53:55\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362119,\"seriesId\":81797,\"name\":\"L’unité spéciale « Sang bouillonnant » entre en scène ! Affrontement sur le pont !\",\"aired\":\"2004-09-05\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et son équipe s'échappent vers les docks, et le vice-amiral Jonathan déploie des gardes armés pour tenter de ralentir les chapeaux de paille.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362119.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":201,\"absoluteNumber\":201,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 20:57:12\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362120,\"seriesId\":81797,\"name\":\"Il faut forcer le barrage ! Le Vogue Merry est retrouvé.\",\"aired\":\"2004-09-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les chapeaux de paille sont encerclés, en infériorité numérique et bombardés de gaz lacrymogène. Prendre une jeune et jolie doctoresse en otage est peut-être leur seul espoir de survivre assez longtemps pour se retrouver ensemble.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362120.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":202,\"absoluteNumber\":202,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 20:59:58\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362121,\"seriesId\":81797,\"name\":\"Le bateau pirate a disparu ! Bataille de la forteresse, 2e round.\",\"aired\":\"2004-09-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et son équipage sont presque à l'abri quand Nami fait une horrible découverte : la marine a volé leur or ! Maintenant, les chapeaux de paille doivent naviguer droit dans le feu de l'action pour récupérer leurs richesses perdues.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362121.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":203,\"absoluteNumber\":203,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:00:18\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362122,\"seriesId\":81797,\"name\":\"Double mission : Récupérer l’or et récupérer le Waver.\",\"aired\":\"2004-10-03\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Usopp fomente un plan d'attaque nocturne contre le coffre-fort de la marine, mais le vice-amiral Jonathan a préparé une méchante surprise aux pirates. Pendant ce temps, Sanji et Nami tentent de récupérer le waver.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362122.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":204,\"absoluteNumber\":204,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:00:43\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362123,\"seriesId\":81797,\"name\":\"Un coup de filet stratégique ! Le plan secret de Jonathan !\",\"aired\":\"2004-10-03\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy, Zoro, Usopp et Robin continuent de chercher leur trésor. Sanji conduit Nami aux quartiers du capitaine où ils récupèrent leur or.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362123.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":205,\"absoluteNumber\":205,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:04:11\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362124,\"seriesId\":81797,\"name\":\"Adieu à la forteresse de la Marine ! Dernier combat pour l’évasion.\",\"aired\":\"2004-10-10\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les chapeaux de paille pensent peut-être qu'ils sont hors de danger, mais le vice-amiral Jonathan a préparé un dernier piège pour arraisonner le Vogue Merry.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362124.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":206,\"absoluteNumber\":206,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:04:33\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362125,\"seriesId\":81797,\"name\":\"Grande aventure à Long Ring Long Land !\",\"aired\":\"2004-10-31\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et ses camarades survivent de justesse à une rencontre avec des singes des mers perfides pour toucher terre sur une île mystérieuse où tout est beaucoup plus long qu'il ne le devrait.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362125.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":207,\"absoluteNumber\":207,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:04:52\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362126,\"seriesId\":81797,\"name\":\"L’équipage de Foxy le pirate et le Davy Back Fight !\",\"aired\":\"2004-11-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après l'attaque par des crapules d'une jument loyale et de son maître fraîchement revenu à la maison, Luffy est attiré dans un Davy Back Fight avec les pirates de Foxy. Le capitaine des chapeaux de paille ne refuse jamais un défi, mais ce petit jeu pourrait lui coûter son équipage.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362126.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":208,\"absoluteNumber\":208,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:05:14\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362127,\"seriesId\":81797,\"name\":\"Premier round ! Un tour sur la Donut Race !\",\"aired\":\"2004-11-14\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le Davy Back Fight commence par une Donut Race périlleuse autour de Long Ring Long Land.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362127.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":209,\"absoluteNumber\":209,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:05:33\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362128,\"seriesId\":81797,\"name\":\"Foxy le renard argenté ! Une ingérence de taille !\",\"aired\":\"2004-11-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les chapeaux de paille sont sur le point de gagner grâce à Nami qui utilise ses incroyables talents de navigatrice, mais le capitaine des pirates de Foxy a bien plus d'un sale tour dans son sac.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362128.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":210,\"absoluteNumber\":210,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:05:52\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362129,\"seriesId\":81797,\"name\":\"Second round ! Le but du Groggy Ring !\",\"aired\":\"2004-11-28\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Grâce à un sabotage rusé, Chopper a été capturé par l'ennemi. Le seul espoir de le ramener repose sur Zoro et Sanji.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362129.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":211,\"absoluteNumber\":211,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:06:10\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362130,\"seriesId\":81797,\"name\":\"Cartons rouges en série ! Le Groggy Ring !\",\"aired\":\"2004-12-05\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Sanji et Zoro prennent une raclée des mains des Groggy Monsters, mais ils n'abandonnent pas le match.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362130.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":212,\"absoluteNumber\":212,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:06:29\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362131,\"seriesId\":81797,\"name\":\"Troisième round ! Course de rollers et tours de pistes !\",\"aired\":\"2004-12-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les Chapeaux de Paille affrontent Foxy dans une course autour d'un ring géant en patins à roulettes.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362131.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":213,\"absoluteNumber\":213,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:16:09\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362132,\"seriesId\":81797,\"name\":\"Une fin de course explosive ! En route pour le dernier round !\",\"aired\":\"2004-12-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Pendant que le Davy Back Fight fonce vers un finish sensationnel, les chapeaux de paille frôlent la défaite. Luffy arrive finalement à rester sur ses rollers, mais les pirates de Foxy sont des tricheurs notoires.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362132.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":214,\"absoluteNumber\":214,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:16:28\",\"finaleType\":null,\"year\":\"2004\"},{\"id\":362133,\"seriesId\":81797,\"name\":\"Un service fulgurant. Balle au prisonnier version pirate.\",\"aired\":\"2005-01-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Avec la victoire de Luffy reprend Chopper, mais accepte bêtement un autre défi de Foxy.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362133.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":215,\"absoluteNumber\":215,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:16:47\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362134,\"seriesId\":81797,\"name\":\"Match sur la falaise ! 1, 2, 3, Soleil, Pirate !\",\"aired\":\"2005-01-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Un jeu de balle au prisonnier retors fait perdre leur archéologue aux chapeaux de paille. Maintenant, ils vont devoir gagner une course de côte inhabituelle pour récupérer Robin et éviter de perdre un autre membre d'équipage.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362134.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":216,\"absoluteNumber\":216,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:17:05\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362135,\"seriesId\":81797,\"name\":\"Guerre de capitaines ! Le combat final !\",\"aired\":\"2005-01-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Alors que Chopper a de nouveau disparu de l'équipage de Luffy, Luffy et Foxy s'affrontent dans le jeu final : une bataille de muscles à bord du navire de Foxy.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362135.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":217,\"absoluteNumber\":217,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:17:23\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362136,\"seriesId\":81797,\"name\":\"Ramollo Beam à plein gaz contre Luffy l’invincible.\",\"aired\":\"2005-01-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy continue de combattre Foxy avec des chances qui ne sont pas en sa faveur, et le combat continue à l'intérieur du vaisseau de Foxy.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362136.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":218,\"absoluteNumber\":218,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:17:40\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362137,\"seriesId\":81797,\"name\":\"Combat extrême et sans merci ! L’affrontement final et décisif.\",\"aired\":\"2005-01-30\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le combat épique entre Luffy et le capitaine Foxy promet une fin captivante, et un très vieil homme avec une jument très grande retrouve quelqu'un qu'il n'avait pas vu depuis très longtemps.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362137.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":219,\"absoluteNumber\":219,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:17:58\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362138,\"seriesId\":81797,\"name\":\"Vous avez perdu la mémoire ? Où a-t-elle été volée ? Qui êtes-vous ?\",\"aired\":\"2005-02-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Quand Luffy et ses amis perdent la mémoire, Robin est la seule des chapeaux de paille à se souvenir de leurs aventures ensemble.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362138.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":220,\"absoluteNumber\":220,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:18:14\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362139,\"seriesId\":81797,\"name\":\"Le Mystérieux Garçon au cor et l’hypothèse de Robin.\",\"aired\":\"2005-02-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Robin essaie de maintenir l'équipage ensemble tout en résolvant le mystère de la perte de mémoire. Pendant ce temps, Nami et Zoro sont victimes de flashs-back de moments douloureux de leur passé.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362139.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":221,\"absoluteNumber\":221,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:18:33\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362140,\"seriesId\":81797,\"name\":\"Il est temps de récupérer nos souvenirs ! Les pirates débarquent !\",\"aired\":\"2005-02-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les chapeaux de paille trouvent finalement le coupable de leur perte de mémoire, mais de plus gros problèmes se présentent. Le mystérieux voleur est décidé à faire s'affronter Zoro et Luffy.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362140.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":222,\"absoluteNumber\":222,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:18:50\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362141,\"seriesId\":81797,\"name\":\"Zoro montre les crocs ! Une bête sauvage se dresse !\",\"aired\":\"2005-02-27\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro et Luffy s'engagent dans un combat à mort, Nami essaie d'orchestrer une révolte, et Sanji découvre qu'il a vraiment envie de tabasser un gamin pour récupérer ses souvenirs.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362141.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":223,\"absoluteNumber\":223,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:30:08\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362142,\"seriesId\":81797,\"name\":\"Le voleur de mémoire est démasqué ! C’est l’attaque finale !\",\"aired\":\"2005-03-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les chapeaux de paille récupèrent leurs souvenirs, mais un défi bien plus important s'avance à l'horizon. Le mystérieux voleur est sur le point de se transformer en quelque chose d'encore plus puissant.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362142.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":224,\"absoluteNumber\":224,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:30:37\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362143,\"seriesId\":81797,\"name\":\"Un homme et sa fierté ! Foxy le Renard Argenté !\",\"aired\":\"2005-03-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Une terrible tempête mène à une nouvelle rencontre avec le perfide capitaine Foxy. Quand Luffy prend la dangereuse décision d'aider son vieil ennemi, la catastrophe menace les chapeaux de paille.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362143.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":225,\"absoluteNumber\":225,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:31:25\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362144,\"seriesId\":81797,\"name\":\"Ce type serait-il imbattable ? L’homme le plus dangereux du monde !\",\"aired\":\"2005-03-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et ses camarades doivent survivre à une autre terrible bataille à bord du bateau piégé du capitaine Foxy, et même s'ils y parviennent, quelque chose de bien pire les attend.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362144.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":226,\"absoluteNumber\":226,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:31:48\",\"finaleType\":\"season\",\"year\":\"2005\"},{\"id\":362145,\"seriesId\":81797,\"name\":\"L’Amiral de la Marine Aokiji ! La menace du plus puissant bras armé.\",\"aired\":\"2005-03-27\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les chapeaux de paille prennent le temps de secourir un groupe de naufragés affamés, mais les problèmes pointent à l'horizon. Un glacial adversaire de la marine est à la recherche de Robin.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362145.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":227,\"absoluteNumber\":227,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:32:14\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362146,\"seriesId\":81797,\"name\":\"Duel entre Gum Gum et Glace. Luffy contre Aokiji !\",\"aired\":\"2005-03-27\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Chopper et Usopp travaillent fébrilement à sauver Robin de son cercueil de glace, et Luffy cherche à égaliser les chances avec l'amiral Aokiji dans un combat d'homme à homme sans merci.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362146.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":228,\"absoluteNumber\":228,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:32:46\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362147,\"seriesId\":81797,\"name\":\"Le train des mers fonçant à toute allure et Water Seven, la métropole aquatique.\",\"aired\":\"2005-04-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Une rencontre avec une grenouille géante qui nage le crawl conduit à une quasi-collision avec un train des mers ! Prochaines étapes pour les chapeaux de paille : jeter l'ancre dans une ville pleine d'eau et chercher un charpentier de navire.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362147.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":229,\"absoluteNumber\":229,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:33:15\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362148,\"seriesId\":81797,\"name\":\"Aventure dans la cité aquatique ! En route pour le chantier naval géant.\",\"aired\":\"2005-04-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy, Usopp et Nami font une virée dans Water Seven à la recherche d'un charpentier. Pendant ce temps, Chopper et Robin se trouvent séparés durant leur exploration pour trouver une librairie.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362148.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":230,\"absoluteNumber\":230,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 21:33:42\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362149,\"seriesId\":81797,\"name\":\"La Franky Family et Monsieur Icebarg.\",\"aired\":\"2005-05-01\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro est agressé par des brigands qui veulent toucher sa prime, Sanji se perd en faisant les courses, et trois valises pleines de cash disparaissent mystérieusement.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362149.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":231,\"absoluteNumber\":231,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 22:53:27\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362150,\"seriesId\":81797,\"name\":\"Galley-La Company ! L’impressionnant quai numéro un.\",\"aired\":\"2005-05-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Un charpentier et son pigeon qui parle aident à récupérer l'argent des chapeaux de paille, mais la Franky Family n'abandonne pas si facilement. Luffy et Nami apprennent une très mauvaise nouvelle au sujet de leur bateau bien-aimé.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362150.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":232,\"absoluteNumber\":232,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 22:53:53\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362151,\"seriesId\":81797,\"name\":\"Un pirate kidnappé et un navire à l’agonie.\",\"aired\":\"2005-05-22\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et Nami refusent de croire que l'aventure est terminée pour le Vogue Merry, mais pour le moment, de plus gros problèmes pointent à l'horizon. Leur argent a encore disparu, de même qu'Usopp.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362151.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":233,\"absoluteNumber\":233,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 22:54:46\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362152,\"seriesId\":81797,\"name\":\"Sauvons notre ami ! On frappe avant d’entrer à la Franky House !\",\"aired\":\"2005-06-05\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Usopp essaie courageusement de récupérer l'argent volé, mais la Franky Family est largement en surnombre. Zoro, Sanji et Chopper montent une mission de secours, mais ils auront besoin de Luffy pour égaliser les chances.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362152.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":234,\"absoluteNumber\":234,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 22:55:14\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362153,\"seriesId\":81797,\"name\":\"Mutinerie au clair de lune ! Complainte d’un drapeau pirate !\",\"aired\":\"2005-06-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Une fois de retour sur le navire, Luffy doit enfin dire à Usopp que le Vogue Merry ne peut plus être réparé et qu'ils ont choisi d'acquérir un nouveau navire sans lui.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362153.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":235,\"absoluteNumber\":235,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 22:55:43\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362154,\"seriesId\":81797,\"name\":\"Luffy contre Usopp ! Le choc entre deux hommes obstinés !\",\"aired\":\"2005-06-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et Usopp se battent jusqu'au coup d'arrêt brutal dans un duel déchirant entre deux hommes qui se considéraient comme de la même famille.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362154.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":236,\"absoluteNumber\":236,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 22:56:11\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362155,\"seriesId\":81797,\"name\":\"La métropole aquatique est sous le choc ! On a tiré sur Icebarg !\",\"aired\":\"2005-07-03\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La séparation des chapeaux de paille est éclipsée par la tentative d'assassinat du maire de Water Seven.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362155.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":237,\"absoluteNumber\":237,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 22:56:40\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362156,\"seriesId\":81797,\"name\":\"L’homme élastique contre le cyborg cracheur de feu !\",\"aired\":\"2005-07-10\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le combat revanchard entre Luffy et Franky s'aggrave quand on découvre que son adversaire est un cyborg. Icebarg sort de sa léthargie avant de proférer des accusations odieuses envers les chapeaux de paille.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362156.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":238,\"absoluteNumber\":238,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 22:57:10\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362157,\"seriesId\":81797,\"name\":\"Le Chapeau de paille est-il coupable ? Les défenseurs de Water Seven.\",\"aired\":\"2005-07-31\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy est catalogué comme assassin et attaqué par les hommes les plus puissants d'Icebarg. Pendant ce temps, Sanji et Chopper tentent de prévenir Usopp au sujet d'une catastrophe naturelle imminente.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362157.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":239,\"absoluteNumber\":239,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 22:57:41\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362158,\"seriesId\":81797,\"name\":\"Des adieux à jamais ? La part d’ombre de Nico Robin.\",\"aired\":\"2005-08-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les citoyens de Water Seven recherchent les chapeaux de paille, et une tempête dévastatrice menace de couler la ville. Chopper et Sanji retrouvent la trace de Robin, mais ils ne sont pas préparés à leur découverte.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362158.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":240,\"absoluteNumber\":240,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 22:58:13\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362159,\"seriesId\":81797,\"name\":\"Il faut coincer Robin ! La décision des pirates au chapeau de paille !\",\"aired\":\"2005-08-14\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Usopp se prépare à affronter la tempête à bord du Vogue Merry, Franky élabore un plan pour forcer Luffy à faire la revanche, et les chapeaux de paille se décident à découvrir le sombre secret de Robin.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362159.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":241,\"absoluteNumber\":241,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:07:24\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362160,\"seriesId\":81797,\"name\":\"Au signal, à l’explosion ! Le CP9 passe à l’action !\",\"aired\":\"2005-08-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Robin et ses confrères du CP9 cherchent à régler une vieille affaire avec Icebarg. Les chapeaux de paille ont un plan pour laver leurs noms, mais les assassins ont un coup d'avance sur eux.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362160.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":242,\"absoluteNumber\":242,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:08:04\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362161,\"seriesId\":81797,\"name\":\"Le CP9 fait tomber les masques ! Des identités stupéfiantes !\",\"aired\":\"2005-09-04\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy fait son entrée tant attendue, Icebarg réserve une sacrée surprise à Robin, et les identités réelles des assassins masqués du CP9 sont enfin dévoilées.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362161.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":243,\"absoluteNumber\":243,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:08:37\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362162,\"seriesId\":81797,\"name\":\"Un lien secret ! Icebarg et Franky.\",\"aired\":\"2005-09-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le CP9 lit dans le sang d'Icebarg pour apprendre où se trouvent les plans, Usopp est encore confronté à Franky, et les chapeaux de paille restants, plus un nouvel ami, accourent à la rescousse.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362162.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":244,\"absoluteNumber\":244,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:09:11\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362163,\"seriesId\":81797,\"name\":\"Reviens, Robin ! L’affrontement avec le CP9 !\",\"aired\":\"2005-09-18\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et sa bande tombent face à face avec Robin et ses camarades du CP9. L'homme-élastique s'est préparé à combattre pour son amie, mais il n'a jamais affronté des ennemis pareils.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362163.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":245,\"absoluteNumber\":245,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:09:47\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362164,\"seriesId\":81797,\"name\":\"L’équipage au chapeau de paille décimé ? La menace du modèle Léopard.\",\"aired\":\"2005-10-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy, Zoro et Nami sont envoyés vers la mort par les bandits du CP9. Pendant ce temps, Usopp établit une amitié improbable avec Franky tout en attendant une tempête.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362164.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":246,\"absoluteNumber\":246,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:10:29\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362165,\"seriesId\":81797,\"name\":\"L’amour entre un homme et son bateau ! Les larmes d’Usopp !\",\"aired\":\"2005-10-30\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Franky tente de convaincre Usopp qu'il n'y a plus d'espoir pour le Vogue Merry, mais le sniper, inspiré par un mystérieux souvenir, reste fidèle à son bateau bien-aimé.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362165.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":247,\"absoluteNumber\":247,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:11:00\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362166,\"seriesId\":81797,\"name\":\"Le passé de Franky ! Le jour où le train des mers a démarré !\",\"aired\":\"2005-11-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Un petit retour vers le passé de Franky dévoile les origines incroyables du train des mers, et brosse une image saisissante de sa jeunesse, passée aux côtés d'Icebarg et du légendaire Tom le charpentier.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362166.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":248,\"absoluteNumber\":248,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:11:33\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362167,\"seriesId\":81797,\"name\":\"Le complot de Spandam. Le jour où le train des mers a vacillé.\",\"aired\":\"2005-11-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'histoire de Franky continue. Le train des mers est un succès, et on dirait que la vie de Tom est épargnée. Malheureusement, un espion du gouvernement cherche une raison d'enquêter sur Tom, et Franky fournit les informations.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362167.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":249,\"absoluteNumber\":249,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:12:10\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362168,\"seriesId\":81797,\"name\":\"La fin d’un homme légendaire ! Le jour où le train des mers a pleuré.\",\"aired\":\"2005-11-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Tom accomplit l'impensable pour tenter de protéger ses apprentis, mais le jeune Franky est incapable de contrôler sa colère, entraînant une confrontation avec un espion, et un train.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362168.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":250,\"absoluteNumber\":250,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:12:42\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362169,\"seriesId\":81797,\"name\":\"La vérité derrière la trahison ! Le douloureux choix de Robin !\",\"aired\":\"2005-11-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'héroïsme de Chopper pourrait faire la différence entre la vie et la mort pour Icebarg et Pauly, Nami apprend l'atroce vérité à propos de Robin, et Sanji se prépare à se mettre en mouvement.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362169.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":251,\"absoluteNumber\":251,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:17:10\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362170,\"seriesId\":81797,\"name\":\"Le train des mers sifflera une fois ! Des amis qui se séparent.\",\"aired\":\"2005-12-04\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nami se lance dans une course effrénée vers la gare du train des mers, Chopper cherche désespérément Zoro et Luffy, et Sanji se la coule douce en attendant le bon moment de se jeter dans le feu de l'action.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362170.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":252,\"absoluteNumber\":252,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:17:34\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362171,\"seriesId\":81797,\"name\":\"Sanji s’est infiltré ! Le train des mers dans la tempête !\",\"aired\":\"2005-12-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nami arrive à la gare une minute trop tard, Sanji se fait connaître à bord du train des mers, et la recherche de Luffy et Zoro se poursuit.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362171.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":253,\"absoluteNumber\":253,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:17:54\",\"finaleType\":null,\"year\":\"2005\"},{\"id\":362172,\"seriesId\":81797,\"name\":\"Nami crie de toute son âme ! Le retour de Luffy au chapeau de paille !\",\"aired\":\"2006-01-22\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Chopper et Nami risquent leur vie dans une tentative désespérée de sauver Luffy et Zoro d'un immense mur d'eau. Pendant ce temps, les retrouvailles entre Sanji et Robin se rapprochent.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362172.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":254,\"absoluteNumber\":254,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:18:18\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362173,\"seriesId\":81797,\"name\":\"Un autre train des mers ? Le départ du Rocketman !\",\"aired\":\"2006-01-29\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et Nami essaient d'emprunter un navire pour poursuivre le train des mers, mais le temps est trop mauvais pour naviguer. Heureusement pour eux, Icebarg et ses amis sont pleins de ressources.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362173.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":255,\"absoluteNumber\":255,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:18:36\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362174,\"seriesId\":81797,\"name\":\"Au secours de nos amis ! Pacte entre ennemis, à la force des poings !\",\"aired\":\"2006-02-05\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy, Zoro, Chopper et Nami foncent vers un rendez-vous avec les assassins du CP9, mais ils vont devoir faire alliance avec de nouveaux amis pour avoir la moindre chance de survie.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362174.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":256,\"absoluteNumber\":256,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:18:57\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362175,\"seriesId\":81797,\"name\":\"Une brèche dans la vague ! Le combo ultime : Luffy et Zoro.\",\"aired\":\"2006-02-26\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro et Luffy s'expliquent en tête-à-tête avec mère nature, et la mission de secours de Sanji est dynamisée par la loyauté de Franky et l'arrivée du mystérieux Sniperking.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362175.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":257,\"absoluteNumber\":257,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:19:21\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362176,\"seriesId\":81797,\"name\":\"Un homme mystérieux entre en scène ! Son nom est Sniperking !\",\"aired\":\"2006-03-05\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Sniperking, un mystérieux guerrier venu de l'île des snipers, donne un coup de main quand Franky et Sanji essaient de se frayer un passage vers Robin.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362176.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":258,\"absoluteNumber\":258,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:19:41\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362177,\"seriesId\":81797,\"name\":\"Duel de chefs ! Sanji contre l’art martial des nouilles !\",\"aired\":\"2006-03-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Sanji se crêpe le chignon avec un cuisinier dingo, Franky règle ses comptes avec la dernière recrue du CP9, et Sniperking déborde de créativité dans sa tentative d'atteindre Robin.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362177.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":259,\"absoluteNumber\":259,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:25:36\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362178,\"seriesId\":81797,\"name\":\"Combat sur le toit ! Franky contre Nero !\",\"aired\":\"2006-03-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Franky et Sanji continuent à combattre les bandits du CP9. Pendant ce temps, Luffy et le reste de la bande foncent vers une collision qui pourrait signifier la fin pour tout le monde.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362178.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":260,\"absoluteNumber\":260,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:25:54\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362179,\"seriesId\":81797,\"name\":\"Gare à la collision ! Le Demon Slash de Zoro contre le Boat Slash de T-Bone !\",\"aired\":\"2006-04-02\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro affronte un maître-épéiste, Sanji essaie d'en finir avec un maître en ramen fracassant, et Franky assène finalement un sérieux coup à son ennemi du CP9.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362179.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":261,\"absoluteNumber\":261,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:26:11\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362180,\"seriesId\":81797,\"name\":\"Bataille pour reprendre Robin ! L’ingénieux stratagème de Sniperking !\",\"aired\":\"2006-04-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Sniperking échafaude un plan audacieux pour s'échapper, mais les assassins du CP9 sont bien plus puissants que nos héros l'avaient imaginé. Pendant ce temps, Luffy et sa bande rencontrent une grenouille très connue.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362180.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":262,\"absoluteNumber\":262,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:26:31\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362181,\"seriesId\":81797,\"name\":\"L’île judiciaire ! Panorama d’Enies Lobby !\",\"aired\":\"2006-04-30\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Pendant que leur train approche d’Enies Lobby, les propos bienveillants de Franky parviennent à pénétrer la carapace de Robin. Le train de Luffy a été éjecté de la voie, mais le groupe incorpore un nouvel allié très puissant.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362181.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":263,\"absoluteNumber\":263,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:26:51\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362182,\"seriesId\":81797,\"name\":\"Opération débarquement ! Les pirates au chapeau de paille foncent dans le tas !\",\"aired\":\"2006-05-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les chapeaux de paille élaborent un plan pour sauver Robin, mais comme d'habitude, Luffy ne peut pas s'empêcher d'engager le combat.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362182.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":264,\"absoluteNumber\":264,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:27:12\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362183,\"seriesId\":81797,\"name\":\"Luffy débarque ! Grande bataille sur l’île judiciaire !\",\"aired\":\"2006-06-04\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy se débrouille pour atteindre l'île principale, mais la Franky Family se fait stopper net dans son assaut par des géants en colère.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362183.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":265,\"absoluteNumber\":265,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:27:31\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362184,\"seriesId\":81797,\"name\":\"Combat contre les géants ! Ouvrez la deuxième porte !\",\"aired\":\"2006-06-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy ne fait qu'une bouchée de quelques centaines de marines, la Franky Family fait tomber un géant, et les assassins du CP9 font leur rapport à Spandam.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362184.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":266,\"absoluteNumber\":266,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:27:48\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362185,\"seriesId\":81797,\"name\":\"Ouvrez le passage ! L’envol du Rocketman !\",\"aired\":\"2006-06-18\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La vivacité d'esprit de Zoro, et un peu d'aide de la part d'une grenouille géante, envoie le train des mers dans les airs vers une collision avec des gardes armés et leurs compagnons canins.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362185.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":267,\"absoluteNumber\":267,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:28:07\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362186,\"seriesId\":81797,\"name\":\"À la poursuite de Luffy ! L’équipage du chapeau de paille au combat !\",\"aired\":\"2006-06-25\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nami électrise l'ennemi avec une attaque de Clima Tact, mais les méchants arrivent à encercler les chapeaux de paille jusqu'à ce que la Franky Family ne débarque avec quelques monstres marins.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362186.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":268,\"absoluteNumber\":268,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:28:27\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362187,\"seriesId\":81797,\"name\":\"Robin est trahie ! Les espérances du gouvernement mondial.\",\"aired\":\"2006-06-25\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro, Sanji, Nami et Chopper essaient de rattraper leur capitaine, Sniperking est introuvable, et Luffy fonce la tête la première vers un combat contre Blueno.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362187.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":269,\"absoluteNumber\":269,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:38:31\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362188,\"seriesId\":81797,\"name\":\"Rendez-nous Robin ! Luffy contre Blueno !\",\"aired\":\"2006-07-02\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy montre sa nouvelle force dans une bagarre contre Blueno, Sniperking se lie d'amitié avec un géant, et un imposant monstre marin fait le sacrifice ultime.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362188.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":270,\"absoluteNumber\":270,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:38:53\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362189,\"seriesId\":81797,\"name\":\"Ne vous arrêtez pas ! Le signal de la contre attaque est donné !\",\"aired\":\"2006-07-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Pendant que Luffy continue son combat contre Blueno, les compagnons géants de Sniperking font sentir leur présence, et les assassins du CP9 expérimentent des fruits du démon.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362189.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":271,\"absoluteNumber\":271,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:39:12\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362190,\"seriesId\":81797,\"name\":\"Luffy en vue ! Rassemblement sur la place du Tribunal.\",\"aired\":\"2006-07-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Un King Bull aveugle se bat jusqu'à son dernier souffle pour amener les chapeaux de paille un peu plus près de leur capitaine. Luffy passe la seconde pour protéger ses amis de dangereux ennemis.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362190.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":272,\"absoluteNumber\":272,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:39:28\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362191,\"seriesId\":81797,\"name\":\"Je ferai tout pour protéger mes amis ! Le « Gear Second » en action !\",\"aired\":\"2006-07-30\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy tabasse un Blueno déconcerté par son nouveau style de combat surpuissant, et Spandam le froussard commence à paniquer au son des chapeaux de paille qui approchent.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362191.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":273,\"absoluteNumber\":273,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:39:56\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362192,\"seriesId\":81797,\"name\":\"Réponds-nous, Robin ! Le cri du coeur des pirates au chapeau de paille !\",\"aired\":\"2006-08-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et son équipage sont enfin réunis et prêts à secourir Robin, mais la beauté aux cheveux de jais reste réticente à rejoindre ses anciens camarades, malgré les encouragements de Franky.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362192.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":274,\"absoluteNumber\":274,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:40:28\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362193,\"seriesId\":81797,\"name\":\"Le passé de Robin ! Une fillette nommée « démon » !\",\"aired\":\"2006-08-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Flash-back vers les jeunes années de Robin, sa dangereuse quête de connaissances interdites, et sa rencontre avec un géant amical.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362193.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":275,\"absoluteNumber\":275,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:40:48\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362194,\"seriesId\":81797,\"name\":\"Une mère et sa fille frappées par le destin ! Sa mère s’appelle Olvia !\",\"aired\":\"2006-09-10\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le flash-back de Robin se poursuit avec le passage déchirant de sa mère et la cruelle et brutale intrusion du gouvernement sur une île pacifique.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362194.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":276,\"absoluteNumber\":276,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:41:07\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362195,\"seriesId\":81797,\"name\":\"La tragédie d’Ohara ! La terreur du Buster Call !\",\"aired\":\"2006-09-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le professeur Clover dévoile une surprenante et sinistre théorie au sujet du gouvernement mondial, Robin retrouve sa mère, et un géant se mêle à la bataille.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362195.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":277,\"absoluteNumber\":277,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:41:24\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362196,\"seriesId\":81797,\"name\":\"Dis que tu veux vivre Nous sommes tes amis !\",\"aired\":\"2006-09-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La pénible histoire d'Ohara, ainsi que les jeunes années de Robin, se dirigent vers une fin tragique. Luffy déclare la guerre au gouvernement mondial et Robin change finalement d'avis.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362196.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":278,\"absoluteNumber\":278,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:46:58\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362197,\"seriesId\":81797,\"name\":\"Vol au-dessus des chutes d’eau ! Les sentiments de Luffy !\",\"aired\":\"2006-10-01\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les chapeaux de paille sont prêts à entamer le combat pour Robin, mais d'abord, Luffy fouille dans ses souvenirs d'enfance et se souvient de l'homme qui lui a inspiré sa vie de pirate.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362197.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":279,\"absoluteNumber\":279,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:47:15\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362198,\"seriesId\":81797,\"name\":\"Voici comment doit vivre un homme ! Les techniques de Zoro, le rêve d’Usopp !\",\"aired\":\"2006-10-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro se souvient de sa première rencontre avec Luffy, et Usopp se rappelle les événements qui l'ont conduit à rejoindre les chapeaux de paille.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362198.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":280,\"absoluteNumber\":280,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:47:33\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362199,\"seriesId\":81797,\"name\":\"Les larmes tissent les liens des compagnons ! La carte du monde de Nami.\",\"aired\":\"2006-10-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le passé bouleversant de Nami, et le combat épique de Luffy contre Arlong, sont récapitulés dans ce flash-back des premiers jours des chapeaux de paille.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362199.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":281,\"absoluteNumber\":281,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:48:37\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362200,\"seriesId\":81797,\"name\":\"Les séparations forgent un homme ! Sanji et Chopper.\",\"aired\":\"2006-10-22\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Un flash-back met en lumière l'arrivée dans l'équipage de Sanji, et l'histoire de Chopper est dévoilée à travers des souvenirs de la visite d'une île couverte de neige.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362200.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":282,\"absoluteNumber\":282,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:49:04\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362201,\"seriesId\":81797,\"name\":\"Par amitié avant tout ! Robin dans les ténèbres.\",\"aired\":\"2006-10-29\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Un flash-back dévoile les motivations qui ont conduit Robin à coopérer avec le CP9, la bouleversante découverte du passé de l'archéologue par Nami, et la détermination de Luffy à sauver son amie.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362201.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":283,\"absoluteNumber\":283,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:49:26\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362202,\"seriesId\":81797,\"name\":\"Je ne te donnerai pas ces plans ! La décision de Franky !\",\"aired\":\"2006-11-05\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Franky se dresse contre Spandam en détruisant ce que ce fou désire le plus, et le sifflet du train des mers aiguillonne les chapeaux de paille et leur fait faire un acte de foi audacieux.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362202.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":284,\"absoluteNumber\":284,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:49:45\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362203,\"seriesId\":81797,\"name\":\"Volons les cinq clés ! L’équipage au chapeau de paille contre le CP9 !\",\"aired\":\"2006-11-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy court à la rescousse de Robin pendant que le reste des chapeaux de paille se mettent à la recherche des cinq clés nécessaires à la libération de l'archéologue.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362203.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":285,\"absoluteNumber\":285,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:50:04\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362204,\"seriesId\":81797,\"name\":\"Les pouvoirs des fruits du démon ! Les grandes transformations de Kaku et Jabura !\",\"aired\":\"2006-11-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Pendant qu'Usopp et Zoro se battent en tête-à-tête avec des animaux assassins, Sanji enseigne les secrets de la confection d'un thé de bonne qualité au membre le plus charmant du CP9.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362204.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":286,\"absoluteNumber\":286,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:50:22\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362205,\"seriesId\":81797,\"name\":\"Je ne te frapperai jamais même si je dois mourir ! La galanterie de Sanji le perdra !\",\"aired\":\"2006-11-26\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy se heurte à des difficultés en essayant de naviguer vers Robin, Usopp et Zoro finissent menottés ensemble, et l'incapacité de Sanji à frapper une femme risque de lui causer de sérieuses blessures.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362205.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":287,\"absoluteNumber\":287,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:50:40\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362206,\"seriesId\":81797,\"name\":\"Le mauvais calcul de Fukuro ! Mon cola est ma source de vie !\",\"aired\":\"2006-12-03\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Chimney et Gonbei montrent à Luffy le passage secret qui mène à Robin, et Franky fait une démonstration de puissance de frappe brute grâce à quelques bouteilles de cola.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362206.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":288,\"absoluteNumber\":288,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:58:23\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362207,\"seriesId\":81797,\"name\":\"Zoro et sa nouvelle technique explosive ! Son sabre s’appelle Sniperking ?\",\"aired\":\"2006-12-10\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Pendant que le combat de Franky se dirige vers l'océan, Usopp et Sanji tentent de se débarrasser de leurs menottes en se montrant plus malins que leurs adversaires.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362207.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":289,\"absoluteNumber\":289,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:58:41\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362208,\"seriesId\":81797,\"name\":\"Chopper est incontrôlable ! La Rumble Ball de trop.\",\"aired\":\"2006-12-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Déterminé à ne pas se faire battre par l'horrible héritier d'un lion diabolique, Chopper risque sa peau en invoquant le pouvoir de sa Rumble Ball pour la troisième fois.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362208.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":290,\"absoluteNumber\":290,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:58:55\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362209,\"seriesId\":81797,\"name\":\"Le retour de Luffy, le chef ! Loterie et déboires, rêve ou réalité ?\",\"aired\":\"2006-12-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Retour vers le passé du Japon pour une aventure abracadabrante jouée par les chapeaux de paille, quelques vieux amis et ennemis, et un dromadaire qui mange les tickets de loterie.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362209.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":291,\"absoluteNumber\":291,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:59:13\",\"finaleType\":null,\"year\":\"2006\"},{\"id\":362210,\"seriesId\":81797,\"name\":\"La grande course aux gâteaux de riz ! Le complot de Gros Pif.\",\"aired\":\"2007-01-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La folle aventure continue pour Luffy et sa bande, plus une foule de personnages de l'arc Alabasta, qui s'affrontent pour un trésor inestimable caché dans un goûteux gâteau.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362210.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":292,\"absoluteNumber\":292,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:59:34\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362211,\"seriesId\":81797,\"name\":\"Kalifa, maîtresse des bulles ! Nami va se faire passer un savon.\",\"aired\":\"2007-01-14\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nami se bat contre une belle baigneuse et ses bulles mortelles, Chopper libère la bête qui sommeille en lui, et Luffy se rapproche petit à petit de Robin.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362211.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":293,\"absoluteNumber\":293,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-10 23:59:52\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362212,\"seriesId\":81797,\"name\":\"Une mauvaise nouvelle retentissante ! Le Buster Call est déclenché.\",\"aired\":\"2007-01-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Franky fait une rencontre douloureuse avec le monstre Chopper, et Nami se fait nettoyer trop proprement pour se battre. Pendant ce temps, Spandam déclenche accidentellement le Buster Call mortel.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362212.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":294,\"absoluteNumber\":294,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:00:09\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362213,\"seriesId\":81797,\"name\":\"Cinq Nami ? La contre-attaque des mirages.\",\"aired\":\"2007-01-28\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro utilise Usopp comme leurre dans son combat contre les animaux, et Nami découvre le secret qui pourrait être la clé de sa survie dans sa bataille contre la beauté fatale.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362213.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":295,\"absoluteNumber\":295,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:00:26\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362214,\"seriesId\":81797,\"name\":\"La détermination de Nami ! Carton sur le Chopper enragé.\",\"aired\":\"2007-02-04\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Franky et Nami échafaudent un plan pour arrêter la folie destructrice de Chopper, mais il pourrait se révéler mortel pour le renne pas si petit que ça. Usopp et Zoro sont ravis d'être finalement libérés l'un de l'autre.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362214.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":296,\"absoluteNumber\":296,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:00:47\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362215,\"seriesId\":81797,\"name\":\"Sanji, le chasseur ! Un dernier poème pour le loup menteur.\",\"aired\":\"2007-02-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La tentative fâcheuse d'Usopp de se montrer courageux menace de le faire tuer, mais un pied bien connu sauve la vie du sniper. Luffy lutte pour ne serait-ce que toucher un ennemi incroyable, et Franky se dépêche d'apporter des clés très importantes.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362215.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":297,\"absoluteNumber\":297,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:04:58\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362216,\"seriesId\":81797,\"name\":\"Un coup de pied enflammé ! Au menu : jeu de jambe à la Sanji !\",\"aired\":\"2007-02-25\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Sanji rétablit l'équilibre du terrain de jeu dans son combat contre le CP9 en présentant à son adversaire lupin le pouvoir brûlant de la jambe à la diable.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362216.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":298,\"absoluteNumber\":298,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:05:17\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362217,\"seriesId\":81797,\"name\":\"Les armes blanches s’entrechoquent ! Zoro contre Kaku, duel de fine lames.\",\"aired\":\"2007-03-04\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro arrive finalement à asséner un coup à la girafe tueuse, mais Luffy est toujours incapable de trouver la faille de Lucci. Est-ce que Franky peut atteindre Robin avant qu'il ne soit trop tard.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362217.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":299,\"absoluteNumber\":299,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:05:34\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362218,\"seriesId\":81797,\"name\":\"Zoro, dieu ou démon ? Vision de l’avatar d’Ashura.\",\"aired\":\"2007-03-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro déchaîne une technique de combat démoniaque à neuf sabres sur son adversaire girafe, Luffy gagne du temps pour Franky en passant la seconde, et Robin refuse d'abandonner tout espoir d'être secourue.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362218.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":300,\"absoluteNumber\":300,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:05:55\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362219,\"seriesId\":81797,\"name\":\"Au grand dam de Spandam ! Un héros se dresse sur la Tour judiciaire !\",\"aired\":\"2007-03-18\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Spandam traîne cruellement Robin encore plus près des portes de la justice, mais le combat tourne à son désavantage quand Sniperking fait une apparition-surprise.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362219.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":301,\"absoluteNumber\":301,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:06:16\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362220,\"seriesId\":81797,\"name\":\"Robin est libre ! Luffy contre Lucci : bataille au sommet.\",\"aired\":\"2007-03-25\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le combat entre Luffy et Lucci dévoile les puissants secrets de la deuxième vitesse de l'homme élastique, et le Buster Call inconsidéré de Spandam commence par un furieux pilonnage à coups de boulets de canon.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362220.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":302,\"absoluteNumber\":302,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:06:37\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362221,\"seriesId\":81797,\"name\":\"Luffy est-il le coupable ? À la poursuite du grand cerisier disparu.\",\"aired\":\"2007-04-01\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Quand un arbre millénaire est volé par un fou ayant le pouvoir d'arrêter le temps, Luffy, Usopp et Sanji poursuivent le coupable dans une tentative de sauvetage du festival annuel d'un village.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362221.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":303,\"absoluteNumber\":303,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:07:08\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362222,\"seriesId\":81797,\"name\":\"Si je ne gagne pas, je ne pourrai protéger personne ! Le « Gear Third » en action !\",\"aired\":\"2007-04-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nami, Sanji, Usopp, Zoro et compagnie se retrouvent piégés dans un tunnel qui se remplit d'eau rapidement. Pendant ce temps, Luffy rassemble ses forces pour la dernière fois dans son combat contre Lucci.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362222.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":304,\"absoluteNumber\":304,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:07:31\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362223,\"seriesId\":81797,\"name\":\"Un terrible passé ! Rob Lucci et la justice des ténèbres.\",\"aired\":\"2007-04-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Flash-back dans le sombre passé de Rob Lucci où le jeune garçon apprend à rendre un certain type de justice froidement, brutalement et cruellement. Le combat entre Luffy et Lucci nous ramène dans le présent et menace de détruire la flotte de la marine.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362223.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":305,\"absoluteNumber\":305,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:07:57\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362224,\"seriesId\":81797,\"name\":\"Une sirène illusoire à la rescousse ? Une conscience vacillante…\",\"aired\":\"2007-04-22\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'attaque gigantesque de Luffy contre Lucci produit un effet dévastateur sur son corps, Robin entre dans la bataille, et les chapeaux de paille restants se démènent pour survivre sous l'eau.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362224.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":306,\"absoluteNumber\":306,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:15:17\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362225,\"seriesId\":81797,\"name\":\"L’île coule sous les coups de canon ! Le cri de regret de Franky !\",\"aired\":\"2007-04-29\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Grâce à un petit peu d'aide de la part de ce qui ressemble à une sirène, les chapeaux de paille se retrouvent réunis à bord d'un navire de sauvetage, mais les sorts de Luffy et de la Franky Family ne sont pas encore scellés.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362225.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":307,\"absoluteNumber\":307,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:15:38\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362226,\"seriesId\":81797,\"name\":\"En attendant Luffy ! Combat mortel sur le pont de l’hésitation !\",\"aired\":\"2007-05-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy pousse son corps au point de rupture dans son combat contre Lucci, et les autres chapeaux de paille essaient de résister à une flotte de la marine jusqu'à ce que leur capitaine revienne, s'il y arrive un jour.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362226.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":308,\"absoluteNumber\":308,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:15:55\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362227,\"seriesId\":81797,\"name\":\"La rage au bout des poings ! La rafale de Luffy à pleine puissance.\",\"aired\":\"2007-05-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy est à terre et gravement blessé, mais le plaidoyer désespéré d'Usopp insuffle à l'homme élastique la force de mettre au point une dernière attaque déchaînée contre Rob Lucci.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362227.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":309,\"absoluteNumber\":309,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:16:20\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362228,\"seriesId\":81797,\"name\":\"Un ami arrive par la mer ! L’équipage au chapeau de paille plus uni que jamais !\",\"aired\":\"2007-05-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Avec leur leader meurtri par l'épuisement et leur navire de sauvetage détruit, les chapeaux de paille n'ont plus qu'une seule solution périlleuse : se jeter à la mer.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362228.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":310,\"absoluteNumber\":310,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:16:42\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362229,\"seriesId\":81797,\"name\":\"Évasion générale ! Victoire sans appel pour les pirates !\",\"aired\":\"2007-05-27\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les chapeaux de paille sont sauvés par l'arrivée inattendue d'un vieil ami, mais ils vont devoir éviter le pilonnage par des boulets de canon mortels pour survivre.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362229.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":311,\"absoluteNumber\":311,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:17:03\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362230,\"seriesId\":81797,\"name\":\"Merci pour tout Merry ! Adieux sur une mer enneigée.\",\"aired\":\"2007-06-03\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les chapeaux de paille font leurs adieux éplorés au courageux petit bateau qui a été leur foyer pendant tant d'aventures.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362230.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":312,\"absoluteNumber\":312,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:17:20\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362231,\"seriesId\":81797,\"name\":\"Une trêve suspendue ! Le vice-amiral au poing de fer dans un gant d’amour.\",\"aired\":\"2007-06-10\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les chapeaux de paille prennent un repos bien mérité, Franky fait une annonce importante, et le vice-amiral Garp veut débusquer son petit-fils.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362231.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":313,\"absoluteNumber\":313,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:17:37\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362232,\"seriesId\":81797,\"name\":\"La plus puissante des familles ? Révélations sur le père de Luffy !\",\"aired\":\"2007-06-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les amis de Luffy sont abasourdis d'apprendre que son grand-père est un héros de la marine, mais ce n'est rien comparé à leur surprise quand ils connaîtront la véritable identité de son père.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362232.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":314,\"absoluteNumber\":314,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:18:00\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362233,\"seriesId\":81797,\"name\":\"Un nom prometteur : le Nouveau Monde ! La suite de Grand Line.\",\"aired\":\"2007-06-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy a la chance de retrouver son vieil ami Kobby, Nami fait de l'espionnage avec beaucoup de sérieux, et Robin reçoit une visite effrayante d'un terrifiant personnage venu du passé.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362233.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":315,\"absoluteNumber\":315,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:24:52\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362234,\"seriesId\":81797,\"name\":\"Shanks entre en scène ! Prémice d’une ère qui déraille.\",\"aired\":\"2007-07-01\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Shanks rend visite à Barbe Blanche et lui soumet une grave demande, Franky et Icebarg commencent la construction d'un bateau pour les chapeaux de paille, et les nouvelles des événements survenus à Enies Lobby se mettent à circuler.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362234.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":316,\"absoluteNumber\":316,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:25:28\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362235,\"seriesId\":81797,\"name\":\"Une fillette et son Yagara ! Enquête au coeur de la métropole aquatique.\",\"aired\":\"2007-07-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et Chopper risquent leur vie pour aider une petite fille au cœur brisé à retrouver son animal de compagnie.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362235.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":317,\"absoluteNumber\":317,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:25:47\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362236,\"seriesId\":81797,\"name\":\"Une mama qui a de la poigne ! Zoro la nounou se met en quatre !\",\"aired\":\"2007-07-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La journée de Zoro prend un tour loufoque quand sa recherche d'une nouvelle épée est détournée par deux orphelins attachants.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362236.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":318,\"absoluteNumber\":318,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:26:04\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362237,\"seriesId\":81797,\"name\":\"Sanji estomaqué ! Le grand père mystérieux et sa cuisine succulente !\",\"aired\":\"2007-07-22\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Sanji passe la journée avec un très vieux chef qui lui apprend le secret qui donne une saveur incroyable à chaque plat.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362237.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":319,\"absoluteNumber\":319,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:26:24\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362238,\"seriesId\":81797,\"name\":\"Tout le monde est enfin mis à prix ! L’équipage qui dépasse les 600 millions !\",\"aired\":\"2007-08-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Franky et Icebarg restent debout toute la nuit avec pour mission de finir un bateau neuf pour les chapeaux de paille, mais les premières lueurs du jour apportent des mauvaises nouvelles.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362238.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":320,\"absoluteNumber\":320,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:26:46\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362239,\"seriesId\":81797,\"name\":\"Le roi des animaux fait face à la mer ! Un navire de rêve enfin terminé !\",\"aired\":\"2007-08-26\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Avec l'achèvement de leur nouveau bateau, Luffy et sa bande sont prêts à prendre la mer, mais ils doivent d'abord voler un certain sous-vêtement pour s'assurer les services d'un charpentier.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362239.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":321,\"absoluteNumber\":321,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:27:11\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362240,\"seriesId\":81797,\"name\":\"Adieu mes chers compagnons ! Le départ de Franky !\",\"aired\":\"2007-09-02\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Une série de flashs-back de sa jeunesse, et un peu de persuasion douloureuse de la part de Robin, aident Franky à prendre la difficile décision de quitter ses amis et de prendre la mer avec les chapeaux de paille.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362240.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":322,\"absoluteNumber\":322,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:27:31\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362241,\"seriesId\":81797,\"name\":\"Départ de la métropole aquatique ! Usopp termine son duel comme un homme !\",\"aired\":\"2007-09-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et les chapeaux de paille sont prêts pour leur prochaine aventure, mais avant qu'ils ne puissent se mettre en route, ils doivent attendre le retour d'Usopp et éviter le pilonnage par des boulets de canon de la part de Garp.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362241.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":323,\"absoluteNumber\":323,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:27:50\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362242,\"seriesId\":81797,\"name\":\"Les avis de recherche circulent. Les connaissances dansent, le navire avance.\",\"aired\":\"2007-09-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le bateau des chapeaux de paille est baptisé, et Franky démontre quelques-unes de ses fonctionnalités spéciales en faisant s'envoler la bande vers les cieux pour éviter qu'elle soit coulée par les marines.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362242.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":324,\"absoluteNumber\":324,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:28:15\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362243,\"seriesId\":81797,\"name\":\"Un pouvoir malfaisant. Les ténèbres de Barbe Noire attaquent Ace !\",\"aired\":\"2007-09-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Trois jours plus tôt et sur une île proche de Water 7, Barbe Noire reçoit la nouvelle de la dévastation d'Enies Lobby par les Chapeaux de Paille et décide de les poursuivre. Cependant, ses plans sont interrompus par Ace, venu venger le meurtre d'un coéquipier par Barbe Noire.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362243.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":325,\"absoluteNumber\":325,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-11 00:37:14\",\"finaleType\":\"season\",\"year\":\"2007\"},{\"id\":362244,\"seriesId\":81797,\"name\":\"Un mystérieux équipage ! Sunny et le piège dangereux.\",\"aired\":\"2007-10-14\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après avoir quitté Water 7, les Chapeaux de Paille trouvent un navire à la dérive avec des pêcheurs affamés et malades. Tout semble bien jusqu'à ce que les pêcheurs à la dérive aient autre chose en tête et tendent un piège aux Chapeaux de Paille.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362244.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":326,\"absoluteNumber\":326,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:32:55\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362245,\"seriesId\":81797,\"name\":\"Le Sunny en danger ! Rugis, mystérieux système supersonique.\",\"aired\":\"2007-10-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les Chapeaux de Paille se retrouvent entourés d'une flotte de navires Marine, en réalité des illusions.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362245.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":327,\"absoluteNumber\":327,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:33:05\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362246,\"seriesId\":81797,\"name\":\"Un rêve englouti par le nouveau monde ! Puzzle, un pirate désespéré.\",\"aired\":\"2007-10-28\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Piégés par des icebergs en mouvement, les Chapeaux de Paille tentent de trouver un moyen de s'en sortir en évitant de nombreux dangers alors que les assassins se rapprochent.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362246.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":328,\"absoluteNumber\":328,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:33:19\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362247,\"seriesId\":81797,\"name\":\"Les assassins attaquent ! Début d'une grande bataille sur la glace.\",\"aired\":\"2007-11-04\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"En utilisant le sous-marin Shark, Nami et Franky découvrent que des pingouins déplacent les icebergs.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362247.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":329,\"absoluteNumber\":329,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:33:44\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362248,\"seriesId\":81797,\"name\":\"L'équipage au chapeau de paille a du mal ! L'esprit de la piraterie mise tout sur un drapeau.\",\"aired\":\"2007-11-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les combats continuent. Luffy, distrait à cause du drapeau perdu, a des problèmes initiaux avec Blindo, mais les Pirates de Phoenix l'aident à le capturer. Usopp a un succès marginal contre Albelle, mais est gêné par Sarco en colère.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362248.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":330,\"absoluteNumber\":330,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:33:57\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362249,\"seriesId\":81797,\"name\":\"Tout le monde est chaud bouillant ! Le Pouvoir magnétique des jumeaux.\",\"aired\":\"2007-11-18\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"En raison de nouvelles erreurs de Sanji, lui et Usopp se retrouvent capturés par Sarco et Albelle. Pendant ce temps, Canpacino arrive sur le navire des Phoenix Pirates pour sauver son frère.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362249.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":331,\"absoluteNumber\":331,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:34:07\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362250,\"seriesId\":81797,\"name\":\"Une résidence plongée dans le chaos ! Don se fâche et l'équipage est prisonnier.\",\"aired\":\"2007-11-25\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le Don révèle le pouvoir du Heat Heat Fruit : le pouvoir de faire fondre n'importe quelle substance. Zoro n'est pas à la hauteur de sa colère et finit emprisonné dans une caverne de glace avec les autres Chapeaux de Paille capturés.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362250.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":332,\"absoluteNumber\":332,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:34:21\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362251,\"seriesId\":81797,\"name\":\"Le phénix ressuscite ! Le rêve du drapeau pirate, une promesse faite à un ami.\",\"aired\":\"2007-12-02\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'Équipage du Chapeau de Paille, venant juste de se sortir de la prison où ils étaient enfermés, arrive finalement à s'échapper grâce à Zoro. Cependant, ils tombent à nouveau sur les membres de la Famille Accino.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362251.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":333,\"absoluteNumber\":333,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:34:31\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362252,\"seriesId\":81797,\"name\":\"Affrontement chaud bouillant ! Luffy contre Don l'incandescent.\",\"aired\":\"2007-12-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'Équipage du Chapeau de Paille rend furieux le patriarche Don Accino en vainquant les membres de sa famille. Un intense combat entre Luffy et ce dernier débute.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362252.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":334,\"absoluteNumber\":334,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:35:04\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362253,\"seriesId\":81797,\"name\":\"Je t'attendrai dans le Nouveau Monde ! Adieu aux valeureux pirates !\",\"aired\":\"2007-12-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après une lutte épuisante, Luffy bat enfin Don Accino.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362253.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":335,\"absoluteNumber\":335,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:35:18\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362254,\"seriesId\":81797,\"name\":\"Chopperman entre en action ! Il faut protéger la chaîne de télévision au bord de la plage.\",\"aired\":\"2007-12-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Chopperman et Namifia sont à court d'argent ! Le Dr Usodabada élabore un plan pour faire tomber Chopperman tout en acquérant une renommée pour lui-même et un nouvel équipage pour remplacer son duo inutile : Sanjilops et Zorogilla.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362254.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":336,\"absoluteNumber\":336,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:35:33\",\"finaleType\":null,\"year\":\"2007\"},{\"id\":362255,\"seriesId\":81797,\"name\":\"Entrée sur la mer du diable ! Le mystérieux squelette flottant dans la brume.\",\"aired\":\"2008-01-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'Équipage du Chapeau de Paille découvre un baril au milieu de l'océan.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362255.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":337,\"absoluteNumber\":337,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:35:46\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":362256,\"seriesId\":81797,\"name\":\"Le plaisir de rencontrer des gens ! La vraie nature du squelette gentleman\",\"aired\":\"2008-01-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"À bord du Thousand Sunny, Brook raconte son histoire de musicien avant d'être tué. Cependant, son esprit a pu réanimer son squelette grâce au pouvoir du Revive Revive Fruit.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362256.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":338,\"absoluteNumber\":338,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:35:58\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":362257,\"seriesId\":81797,\"name\":\"Mystérieux phénomènes donnant le frisson ! Débarquement à Thriller Bark\",\"aired\":\"2008-01-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Brook fait ses adieux aux Chapeaux de Paille et saute par-dessus bord, révélant qu'il peut traverser la surface de l'océan. Nami, Usopp et Chopper partent explorer l'île à l'aide du Mini-Merry II et rencontrent un cerbère.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362257.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":339,\"absoluteNumber\":339,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:36:08\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":362258,\"seriesId\":81797,\"name\":\"L'homme qu'on appelle génie ! Hogback entre en scène !\",\"aired\":\"2008-01-27\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Usopp, Nami et Chopper traversent la forêt de Thriller Bark, où ils sont attaqués par un peloton de zombies avant d'atteindre finalement le manoir de l'étrange chirurgien Docteur Hogback et de son assistante Victoria Cindry.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362258.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":340,\"absoluteNumber\":340,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:36:20\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":362259,\"seriesId\":81797,\"name\":\"Nami en danger ! Le manoir zombie et l'homme invisible\",\"aired\":\"2008-02-03\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après la rencontre avec Hogback, Nami est agressée par une créature invisible sous la douche, mais Usopp et Chopper parviennent à la chasser. Le reste des Chapeaux de Paille mettent le pied sur l'île et rencontrent d'autres zombies.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362259.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":341,\"absoluteNumber\":341,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:36:31\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":362260,\"seriesId\":81797,\"name\":\"Le mystère des zombies ! Le laboratoire cauchemardesque de Hogback\",\"aired\":\"2008-02-10\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Échappant aux zombies surprise du manoir, Nami, Chopper et Usopp découvrent la vérité sur la véritable identité de Victoria Cindry et les expériences du docteur Hogback avant d'être approchés par un mystérieux zombie samouraï avec la voix de Brook.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362260.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":342,\"absoluteNumber\":342,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:36:53\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":362261,\"seriesId\":81797,\"name\":\"Son nom est Moria ! Le piège du grand pirate voleur d'ombres\",\"aired\":\"2008-02-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après avoir vaincu les zombies, les Chapeaux de Paille apprennent que l'un des Shichibukai, Gecko Moria, vole les ombres des gens et les utilise pour faire revivre les zombies.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362261.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":343,\"absoluteNumber\":343,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:37:14\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":362262,\"seriesId\":81797,\"name\":\"La joie du chant des zombies ! La cloche de l'attaque de nuit est une musique des ténèbres\",\"aired\":\"2008-02-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Usopp, Nami et Chopper sont neutralisés sans effort par le général Zombie Ryuuma, un samouraï ressemblant étrangement à Brook, et sont enfermés dans un cercueil. Luffy et les autres entrent dans le manoir et battent facilement les zombies surprises.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362262.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":344,\"absoluteNumber\":344,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:37:25\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":362263,\"seriesId\":81797,\"name\":\"Rempli d'animaux !? Le merveilleux jardin de Perona\",\"aired\":\"2008-03-02\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy, Zoro, Robin et Franky s'avancent pour tenter de retrouver et de sauver leur nakama disparu. Pendant ce temps, Nami, Chopper et Usopp sont transportés vers la partie principale du manoir, mais sont accidentellement détournés et se retrouvent dans le jardin des merveilles de Perona !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362263.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":345,\"absoluteNumber\":345,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:37:38\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":362264,\"seriesId\":81797,\"name\":\"L'équipage du chapeau de paille disparait ! Le mystérieux sabreur apparaît !\",\"aired\":\"2008-03-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Alors que Luffy, Franky et Robin font face à une pièce fermée remplie de puissants zombies blindés, Nami, Chopper et Usopp sont protégés par le chien-zombie Inuppe, dont le comportement ressemble à celui de Sanji !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362264.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":346,\"absoluteNumber\":346,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:37:54\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":362265,\"seriesId\":81797,\"name\":\"L'esprit chevaleresque reste ! Le zombie traître qui protège Nami\",\"aired\":\"2008-03-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Une fois Luffy capturé, Franky et Robin affrontent les zombies en armure et le général zombie Talaran ! Ailleurs, Lola attaque Nami par jalousie.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362265.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":347,\"absoluteNumber\":347,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:38:41\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":362266,\"seriesId\":81797,\"name\":\"Une visite venue du ciel ! Cet homme est l'épéiste fredonneur !\",\"aired\":\"2008-03-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Robin, Franky et Brook affrontent le général zombie Talaran, tandis que Nami, Usopp et Chopper se défendent contre Lola. Ailleurs, Luffy rencontre Moria !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362266.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":348,\"absoluteNumber\":348,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:39:07\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":362267,\"seriesId\":81797,\"name\":\"Luffy en état d'urgence ! La destination de l'ombre la plus forte !\",\"aired\":\"2008-03-30\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après avoir achevé le général Talaran, Brook révèle les mystères derrière Thriller Bark. Ailleurs, Moria rassemble les Trois Mystérieux et tente de capturer l'ombre de Luffy.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/362267.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":349,\"absoluteNumber\":349,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:39:31\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":368950,\"seriesId\":81797,\"name\":\"Le guerrier appelé démon !! L'heure de la résurrection d'Oz\",\"aired\":\"2008-04-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Moria et les autres commencent la réanimation du numéro 900 Oz. Pendant ce temps, Franky et Robin en apprennent davantage sur le passé de Brook et sur leur future mission.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/368950.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":350,\"absoluteNumber\":350,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:39:51\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":368951,\"seriesId\":81797,\"name\":\"Réveillé après 500 ans !! Oz ouvre les yeux !!\",\"aired\":\"2008-04-27\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Alors qu'Oz se réveille, Nami, Usopp et Chopper sont découverts ! Pourront-ils fuir à temps, ou Absalom les capturera-t-il en premier ?\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/368951.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":351,\"absoluteNumber\":351,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:40:20\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":369009,\"seriesId\":81797,\"name\":\"Parier sa vie sur ses convictions !! Brook protège sa coupe afro\",\"aired\":\"2008-05-04\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après qu'Oz ait mangé à sa faim, obéira-t-il à Moria ? Ailleurs, alors que Brook se prépare à combattre Ryuuma une seconde fois, il se souvient de sa première rencontre avec lui cinq ans plus tôt.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/369009.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":352,\"absoluteNumber\":352,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:40:37\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":369010,\"seriesId\":81797,\"name\":\"Le serment d'un homme ne meurt jamais !! Pour ami qui attend dans un ciel lointain !\",\"aired\":\"2008-05-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Usopp et les autres retournent au Sunny à la recherche de Luffy, Zoro et Sanji. A leur arrivée, ils découvrent le trio inconscient. Après les avoir réveillés, Usopp et Franky partagent chacun ce qu'ils ont découvert. Mais Franky a une histoire choquante sur la promesse de Brook à son nakama. Pendant ce temps, le mariage de Nami avec Absalom approche.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/369010.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":353,\"absoluteNumber\":353,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:40:48\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":369758,\"seriesId\":81797,\"name\":\"On se reverra sûrement !! Brook et le cap de la promesse !\",\"aired\":\"2008-05-18\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après avoir appris que le nakama de Brook est Laboon la baleine, Luffy est déterminé à le recruter. Avant de se préparer à éliminer Thriller Bark et à retrouver leurs ombres, Sanji raconte à Chopper, Robin et Franky l'histoire de Laboon et des Twin Capes.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/369758.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":354,\"absoluteNumber\":354,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:40:59\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":369759,\"seriesId\":81797,\"name\":\"La nourriture, Nami et les ombres !! La grande contre-attaque de Luffy en colère\",\"aired\":\"2008-05-25\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Avec leurs objectifs en tête, Luffy, Sanji, Robin, Usopp et Chopper s'en prennent à Nami et Moria ! Pendant ce temps, Franky et Zoro se dirigent vers Brook. Cependant, Hildon parle aux autres du plan du Chapeau de Paille.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/369759.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":355,\"absoluteNumber\":355,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:41:13\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":383787,\"seriesId\":81797,\"name\":\"Usopp le plus fort ? Laissez-moi les négatifs !\",\"aired\":\"2008-06-01\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy continue d'affronter Moria tandis que Chopper et Robin restent sur place pour affronter Hogback et ses fidèles serviteurs zombies.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/383787.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":356,\"absoluteNumber\":356,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:41:24\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":383788,\"seriesId\":81797,\"name\":\"La mort soudaine des Généraux Zombies !! Oz a envie d'aventure !!\",\"aired\":\"2008-06-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Usopp continue de tenir tête aux Negative Hollows de Perona tout en éliminant les zombies sauvages, tandis que Brook est tenu à la merci de Ryuma, qui prouve enfin sa supériorité sur l'original en battant le squelette au combat avant l'arrivée de Zoro.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/383788.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":357,\"absoluteNumber\":357,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:41:42\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":383790,\"seriesId\":81797,\"name\":\"Sanji le chevalier de feu !! Défoncer à coups de pied le faux mariage\",\"aired\":\"2008-06-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy tente d'attaquer Gecko Moria, mais est obligé d'affronter son Ombre le Doppelman.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/383790.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":358,\"absoluteNumber\":358,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:42:18\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":383791,\"seriesId\":81797,\"name\":\"Le lien de l'invisibilité ? Le rêve de Sanji est volé !\",\"aired\":\"2008-06-22\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Sanji semble vaincu alors qu'Absalom utilise sa capacité de fruit du démon, mais Sanji revient avec sa colère et commence à battre Absalom à mort, après lui avoir révélé qu'il avait toujours désiré le fruit transparent, le fruit du démon qui a permis à Absalom de se rendre invisible.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/383791.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":359,\"absoluteNumber\":359,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:42:37\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":383792,\"seriesId\":81797,\"name\":\"Le héros sauveur !? L'ennemi est la princesse invincible\",\"aired\":\"2008-06-29\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Usopp est obligé de combattre le pouvoir Horo-Horo de Perona.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/383792.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":360,\"absoluteNumber\":360,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:42:49\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":383793,\"seriesId\":81797,\"name\":\"La terreur de Perona ? Le U de uso (mensonge) est le U de Usopp !\",\"aired\":\"2008-07-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La bataille entre Usopp et Perona continue ; Usopp tire quelque chose sur le vrai corps de Perona qui semble le manquer, donnant à Perona la confiance nécessaire pour riposter à nouveau.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/383793.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":361,\"absoluteNumber\":361,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:43:09\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":383934,\"seriesId\":81797,\"name\":\"L'attaque tranchante qui danse sur le toit !! La conclusion de Zoro contre Ryuma\",\"aired\":\"2008-07-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro affronte Ryuma dans le laboratoire de Hogback, tandis que Franky garde Brook blessé. Ni Zoro, ni Ryuma, ne peuvent obtenir l'avantage sur l'autre.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/383934.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":362,\"absoluteNumber\":362,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:43:44\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":383794,\"seriesId\":81797,\"name\":\"Chopper est en colère !! La médecine démoniaque de Hogback\",\"aired\":\"2008-07-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Chopper et Robin sont surpassés par les zombies de Zoro et Sanji, qui ont tous deux presque complètement perdu la personnalité qu'ils ont acquise dans leur ombre. Chopper dit à Hogback qu'il l'avait respecté autrefois, mais ne le respecte plus après avoir réalisé la vraie nature des expériences de Hogback.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/383794.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":363,\"absoluteNumber\":363,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:44:32\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":383795,\"seriesId\":81797,\"name\":\"Oz hurle !! Montre-toi, équipage du chapeau de paille\",\"aired\":\"2008-08-03\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Oz apparaît déclarant sa soumission à Moria. Moria lui demande de traquer les pirates au chapeau de paille.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/383795.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":364,\"absoluteNumber\":364,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:44:44\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":383930,\"seriesId\":81797,\"name\":\"L'ennemi est Luffy !! Le plus puissant zombie contre l'équipage du chapeau de paille\",\"aired\":\"2008-08-10\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Oz commence à combattre Sanji, Zoro, Franky, Brook, Robin, Usopp et Chopper, ayant hérité du style de combat de Luffy mais ayant perdu la mémoire. L'équipage essaie de se battre contre lui, mais apprend qu'il est incroyablement fort et rapide, même s'il est incapable de s'étirer comme le peut Luffy.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/383930.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":365,\"absoluteNumber\":365,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:44:56\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":383931,\"seriesId\":81797,\"name\":\"Absalom est battu !! L'attaque électrique de l'amitié de Nami !!\",\"aired\":\"2008-08-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Perona se réveille enfin et est mise au courant de l'actualité de Thriller Bark. Elle décide de s'enfuir. Nami se réveille également pour voir qu'elle participe à une cérémonie de mariage avec Absalom. Lola interrompt le mariage, donnant à Nami une chance de s'échapper.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/383931.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":366,\"absoluteNumber\":366,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:45:08\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":383932,\"seriesId\":81797,\"name\":\"Volons-lui une victoire !! Le mortel amarrage des Chapeau de Paille ?\",\"aired\":\"2008-08-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les Chapeaux de Paille tentent une manœuvre « d'amarrage » en s'accrochant à Franky afin de former un « Robot Guerrier Géant », mais celle-ci échoue lorsque Robin refuse de participer, car elle juge cela trop embarrassant.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/383932.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":367,\"absoluteNumber\":367,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:45:24\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":383933,\"seriesId\":81797,\"name\":\"Une invasion sans bruit de pas !! Le mystérieux visiteur • Kuma le tyran\",\"aired\":\"2008-08-31\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Profitant de plusieurs faiblesses, dont sa stupidité et ses similitudes avec Luffy, les Chapeaux de Paille continuent de combattre Oz.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/383933.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":368,\"absoluteNumber\":368,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:45:36\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":414181,\"seriesId\":81797,\"name\":\"Oz + Moria La plus terrible fusion de la force et de l'intelligence\",\"aired\":\"2008-09-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'ombre de Moria s'échappe, laissant Luffy bloqué dans la forêt, alors que d'étranges personnes révèlent qu'elles le recherchent. Zoro continue le combat contre Oz.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/414181.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":369,\"absoluteNumber\":369,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:45:53\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":414182,\"seriesId\":81797,\"name\":\"La stratégie secrète du retournement de situation - Nightmare Luffy apparaît\",\"aired\":\"2008-09-14\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Avec les conseils de Moria, Oz est mieux à même de contrer les stratégies des Chapeaux de Paille et de retourner leurs attaques contre eux.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/414182.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":370,\"absoluteNumber\":370,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:46:07\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":414183,\"seriesId\":81797,\"name\":\"Dévastation de l'équipage de chapeau de paille - Les capacités du fruit Kage Kage à pleins gaz\",\"aired\":\"2008-09-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Moria explique qu'il a permis à Oz de s'étirer en étirant son ombre, forçant ainsi son corps à s'étirer avec elle afin de s'assurer que le corps et l'ombre ait la même forme.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/414183.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":371,\"absoluteNumber\":371,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:46:18\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":414184,\"seriesId\":81797,\"name\":\"Le combat pour déterminer le meilleur commence ! Luffy vs Luffy\",\"aired\":\"2008-09-28\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro essaie à nouveau d'attaquer le bras d'Oz, mais celui-ci l'assomme en le mettant à genoux contre un mur. Usopp tire du sel dans la bouche d'Oz.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/414184.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":372,\"absoluteNumber\":372,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:46:50\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":414185,\"seriesId\":81797,\"name\":\"La conclusion approche ! Donner le coup final\",\"aired\":\"2008-10-05\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Oz se remet de l'attaque de Nightmare Luffy. Cependant, les Mugiwara se remettent tous sur pied, de Luffy à Brook, et lancent une dernière attaque dévastatrice sur Oz.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/414185.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":373,\"absoluteNumber\":373,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:47:02\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":414186,\"seriesId\":81797,\"name\":\"Les corps disparaissent ! Le soleil perce à travers l'île du cauchemar !\",\"aired\":\"2008-10-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy commence à combattre Moria, malgré le Gear Second les coups qu'il inflige à Moria ne suffisent pas à le forcer à libérer les ombres. Moria attaque Luffy avec un coup dévastateur.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/414186.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":374,\"absoluteNumber\":374,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:47:14\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":414187,\"seriesId\":81797,\"name\":\"L'interminable crise ! L'ordre d'anéantir l'équipage du Chapeau de Paille\",\"aired\":\"2008-10-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Toutes les victimes de la Moria récupèrent leur ombre et célèbrent avec joie leur capacité à entrer dans la lumière du jour. Luffy, Zoro, Sanji et Robin récupèrent leurs ombres à temps pour éviter d'être désintégrés.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/414187.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":375,\"absoluteNumber\":375,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:47:32\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":414188,\"seriesId\":81797,\"name\":\"Le pouvoir Nikyu Nikyu de Kuma de tout repousser\",\"aired\":\"2008-11-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro attaque Kuma, qui révèle qu'il a mangé le fruit Paw-pad Paw-pad, et montre sa capacité à repousser les attaques, à parcourir des distances considérables presque instantanément et à repousser l'air pour attaquer ses adversaires.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/414188.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":376,\"absoluteNumber\":376,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:47:46\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":414189,\"seriesId\":81797,\"name\":\"La douleur de mes amis est ma douleur - Le combat suicidaire de Zoro\",\"aired\":\"2008-11-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Alors que presque tout le monde sur l'île est assommé par l'explosion, Zoro frappe Kuma avec Shishi Sonson, mais voit que c'est inefficace, car Kuma est un Pacifista, un cyborg dont le corps est plus dur que l'acier. Voyant qu'il ne peut plus se battre, Zoro offre sa vie pour sauver Luffy, affirmant qu'il ne peut espérer devenir le meilleur épéiste du monde s'il ne peut pas protéger son capitaine.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/414189.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":377,\"absoluteNumber\":377,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:48:35\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":414190,\"seriesId\":81797,\"name\":\"La promesse faite un jour lointain - La chanson des pirates et la petite baleine\",\"aired\":\"2008-11-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Hogback et Absalom échappent de Thriller Bark avec Moria inconscient et révèlent que Barbe Noire a acquis son statut de Shichibukai en battant Ace. Le lendemain, les Chapeaux de Paille célèbrent leur victoire sur la Moria, mais ne savent pas pourquoi Zoro est si grièvement blessé.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/414190.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":378,\"absoluteNumber\":378,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:48:48\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":414191,\"seriesId\":81797,\"name\":\"Le passé de Brook - Les tristes adieux au joyeux compagnons\",\"aired\":\"2008-11-30\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Brook se souvient de son passé, lorsque la baleine Laboon a commencé à suivre son bateau pirate et s'est liée d'amitié avec l'équipage. Lorsque l'équipage s'est dirigé vers Grand Line, ils n'ont eu d'autre choix que de laisser Laboon derrière eux en raison du danger que la mer présenterait pour un jeune baleine comme lui, mais Laboon les a quand même suivis au-dessus de Reverse Mountain. Brook et son capitaine convainquent Laboon de rester derrière, promettant qu'après avoir parcouru toute la Grand Line et qu'il soit devenu assez fort pour les suivre, ils reviendraient et l'emmèneraient dans leurs aventures. Mais ils n’ont pas pu tenir leur promesse.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/414191.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":379,\"absoluteNumber\":379,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:49:34\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":414192,\"seriesId\":81797,\"name\":\"Le saké de Binks - La chanson qui relie le passé et le présent\",\"aired\":\"2008-12-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Brook se souvient du voyage des Pirates Rumbar à travers Grand Line, où ils ont fait face à de nombreux dangers mais ont quand même réussi à s'amuser. Le capitaine a contracté une maladie et a tenté de quitter Grand Line par la Calm Belt avec l'autre équipage infecté, laissant Brook responsable des pirates restants.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/414192.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":380,\"absoluteNumber\":380,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:49:46\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":414193,\"seriesId\":81797,\"name\":\"Un nouveau compagnon ! Brook le musicien\",\"aired\":\"2008-12-14\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Brook dit à Luffy qu'il est heureux d'être en vie et lui demande s'il peut rejoindre l'équipage, ce que Luffy approuve. Tous les Chapeaux de Paille en sont choqués, à l'exception de Zoro, qui dort, et de Robin, qui savait que Luffy l'accepterait quoi qu'il arrive, mais ils l'accueillent néanmoins dans l'équipage.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/414193.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":381,\"absoluteNumber\":381,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:50:00\",\"finaleType\":\"season\",\"year\":\"2008\"},{\"id\":414194,\"seriesId\":81797,\"name\":\"La menace du Noro Noro - Le retour de Foxy le renard argenté\",\"aired\":\"2008-12-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les chapeaux de paille prennent des vacances à Spa Island, mais pendant qu'ils y sont, ils rencontrent Foxy et son équipage, qui poursuivent deux petites filles : Lina et sa sœur aînée Sayo. Les chapeaux de paille parviennent à vaincre les Foxy Pirates et apprennent qu'ils poursuivaient Lina et Sayo pour le cahier des filles, qui montre les recherches de leur père sur la façon de créer un joyau spécial, dont la solution peut être trouvée sur l'île. Lina considère son père comme un menteur, mais Sayo le croit. Soudain, Sayo est enlevée et le propriétaire de l'île, Doran, dit que s'ils veulent la récupérer, ils doivent terminer les recherches et trouver la gemme.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/414194.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":382,\"absoluteNumber\":382,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:50:16\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":418356,\"seriesId\":81797,\"name\":\"Grande compétition de trésor ! Effondrements ! Spa Island !\",\"aired\":\"2008-12-28\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après que Lina révèle qu'elle a fouillé partout dans le navire, Luffy décide de détruire le navire afin de retrouver Sayo.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/418356.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":383,\"absoluteNumber\":383,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-08 22:50:32\",\"finaleType\":null,\"year\":\"2008\"},{\"id\":422286,\"seriesId\":81797,\"name\":\"La dure lutte de Brook. Une voie difficile pour devenir un véritable membre de l'équipage ?\",\"aired\":\"2009-01-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après avoir lu un récit des différentes aventures des Chapeaux de Paille, Brook décide d'être aussi utile que possible pour prouver sa valeur, mais ses efforts bien intentionnés ne parviennent qu'à ennuyer ou à gêner les autres.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/422286.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":384,\"absoluteNumber\":384,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:39:31\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":422287,\"seriesId\":81797,\"name\":\"Arrivé à la moitié de Grand Line ! Red Line !\",\"aired\":\"2009-01-18\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après avoir traversé les dangereux courants du Serpent, les Chapeaux de Paille arrivent enfin à Red Line, ce qui signifie qu'ils ont parcouru la moitié du tour du monde et que leur voyage est à moitié terminé.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/422287.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":385,\"absoluteNumber\":385,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:39:48\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":422288,\"seriesId\":81797,\"name\":\"La haine envers l'équipage du Chapeau de Paille ! Apparition de Duval au Masque de Fer\",\"aired\":\"2009-01-25\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La sirène et l'étoile de mer, nommées respectivement Keimi et Paggag, remercient les chapeaux de paille de les avoir aidés, et Keimi propose de leur donner du Takoyaki (poulpe frit), après avoir rencontré son amie Hacchin en guise de remerciement.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/422288.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":386,\"absoluteNumber\":386,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:40:00\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":422289,\"seriesId\":81797,\"name\":\"Fatidiques retrouvailles ! Sauver l'homme-poisson des mains de l'ennemi\",\"aired\":\"2009-02-01\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Duval en veut à l'un des Chapeaux de Paille, mais on ne sait pas lequel. Lorsque les Chapeaux de Paille atteignent la cachette, ils découvrent que Hacchin n'est autre que la pieuvre Fishman Hatchan, anciennement membre de l'équipage d'Arlong.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/422289.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":387,\"absoluteNumber\":387,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:40:10\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":422290,\"seriesId\":81797,\"name\":\"Tragédie ! La vérité de Duval couverte par un masque\",\"aired\":\"2009-02-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Alors que la bataille entre les Chapeaux de Paille et les Flying Fish Riders fait rage, Zoro libère Hatchan de sa cage et l'Homme-Poisson le sauve à son tour d'une attaque, révélant qu'il se sent mal à propos de leur bataille à Arlong Park.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/422290.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":388,\"absoluteNumber\":388,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:40:23\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":434584,\"seriesId\":81797,\"name\":\"Explosion ! La super arme secrète du Sunny : le canon Gaon\",\"aired\":\"2009-02-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après la révélation surprenante, Duval raconte son histoire de vie paisible de mafieux jusqu'à ce que les Marines et les chasseurs de primes le poursuivent pour la prime de Sanji, le prenant pour le Chapeau de Paille, le poussant à fuir et à porter un casque pour cacher son visage.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/434584.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":389,\"absoluteNumber\":389,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:40:36\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":434585,\"seriesId\":81797,\"name\":\"Débarquement pour aller sur l'île des Homme-Poissons. L'archipel Sabaody\",\"aired\":\"2009-02-22\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les Chapeaux de Paille se reposent pendant que Hatchan leur offre le Takoyaki promis. Duval réapparaît, non pas pour se venger, mais pour remercier Sanji puisque ses coups de pied ont modifié le visage de Duval pour qu'il devienne beau et suave, du moins c'est ce qu'il pense.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/434585.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":390,\"absoluteNumber\":390,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:40:49\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":434587,\"seriesId\":81797,\"name\":\"Tyrannie ! Les dirigeants de Sabaody, les Tenryūbito\",\"aired\":\"2009-03-01\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'équipage se sépare afin d'explorer l'archipel. Hatchan, Keimi et Paggag conduisent Luffy, Chopper et Brook à trouver le mécanicien dont Hatchan a parlé. En ville, ils sont témoins d'une perturbation provoquée par un homme prétendant être un esclave en fuite criant à l'aide pour enlever un collier de fer.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/434587.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":391,\"absoluteNumber\":391,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:41:02\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":434588,\"seriesId\":81797,\"name\":\"Rassemblement de nouveaux rivaux ! Les 11 Supernovas\",\"aired\":\"2009-03-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après s'être frayé un chemin contre les chasseurs de primes, le groupe de Luffy arrive dans un bar appartenant à une femme nommée Shakuyaku, une vieille amie de Hatchan. Le mécanicien, Rayleigh, n'est pas là, alors Shakky suggère qu'ils partent à sa recherche au parc d'attractions.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/434588.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":392,\"absoluteNumber\":392,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:41:15\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":492361,\"seriesId\":81797,\"name\":\"La cible est Camie ! Les kidnappeurs en approche\",\"aired\":\"2009-03-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"En se promenant dans les bosquets, Zoro rencontre un autre dragon céleste, Saint Charlos, qui harcèle un groupe de citadins. Une bagarre éclate presque, mais Jewelry Bonney intervient et fait croire à Charlos qu'il l'a tué, après quoi elle le réprimande avec colère pour avoir déclenché une bagarre et avoir presque fait envoyer un amiral dans l'archipel.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/492361.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":393,\"absoluteNumber\":393,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:41:26\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":492371,\"seriesId\":81797,\"name\":\"Sauver Camie ! La sombre histoire de l'Archipel\",\"aired\":\"2009-03-29\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Duval et son équipage arrivent sur l'archipel et commencent à rassembler les chapeaux de paille pour les amener à la maison des ventes aux enchères humaines, où les ravisseurs ont amené Keimi. Robin explique à Nami pourquoi les hommes-poissons et les hommes-mers ne sont pas les bienvenus sur l'île car dans le passé, ils avaient été victimes de discrimination et classés comme de simples poissons.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/492371.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":394,\"absoluteNumber\":394,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:41:43\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":492381,\"seriesId\":81797,\"name\":\"Le temps est limité - La vente aux enchères d'humain commence\",\"aired\":\"2009-04-05\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La vente aux enchères humaine commence enfin, et ce n'est qu'à ce moment-là que les Chapeaux de Paille découvrent que leur amie sirène est en train d'être vendue à Grove 1. Après s'y être retrouvés (à l'exception de Zoro, Luffy, Brook et Robin), leur plan initial pour extraire Keimi est contrarié en apprenant que le gouvernement mondial et les dragons célestes sont impliqués dans le commerce des esclaves.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/492381.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":395,\"absoluteNumber\":395,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:42:04\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":511991,\"seriesId\":81797,\"name\":\"Le poing dévastateur ! Détruire la vente aux enchères\",\"aired\":\"2009-04-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La vente aux enchères se poursuit, mais Saint Charloss arrive et ruine le plan des Chapeaux de Paille de racheter Keimi en plaçant une offre exorbiante sur elle. Les débats sont ensuite interrompus lorsque Luffy et son poisson volant s'écrasent dans la maison de vente aux enchères.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/511991.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":396,\"absoluteNumber\":396,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:42:49\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":512001,\"seriesId\":81797,\"name\":\"Énorme panique ! Lutte dans la salle des enchères\",\"aired\":\"2009-04-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après le coup de poing de Luffy, une bagarre éclate dans la salle des ventes entre le personnel, les gardes du corps des Dragons Célestes et les Chapeaux de Paille, aidés par l'arrivée d'Usopp, Brook et Robin.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/512001.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":397,\"absoluteNumber\":397,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:43:14\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":512011,\"seriesId\":81797,\"name\":\"L'amiral Kizaru se déplace ! L'archipel Sabaody dans le chaos\",\"aired\":\"2009-04-26\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La nouvelle de l'attaque du tenryubito parvient aux pirates de la ville, ainsi qu'au quartier général de la Marine, où Kizaru décide de se rendre sur l'île pour faire face à la situation. Don Quichotte Doflamingo, propriétaire de la maison de vente aux enchères, dit à Disco que les Sept Seigneurs de Guerre seront appelés à faire la guerre contre les Pirates de Barbe Blanche.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/512011.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":398,\"absoluteNumber\":398,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:44:13\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":512021,\"seriesId\":81797,\"name\":\"Franchir l'encerclement ! Marine contre trois capitaines\",\"aired\":\"2009-05-03\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les équipages de Luffy, Law et Kid se joignent au combat, battent le reste des marines à l'extérieur de la maison de vente aux enchères, promettant de se rencontrer et de se battre dans le Nouveau Monde.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/512021.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":399,\"absoluteNumber\":399,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:44:39\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":512031,\"seriesId\":81797,\"name\":\"Roger et Rayleigh - Le roi des pirates et son bras droit\",\"aired\":\"2009-05-10\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"À son retour au Shakky's Bar, Rayleigh révèle aux Chapeaux de Paille qu'il était le second du légendaire Gold Roger et la vérité sur la fin de son équipage.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/512031.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":400,\"absoluteNumber\":400,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:45:14\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":634691,\"seriesId\":81797,\"name\":\"Impossible à éviter ? Le kick à la vitesse de la lumière de l'Amiral Kizaru\",\"aired\":\"2009-05-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"L'amiral Kizaru apparaît dans l'archipel et démontre ses mystérieuses capacités de lumière avant d'affronter le Supernova Basil Hawkins, tandis qu'Urouge et Drake combattent un Pacifista. Kidd et Law continuent leur combat avec un autre Pacifista tandis que les Pirates du Chapeau de Paille se retrouvent face à face avec un troisième.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/634691.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":401,\"absoluteNumber\":401,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:45:25\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":634701,\"seriesId\":81797,\"name\":\"Incroyable ! Pacifista, l'arme de combat de la Marine\",\"aired\":\"2009-05-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les Pirates du Chapeau de Paille se battent contre l'un des Pacifistas, et bien qu'il ne possède pas les pouvoirs du Fruit du Démon de Kuma, il est toujours capable de résister à leurs attaques les plus puissantes tout en tirant des lasers dévastateurs sur l'équipage.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/634701.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":402,\"absoluteNumber\":402,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:45:34\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":634711,\"seriesId\":81797,\"name\":\"Un autre puissant ennemi apparaît ! Sentoumaru et sa grande hache\",\"aired\":\"2009-05-31\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les Chapeaux de Paille combinent leurs attaques les plus puissantes pour vaincre le Pacifista, mais sont épuisés après la bataille. Sentomaru arrive avec un autre Pacifista et Luffy tente de s'échapper, divisant les Chapeaux de Paille en trois groupes. Malheureusement, Sentomaru intercepte son groupe, le Pacifista coupe le groupe de Sanji et Kizaru attaque le groupe de Zoro, renversant Zoro et se préparant à l'achever.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/634711.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":403,\"absoluteNumber\":403,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:45:52\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":634721,\"seriesId\":81797,\"name\":\"Le féroce Amiral Kizaru attaque - La situation désespérée de l'équipage de chapeau de paille !\",\"aired\":\"2009-06-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les tentatives d'Usopp et Brook pour attaquer Kizaru échouent, mais Rayleigh arrive, réussissant à bloquer l'attaque de Kizaru et à le retenir. Luffy ordonne à son équipage de battre en retraite, déclarant les ennemis impossibles à vaincre pour le moment, mais Sentomaru et les autres Pacifista empêchent leur fuite.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/634721.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":404,\"absoluteNumber\":404,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:46:02\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":742531,\"seriesId\":81797,\"name\":\"Mes compagnons ont disparus - Le dernier jour de l'équipage du Chapeau de Paille\",\"aired\":\"2009-06-14\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Sentomaru laisse entendre que les pouvoirs de Kuma envoient les gens voler dans les airs pendant des jours et que Luffy devrait renoncer à revoir Zoro. Les motivations de Kuma deviennent discutables lorsqu'il fait disparaître le Pacifista, donne à Rayleigh des informations secrètes et refuse de s'expliquer à Kizaru.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/742531.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":405,\"absoluteNumber\":405,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:46:20\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":742541,\"seriesId\":81797,\"name\":\"Arc spécial historique ! Le chef Luffy ré-apparait\",\"aired\":\"2009-06-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"À Grand Jipang, une course est sur le point d'avoir lieu où une équipe transporte un sanctuaire portable jusqu'à la ligne d'arrivée. Le prix est la chance de voir un trésor légendaire censé exaucer les vœux. (HS)\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/742541.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":406,\"absoluteNumber\":406,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:51:31\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":742551,\"seriesId\":81797,\"name\":\"Arc spécial historique ! Détruisons-le ! Le piège de la compagnie Thriller\",\"aired\":\"2009-06-28\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Brook part tenter de vaincre la Thriller Company lui-même, mais finit par devenir leur captif, mais Luffy et Zoro le sauvent. (HS)\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/742551.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":407,\"absoluteNumber\":407,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 10:56:31\",\"finaleType\":\"season\",\"year\":\"2009\"},{\"id\":742561,\"seriesId\":81797,\"name\":\"Débarquement ! Amazon Lily, l'île interdite aux hommes\",\"aired\":\"2009-07-05\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après avoir volé dans les airs pendant plusieurs jours, Luffy se retrouve au milieu d'une jungle. Il essaie d'utiliser la Vivrecard de Rayleigh pour retrouver son chemin vers Sabaody, mais ne fait que se fatiguer.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/742561.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":408,\"absoluteNumber\":408,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 11:02:31\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":834921,\"seriesId\":81797,\"name\":\"Dépêchez-vous ! Retour à l'équipage - Aventure sur l'île des femmes\",\"aired\":\"2009-07-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy se réveille dans une cage, entouré des curieuses Amazones. Margaret lui donne une nouvelle paire de vêtements à porter, mais les autres Amazones décident alors de l'achever, car elles détestent les hommes.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/834921.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":409,\"absoluteNumber\":409,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 11:04:01\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":834931,\"seriesId\":81797,\"name\":\"Tous le monde l'aime ! L'impératrice pirate Hancock\",\"aired\":\"2009-07-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy tente de fabriquer un radeau pour quitter l'île, mais échoue complètement et doit être sauvé de la noyade par Margaret. Elle détermine qu'elle s'attache trop à lui et décide de l'attaquer avec son tir à l'arc surpuissant.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/834931.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":410,\"absoluteNumber\":410,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 11:05:18\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":894141,\"seriesId\":81797,\"name\":\"Le secret caché dans leurs dos - Luffy rencontre la Princesse Serpent\",\"aired\":\"2009-08-02\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"En trébuchant autour d'Amazon Lily, Luffy décide de trouver le chef des pirates kuja et cherche le bâtiment le plus haut, il s'écrase dans le bain où se baignait la princesse serpent.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/894141.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":411,\"absoluteNumber\":411,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 11:05:29\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":894151,\"seriesId\":81797,\"name\":\"Le jugement sans coeur ! Margaret transformée en pierre !!\",\"aired\":\"2009-08-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy envisage de trouver la « personne importante » pour l'aider à monter sur un bateau. Mais soudain, Luffy tombe dans le bain de Hancock.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/894151.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":412,\"absoluteNumber\":412,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 11:05:41\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":961231,\"seriesId\":81797,\"name\":\"Dure épreuve pour Luffy ! Le pouvoir du Haki des soeurs serpents !\",\"aired\":\"2009-08-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Lorsque Luffy bat Bacura, le bourreau de la panthère, Luffy part combattre Boa Marigold et Boa Sandersonia. Boa Sandersonia joue avec la statue de Margaret pour faire souffrir Luffy.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/961231.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":413,\"absoluteNumber\":413,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 11:06:01\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":961241,\"seriesId\":81797,\"name\":\"Combat à pleine puissance !! Gomu Gomu vs. Hebi Heb\",\"aired\":\"2009-08-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy active Gear Second et domine le combat. Lorsque Boa Marigold déclenche une technique de feu que Luffy esquive celle-ci brûle les vêtements de Sandersonia, Luffy semble être leur bouée de sauvetage et dit que leur dos n'a rien à voir avec leur combat. Boa Hancock évacue tout le monde dans l'arène au risque qu'ils voient les \\\"Gorgon Eyes\\\".\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/961241.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":414,\"absoluteNumber\":414,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 11:06:14\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":961251,\"seriesId\":81797,\"name\":\"L'aveu d'Hancock - Le choquant passé des sœurs\",\"aired\":\"2009-08-30\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après avoir gagné la confiance de Hancock, les sœurs serpents racontent leur terrifiant passé.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/961251.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":415,\"absoluteNumber\":415,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 11:06:51\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":961261,\"seriesId\":81797,\"name\":\"Sauver Ace ! La nouvelle destination est l'immense prison\",\"aired\":\"2009-09-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après avoir tout raconté à Luffy sur son passé, Hancock accepte de le conduire jusqu'à l'archipel Sabaody sur son navire. Elle invite également Luffy à leur banquet de ce soir et rentre se reposer.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/961261.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":416,\"absoluteNumber\":416,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 11:08:11\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":1058711,\"seriesId\":81797,\"name\":\"L'amour est un ouragan ! Mero Mero Hancock\",\"aired\":\"2009-09-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Alors que Boa souffre toujours du mal d'amour, Hancock et Luffy décidèrent de monter à bord du navire de la Marine, détenu par le vice-amiral Momonga.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1058711.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":417,\"absoluteNumber\":417,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 11:08:36\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":1109711,\"seriesId\":81797,\"name\":\"Retour sur l'équipage ! La météorologie et l'ile de Karakuri\",\"aired\":\"2009-09-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Nami se réveille sur Wezaria (Weatheria) et se retrouve chez un résident local. Pour tenter de l'amuser, il lui montre les solides nœuds de vent que Nami utilisera plus tard pour arrêter un cyclone.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1109711.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":418,\"absoluteNumber\":418,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 11:08:56\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":1109721,\"seriesId\":81797,\"name\":\"Retour sur l'équipage ! L'ile des oiseaux géants et le paradis rose !\",\"aired\":\"2009-09-27\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Chopper est réveillé par d'énormes oiseaux qui veulent l'utiliser comme jouet et quand il leur échappe finalement, les indigènes de l'île tentent de le manger.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1109721.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":419,\"absoluteNumber\":419,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 11:09:07\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":1109731,\"seriesId\":81797,\"name\":\"Retour sur l'équipage ! Le pont connectant les îles et la plante carnivore !\",\"aired\":\"2009-10-04\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Robin est retrouvée inconsciente dans la neige par Soran. Robin découvre bientôt que Tequila Wolf n'est rien d'autre qu'un énorme pont en construction depuis plus de 700 ans et que les habitants sont tous des ouvriers travaillant comme esclaves.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1109731.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":420,\"absoluteNumber\":420,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 11:09:20\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":1159031,\"seriesId\":81797,\"name\":\"Retour sur l'équipage ! La princesse négative et le Roi des Démons !\",\"aired\":\"2009-10-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro est retenu contre son gré par Perona, Brook est pris pour le roi des ténèbres et Luffy continue de se frayer un chemin vers Ace !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1159031.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":421,\"absoluteNumber\":421,\"seasonNumber\":1,\"lastUpdated\":\"2025-06-09 11:09:30\",\"finaleType\":\"season\",\"year\":\"2009\"},{\"id\":1702951,\"seriesId\":81797,\"name\":\"Une vie en danger ! Pénétrer dans la prison sous-marine Impel Down !\",\"aired\":\"2009-10-18\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Garp dit à Ace que Luffy connaît désormais sa filiation et qu'il avait espéré qu'Ace et Luffy deviendraient des marines. Ace dit que c'est impossible parce que lui et Luffy sont des descendants de criminels, et que comme il ne se souvient pas de son père et ne se soucie pas de son père, il a pris le nom de sa mère et considère Barbe Blanche comme son seul père.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1702951.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":422,\"absoluteNumber\":422,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 04:49:35\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":1702961,\"seriesId\":81797,\"name\":\"Réunion en Enfer ! Le puissant utilisateur du Bara Bara No Mi !\",\"aired\":\"2009-10-25\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Hancock transforme Domino (et la Surveillance du Den Den Mushi) en pierre avant qu'elle ne puisse subir le contrôle corporel, permettant à Luffy de s'échapper dans la prison. Au niveau 1, Luffy rencontre Baggy, qui tente de s'échapper de la prison.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1702961.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":423,\"absoluteNumber\":423,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 04:50:02\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":1702971,\"seriesId\":81797,\"name\":\"Intrusion dans l'Enfer Pourpre ! Le plan tape-à-l'oeil de Baggy !\",\"aired\":\"2009-11-01\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Baggy et Luffy se frayent un chemin à travers l'entrée du niveau 2. en passant par l'enfer cramoisi du niveau 1, où sont détenus les criminels les plus bas. Pour convaincre Baggy d'aider Luffy à atteindre le niveau 2, il lui a donné son bracelet (qu'il a reçu de Nami), ce qui était apparemment un indice sur un trésor que Baggy recherchait.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1702971.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":424,\"absoluteNumber\":424,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 04:50:22\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":1702981,\"seriesId\":81797,\"name\":\"L'Homme le plus fort de la Prison ! Arrivée de l'Homme-Poison Magellan !\",\"aired\":\"2009-11-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Hancock et les autres atteignent enfin le bureau de Magellan, un grand homme qui a mangé le Doku no Mi (Poison Poison Fruit). Luffy et Baggy trouvent quant à eux le niveau 2 rempli d'animaux sauvages, mais Luffy parvient à les gérer sans trop de problèmes.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1702981.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":425,\"absoluteNumber\":425,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 04:50:40\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":1702991,\"seriesId\":81797,\"name\":\"Le 'Lion Doré' expose ses ambitions\",\"aired\":\"2009-11-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Dans un flashback, il est révélé qu'il y a 20 ans, un pirate nommé \\\"Gold Lion\\\" Shiki s'est coupé les jambes et s'est échappé d'Impel Down.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1702991.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":426,\"absoluteNumber\":426,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 04:51:27\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":1703001,\"seriesId\":81797,\"name\":\"Le 'Little East Blue' est visé\",\"aired\":\"2009-11-22\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les Chapeaux de Paille rencontrent des gens dans des endroits qui leur rappellent d'où ils viennent.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1703001.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":427,\"absoluteNumber\":427,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 04:51:49\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":1703011,\"seriesId\":81797,\"name\":\"L'assaut vicieux de l'équipage pirate d'Amigo\",\"aired\":\"2009-11-29\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le reste des Chapeaux de Paille entendent les combats sur l'île et décident de s'y rendre. Zoro et Sanji tentent d'attaquer Largo, qui utilise ses pouvoirs Net Net Fruit pour créer des filets à partir de matériaux qu'il mange et les capture tous les deux.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1703011.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":428,\"absoluteNumber\":428,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 04:52:12\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":1703021,\"seriesId\":81797,\"name\":\"Bataille décisive ! Luffy VS Largo !\",\"aired\":\"2009-12-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après s'être échappé du filet, Luffy assomme Largo au loin et part le combattre. Nami fait semblant d'évacuer les villageois, mais les emmène dans d'autres tunnels pour surprendre les pirates Amigo alors qu'ils combattent Zoro et Sanji.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1703021.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":429,\"absoluteNumber\":429,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 04:52:33\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":1703031,\"seriesId\":81797,\"name\":\"Un Capitaine Corsaire en prison ! Jimbei le premier fils de la mer.\",\"aired\":\"2009-12-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy, Buggy et M. 3 continuent de se battre jusqu'au niveau 2 d'Impel Down, traqués par les Manticores et les Puzzle Scorpions. Ils sont pourchassés dans l'antre d'une énorme bête, le Sphinx, qui effraie les autres animaux.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1703031.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":430,\"absoluteNumber\":430,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 04:52:52\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":1703041,\"seriesId\":81797,\"name\":\"Le piège de Saldeath - Niveau 3 : L'enfer de la faim\",\"aired\":\"2009-12-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy, Baggy et M. 3 se retrouvent au niveau 3, un sol stérile où règne une chaleur extrême. Là, ils sont pris dans un filet par Saldeath, le commandant lutin des Blugori. Cependant, grâce à l'intervention du Sphinx, ils parviennent à s'échapper.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1703041.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":431,\"absoluteNumber\":431,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 04:53:15\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":1703051,\"seriesId\":81797,\"name\":\"Le cygne est libre ! Réunion ! Bon Clay\",\"aired\":\"2009-12-27\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le personnel de la prison et Hancock arrivent enfin à l'étage où est détenu Ace. Lorsque les prisonniers deviennent bruyants, Magellan les fait taire en attaquant avec une Hydra fabriquée à partir du poison de son Fruit du Démon, et pendant que tout le monde est distrait, Hancock parvient à dire à Ace que Luffy est sur le point de le sauver, le surprenant grandement.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1703051.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":432,\"absoluteNumber\":432,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 04:53:36\",\"finaleType\":null,\"year\":\"2009\"},{\"id\":1703061,\"seriesId\":81797,\"name\":\"Le directeur Magellan en mouvement - Le piège pour Mugiwara est prêt !\",\"aired\":\"2010-01-10\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Magellan est finalement informé de l'arrivée de Luffy et décide de rassembler ses forces au niveau 4 et d'éloigner Luffy et ses compagnons. De retour au niveau 3, M. 2 révèle qu'il veut rencontrer Iva, le roi de Kamabakka, qui est emprisonné au niveau 5 alors que lui et Luffy arrivent dans une fosse géante menant au niveau 4.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1703061.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":433,\"absoluteNumber\":433,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 04:57:35\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":1703071,\"seriesId\":81797,\"name\":\"Préparation pour la guerre ! Une bataille décisive au niveau 4 : L'enfer des flammes\",\"aired\":\"2010-01-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Magellan et ses subordonnés font leurs propres préparatifs afin de capturer l'intrus et les condamnés évadés en divisant leurs forces pour garder les escaliers menant aux différents niveaux. Après avoir survécu à la chute, le groupe continue avec Luffy en tête car il peut sentir la nourriture dans la cuisine.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1703071.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":434,\"absoluteNumber\":434,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 04:57:57\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":1703081,\"seriesId\":81797,\"name\":\"La force de Magellan ! Bon Clay fuit devant son ennemi\",\"aired\":\"2010-01-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Magellen commence à attaquer Luffy et Bon Kurei. Luffy essaie de riposter mais Bon Kurei fait tout ce qu'il peut pour que Luffy s'enfuie. Magellen informe alors les deux qu'ils ont bloqué les escaliers menant aux niveaux 5 et 3.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1703081.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":435,\"absoluteNumber\":435,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 04:58:48\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":1703091,\"seriesId\":81797,\"name\":\"C'est l'heure de l'épreuve de force ! L'attaque-suicide ultime de Luffy !\",\"aired\":\"2010-01-31\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Magellan met Luffy dans un coin et utilise ses pouvoirs de fruit du démon pour empoisonner Luffy. Pendant ce temps, Bon Kurei tente de sauver Baggy le Clown et M. 3.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1703091.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":436,\"absoluteNumber\":436,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 04:59:09\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":1703101,\"seriesId\":81797,\"name\":\"Parce qu'il est mon ami - Le sauvetage désespéré de Bon Clay\",\"aired\":\"2010-02-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Après avoir été touché par le poison de Magellan, Luffy est placé au niveau 5. C'est l'enfer glacial. Mr.2 cherche le remède en se faisant passer pour le vice-directeur et découvre qu'il est trop tard pour Luffy. Il va voir Luffy avec Mr.3 et Buggy mais se retrouve face à des loups qui protègent cette zone. Maintenant, il doit combattre seul ces loups dans le froid, sans chemise.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1703101.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":437,\"absoluteNumber\":437,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:00:23\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":1941381,\"seriesId\":81797,\"name\":\"Un paradis en enfer ! Impel Down, Niveau 5.5 !\",\"aired\":\"2010-02-14\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Bon Kurei libère Luffy de sa cellule au niveau 5 et ensemble ils partent à la recherche d'Emporio Ivankov, le faiseur de miracles qui, selon Bon Kurei, peut guérir l'empoisonnement de Luffy. Pendant ce temps, Buggy et M. 3 tentent d'échapper aux loups en s'enfermant dans un bunker de cire, mais les loups se révèlent trop rusés pour eux et continuent de traquer les deux hommes.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1941381.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":438,\"absoluteNumber\":438,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:00:39\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":1941391,\"seriesId\":81797,\"name\":\"Le traitement de Luffy commence ! La miraculeuse faculté d'Ivankov !\",\"aired\":\"2010-02-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Pendant qu'Ivankov danse et plaisante avec ses partisans, un intrus les interrompt et déclare que son père, autrefois roi, a un jour rendu visite au royaume de Kambakka - et est revenu Gay !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1941391.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":439,\"absoluteNumber\":439,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:00:57\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":1941401,\"seriesId\":81797,\"name\":\"Croire aux miracles ! Bon Clay souhaite de tout son coeur !\",\"aired\":\"2010-02-28\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"M. 2 Bon Kurei apprend qu'Emporio Ivankov a la capacité de contrôler les hormones. Il peut changer la couleur de la peau, la température corporelle, le sexe, etc. Il découvre également que le terrain de New Kama se situe entre le niveau 5 et le niveau 6 et qu'il a été construit par un prisonnier qui avait la capacité de creuser un tunnel.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1941401.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":440,\"absoluteNumber\":440,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:01:16\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":1941411,\"seriesId\":81797,\"name\":\"Luffy revient à la vie ! Le plan d'évasion d'Ivankov commence !\",\"aired\":\"2010-03-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Alors que Luffy est enfin réanimé, il est informé par Emporio Ivankov des antécédents d'Iva-chan. Il est également indiqué qu'Ivankov est un leader auprès du père de Luffy : Dragon.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1941411.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":441,\"absoluteNumber\":441,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:01:32\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":1941421,\"seriesId\":81797,\"name\":\"Le convoi d'Ace commence ! Les défenses du niveau le plus bas, Niveau 6 !\",\"aired\":\"2010-03-14\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Alors que Luffy atteint le niveau six avec Ivankov et Inazuma, ils rencontrent l'ancien compagnon de cellule d'Ace ; Jinbei. Comme les trois prisonniers ne trouvent pas Ace dans sa cage, ils sont attaqués par des pièges et des gaz endormissants.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1941421.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":442,\"absoluteNumber\":442,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:01:52\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":1941431,\"seriesId\":81797,\"name\":\"La meilleure équipe est formée ! Tremble Impel Down !\",\"aired\":\"2010-03-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy, Ivankov et Inazuma rencontrent un vieil ennemi de Luffy ; Crocodile. Crocodile veut les rejoindre, affirmant qu'il peut créer un passage de secours dans le plafond grâce à ses pouvoirs de fruit du démon. Luffy refuse immédiatement lorsqu'il se souvient de qui est Crocodile et de ce qu'il a fait à Vivi. Crocodile dit qu'il n'a plus d'intérêt pour le pays d'Alabasta.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1941431.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":443,\"absoluteNumber\":443,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:02:18\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":1941441,\"seriesId\":81797,\"name\":\"Encore plus de chaos ! Barbe Noire débarque !\",\"aired\":\"2010-03-28\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Baggy et M. 3 se cachent des gardes au niveau 2. Après s'être assurés qu'il ne reste plus de gardes, ils ouvrent les cellules et libèrent les prisonniers afin qu'ils puissent créer une émeute. Au niveau 4, les citoyens de New Kama montent en trombe les escaliers.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1941441.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":444,\"absoluteNumber\":444,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:02:33\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":1941451,\"seriesId\":81797,\"name\":\"Une rencontre dangereuse ! Barbe Noire et Shiryû de la Pluie\",\"aired\":\"2010-04-04\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le niveau 4 est en émeute et les Demon Guards combattent l'armée Newkama. Mais ensuite, les six combattants les plus puissants du Newkama ont mis en place leur plan pour éliminer le thrash appelé Demon Guards.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/1941451.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":445,\"absoluteNumber\":445,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:19:22\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2043061,\"seriesId\":81797,\"name\":\"Son esprit est inébranlable! Hannyabal donne tout ce qu'il a\",\"aired\":\"2010-04-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La porte du niveau 3 s'ouvre, seulement pour qu'Hannyabal sorte. Inazuma et Luffy le regardent surpris, seulement pour qu'Hannyabal dise au pirate cambrioleur qu'il ne permettra pas à des ordures comme lui de voyager sur les mers.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2043061.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":446,\"absoluteNumber\":446,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:19:50\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2043071,\"seriesId\":81797,\"name\":\"Un jet-pistol plein de rage - Luffy contre Barbe Noire\",\"aired\":\"2010-04-18\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy est furieux, frappe Barbe Noire, faisant voler ce dernier contre le mur. Barbe Noire se venge et active Kurozou, faisant voler Luffy dans sa main. Il attrape alors le capitaine pirate et le jette à terre, faisant couler du sang de sa bouche, à la surprise de Crocodile.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2043071.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":447,\"absoluteNumber\":447,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:20:06\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2043081,\"seriesId\":81797,\"name\":\"Stopper Magellan! Ivan sort son attaque secrète\",\"aired\":\"2010-04-25\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et les autres prisonniers se rapprochent de la surface après avoir franchi les niveaux 3 et 2. Cependant, afin de retarder Magellan, qui rattrape rapidement son retard, Ivankov et Inazuma restent derrière, Inazuma coupe les escaliers du niveau 3 au niveau 2. , et Ivankov reste pour combattre Magellan avec son \\\"Newkama Kenpo\\\". Malgré tous ses efforts, il est finalement vaincu par Magellan.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2043081.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":448,\"absoluteNumber\":448,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:20:23\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2043091,\"seriesId\":81797,\"name\":\"Le plan de Magellan! L'évasion est contrée\",\"aired\":\"2010-05-02\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Magellan atteint le niveau 2 et Luffy revient pour venger Inazuma et Ivankov tombés au combat. Il est arrêté par M. 2, qui lui rappelle ce qui s'est passé la dernière fois lorsqu'il a tenté de combattre le directeur en chef. Magellan lance une Hydra sur les évadés.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2043091.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":449,\"absoluteNumber\":449,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:20:45\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2176651,\"seriesId\":81797,\"name\":\"Une situation désepérée pour les évadés - La technique interdite\",\"aired\":\"2010-05-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Jinbei, Crocodile et M. 1 ont finalement sécurisé un navire de la Marine avec lequel s'échapper, tandis que Luffy continue son combat contre Magellan avec l'aide des pouvoirs Doru Doru no Mi de M. 3. Bien qu'au début, les deux hommes soient convaincus de pouvoir battre le Gardien avec leurs capacités combinées, Magellan - voyant que la situation devient désespérée.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2176651.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":450,\"absoluteNumber\":450,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:21:02\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2215271,\"seriesId\":81797,\"name\":\"Le dernier miracle - Passer la Porte de la Justice\",\"aired\":\"2010-05-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"M. 2 se met en jeu pour sauver Luffy et les autres, en se déguisant en directeur Magellan, mais ce faisant, il sacrifie toute chance de s'échapper alors que le vrai Magellan le coince dans la salle de contrôle de la Porte de la Justice.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2215271.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":451,\"absoluteNumber\":451,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:21:19\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2215291,\"seriesId\":81797,\"name\":\"Direction le QG de la Marine - Le voyage pour sauver Ace\",\"aired\":\"2010-05-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Au niveau 4, l'Equipage de Barbe Noire apparait guéri du poison mortel de Magellan. C'est en vérité Shiliew de la Pluie, l'ancien gardien-chef d'Impel Down qui leur a administré l'antidote. Marshall D. Teach lui propose alors de rejoindre son équipage, proposition qu'il accepte. De leur côté, Luffy, Baggy et les autres prennent la direction de Marine Ford, pour libérer Ace.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2215291.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":452,\"absoluteNumber\":452,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:21:33\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2272921,\"seriesId\":81797,\"name\":\"Retour sur l'équipage! Weatheria Report et Animaux Androides\",\"aired\":\"2010-05-30\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Du côté de Nami, on apprend que l'île céleste se déplace grâce au vent tout droit en direction de l'Archipel des Sabaody. Notre navigatrice décide donc de rester sur Weatheria jusqu'à ce qu'ils atteignent l'Archipel. De son côté, Franky agit toujours comme un gentleman à cause du thé qu'il a mis dans son ventre.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2272921.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":453,\"absoluteNumber\":453,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:21:57\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2340291,\"seriesId\":81797,\"name\":\"Retour sur l'équipage! Le pays des oiseaux géants et la confrontation rose\",\"aired\":\"2010-06-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Sanji est poursuivi par les Okamas sur l'île de Kedétrav . Afin de pouvoir partir de l'île, le cuisinier accepte d'affronter Caroline, l'okama le plus fort de royaume. De son côté, Chopper est toujours coincé sur l'île du Royaume Dézoizo où notre médecin de bord s'est trouvé un nouvel ami.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2340291.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":454,\"absoluteNumber\":454,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:22:15\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2350411,\"seriesId\":81797,\"name\":\"Retour sur l'équipage! L'armée révolutionnaire et le piège de la forêt Gloutonne\",\"aired\":\"2010-06-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Robin, capturé par la garde de Tequila Wolf, a été envoyé en prison. Cependant, grâce à Soran et à l'armée des révolutionnaires Robin et les autres ont pu être libérés. De son côté, Ussop essaye d'échapper aux plantes carnivores de l'Archipel de Boing avec l'aide d'Héraclès.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2350411.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":455,\"absoluteNumber\":455,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 05:22:32\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2350451,\"seriesId\":81797,\"name\":\"Retour sur l'équipage! La grande pierre tombale et les culottes de gratitude\",\"aired\":\"2010-06-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Zoro cherche un moyen de s'échapper de l'île sur laquelle il se trouve. Pendant ce temps Brook, comprend que les habitants qui le prennent pour Satan cherchent en vérité à se débarrasser de leurs ennemis, une tribu qui ravage leur île\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2350451.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":456,\"absoluteNumber\":456,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:06:42\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2399671,\"seriesId\":81797,\"name\":\"Flashback Spécial avant MarineFord - Le serment des frères!\",\"aired\":\"2010-06-27\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy regarde la Vivre Card d'Ace qui continue de brûler et commence une conversation avec Jinbe. Il se rappelle alors que, lors de son enfance, lui et son frère ont toujours été ensemble, que ce soit pour manger, dormir ou même tester leur force. Débute ainsi différents flashback.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2399671.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":457,\"absoluteNumber\":457,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:11:07\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2456341,\"seriesId\":81797,\"name\":\"Flashback Spécial avant MarineFord - Réunis! Les 3 Amiraux\",\"aired\":\"2010-07-11\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Chaque Corsaires et chaque Amiraux sont introduits un par un par leurs actions passés qui nous sont montrées\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2456341.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":458,\"absoluteNumber\":458,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:11:48\",\"finaleType\":\"season\",\"year\":\"2010\"},{\"id\":2495571,\"seriesId\":81797,\"name\":\"Le moment de la bataille décisive approche! Le plus puissante formation de guerre\",\"aired\":\"2010-07-18\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Alors qu'il ne restent que trois heures avant l'exécution d'Ace, Luffy atteint Marine Ford mais trouve la Porte de la Justice fermée. Partout dans le monde, la nouvelle d'une guerre opposant Barbe Blanche aux forces de la Marine se répand.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2495571.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":459,\"absoluteNumber\":459,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:12:25\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2495581,\"seriesId\":81797,\"name\":\"Une énorme flotte apparaît - Invasion! Les Pirates de Barbe Blanche\",\"aired\":\"2010-08-01\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le monde est choqué par la révélation de l'identité du père d'Ace. La mère d'Ace, Portgas D. Rouge, protège Ace des Marines et meurt après sa naissance. Aux portes de la justice près de Marineford, Luffy et les prisonniers d'Impel Down sont témoins de l'ouverture mystérieuse de la porte. De retour à Marineford, Barbe Blanche et ses alliés lancent leur invasion sous l'eau.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2495581.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":460,\"absoluteNumber\":460,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:12:58\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2600901,\"seriesId\":81797,\"name\":\"Le Début de la bataille! Le passé d'Ace et de Barbe Blanche\",\"aired\":\"2010-08-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Alors que Barbe Blanche fait son apparition, Ace se souvient des événements qui l'ont amené à devenir membre des Pirates de Barbe Blanche.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2600901.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":461,\"absoluteNumber\":461,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:13:26\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2634031,\"seriesId\":81797,\"name\":\"La Puissance de détruire le Monde! Le Pouvoir du Gura Gura Fruit\",\"aired\":\"2010-08-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les tremblements de terre provoqués par Barbe Blanche provoquent un tsunami sur Marineford. Après la première attaque, d’autres soldats rejoignent la mêlée et la guerre commence réellement.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2634031.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":462,\"absoluteNumber\":462,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:13:50\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2676441,\"seriesId\":81797,\"name\":\"Tout réduire en cendres! Le Pouvoir de l'Amiral Akainu\",\"aired\":\"2010-08-22\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Tous les différents commandants de Barbe Blanche montrent leurs compétences et capacités, tout comme certains Marines. Akainu révèle ses pouvoirs.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2676441.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":463,\"absoluteNumber\":463,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:14:18\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2694241,\"seriesId\":81797,\"name\":\"Le descendant du Démon! Little Odz Jr s'élance!\",\"aired\":\"2010-08-29\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La bataille bat à son plein à Marine Ford. Little Oz Jr. impressionne les Marines par sa taille et fonce vers la plate-forme où est enchainé Ace, ouvrant ainsi une voie à travers la baie pour les Pirates de Barbe Blanche.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2694241.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":464,\"absoluteNumber\":464,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:14:47\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2694251,\"seriesId\":81797,\"name\":\"Seul le vainqueur est la Justice - C'est parti! Le plan de Sengoku\",\"aired\":\"2010-09-05\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Little Oz Jr. a risqué sa propre vie pour ouvrir la voie. Les Pirates de Barbe Blanche se précipitent vers l'échafaud, mais juste au moment où ils semblent vouloir sauver Ace de l'exécution, Sengoku est déjà en train de formuler un nouveau plan.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2694251.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":465,\"absoluteNumber\":465,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:15:14\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2796941,\"seriesId\":81797,\"name\":\"La troupe du Chapeau de Paille arrive - Le champ de bataille devient plus intense\",\"aired\":\"2010-09-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et les prisonniers d'Impel Down apparaissent soudainement du ciel et atterrissent en plein milieu du champ de bataille. Luffy repère enfin son frère, Ace, et l'appelle. La bataille finale pour sauver Ace commence !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2796941.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":466,\"absoluteNumber\":466,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:15:50\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2836781,\"seriesId\":81797,\"name\":\"Je te sauverai même si je meurs - La bataille Luffy Vs les Marines commence\",\"aired\":\"2010-09-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Au QG de la Marine, Luffy mène la charge contre les forces militaires massives. Alors que les Marines attaquent Luffy par vagues, Ace lui crie de reculer.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2836781.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":467,\"absoluteNumber\":467,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:16:15\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2884651,\"seriesId\":81797,\"name\":\"Batailles successives! L'armée d'utilisateurs de Fruit du Démon Vs l'armée d'utilisateurs de Fruit du Démon\",\"aired\":\"2010-09-26\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et les Pirates de Barbe Blanche poursuivent leur assaut. Alors qu'il regarde ses coéquipiers affronter de puissants ennemis, Ace prend une décision. Pendant ce temps, la Marine élabore un nouveau plan.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2884651.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":468,\"absoluteNumber\":468,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:16:43\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2920481,\"seriesId\":81797,\"name\":\"Kuma provoque des dégâts - L'attaque colérique d'Iva\",\"aired\":\"2010-10-03\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Ivankov et Bartholomew Kuma étaient autrefois compagnons, mais malgré les cris désespérés d'Ivankov, les attaques vicieuses de Kuma continuent. Puis Doflamingo révèle la vérité choquante sur ce qui est arrivé à Kuma.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2920481.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":469,\"absoluteNumber\":469,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:17:10\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2951561,\"seriesId\":81797,\"name\":\"Mihawk le maître épéiste - L'attaque de l'épée noire s'approche de Luffy\",\"aired\":\"2010-10-10\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Dracule Mihawk, l'un des Sept Corsaires, se tient devant Luffy. Un seul coup du plus grand épéiste du monde divise facilement un énorme mur de glace en deux. Pendant ce temps à l'entrée de la baie, le plan de Sengoku se met en marche.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2951561.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":470,\"absoluteNumber\":470,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:17:38\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":2991511,\"seriesId\":81797,\"name\":\"L'opération d'extermination commence - La puissance de l'armée des Pacifistas\",\"aired\":\"2010-10-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les Pirates de Barbe Blanche et la Marine semblent être dans une impasse, aucune des deux forces ne parvenant à prendre le dessus. Mais alors une armée d'armes humaines apparaît, dont l'apparence ressemble à celle de Bartholomew Kuma, et les Pirates de Barbe Blanche et Luffy subissent désormais des attaques des deux côtés.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/2991511.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":471,\"absoluteNumber\":471,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:18:03\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":3025351,\"seriesId\":81797,\"name\":\"La ruse d'Akainu ! Barbe Blanche pris au piège\",\"aired\":\"2010-10-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La trahison de Squardo était inattendue. En le voyant s'approcher de Barbe Blanche, la suspicion grandit également parmi les hommes de la Marine. Les liens forts entre les Pirates de Barbe Blanche ont été détruits.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3025351.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":472,\"absoluteNumber\":472,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:18:26\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":3068921,\"seriesId\":81797,\"name\":\"L'opération d'encerclement commence ! Les pirates de Barbe Blanche coincés!!\",\"aired\":\"2010-10-31\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le pirate le plus puissant du monde, Barbe Blanche lui-même, entre dans la bataille. Libérant au maximum ses pouvoirs de Fruit du Tremblement, il décime progressivement les forces de la Marine. En réponse, Sengoku ordonne finalement le  plan de contre-attaque de la Marine !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3068921.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":473,\"absoluteNumber\":473,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:18:58\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":3068931,\"seriesId\":81797,\"name\":\"L'ordre d'effectuer l'exécution est donné - Passer à travers le mur d'encerclement!\",\"aired\":\"2010-11-07\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les Pirates de Barbe Blanche sont piégés dans la baie. Tandis que les tirs concentrés de la Marine se poursuivent, les pirates tentent d'atteindre la place par le chemin ouvert par Little Oz Jr. mais l'ordre d'exécution d'Ace a finalement été donné.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3068931.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":474,\"absoluteNumber\":474,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:19:24\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":3140941,\"seriesId\":81797,\"name\":\"Rush pour la phase finale! La manœuvre de Barbe Blanche pour renverser la vapeur\",\"aired\":\"2010-11-14\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy mène finalement la charge vers la place d'exécution. Mais les trois amiraux forment devant lui une lourde barrière, empêchant son avance. Pendant ce temps, dans la baie, Barbe Blanche se prépare à utiliser son atout dans sa manche pour renverser le cours de la bataille !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3140941.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":475,\"absoluteNumber\":475,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:33:53\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":3140951,\"seriesId\":81797,\"name\":\"Les forces de Luffy sont épuisées! Guerre totale au Oris Plaza!\",\"aired\":\"2010-11-21\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Enfin, Barbe Blanche se retrouve face à Ace ! Mais devant lui se trouvent également deux des amiraux, Aokiji et Akainu, et le conflit devient un duel de vie ou de mort. Au milieu du chaos, Marco trouve une opportunité d'avancer vers Ace !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3140951.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":476,\"absoluteNumber\":476,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:34:26\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":3140961,\"seriesId\":81797,\"name\":\"Le pouvoir qui réduit la vie - Retour des Hormones de tension\",\"aired\":\"2010-11-28\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les Pirates de Barbe Blanche commencent à succomber petit à petit grâce aux puissantes attaques de la Marine. Quand Ace voit ses compagnons blessés et au sol, il réfléchit à sa raison d'exister et les larmes lui remplissent les yeux. Pendant ce temps, Luffy prend la décision de risquer sa vie pour sauver Ace !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3140961.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":477,\"absoluteNumber\":477,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:34:50\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":3140971,\"seriesId\":81797,\"name\":\"Pour une promesse! Le choc de Luffy et Kobby\",\"aired\":\"2010-12-05\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"En utilisant l'hormone énergétique d'Ivankov, Luffy rassemble ses dernières forces et avance. Mais la Marine forme un immense mur sur leur passage. Parmi eux, un jeune homme tente de se motiver pour atteindre les objectifs qu'il s'est promis d'atteindre.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3140971.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":478,\"absoluteNumber\":478,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:35:16\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":3281141,\"seriesId\":81797,\"name\":\"Devant l'échafaud! Le chemin vers Ace est ouvert!!\",\"aired\":\"2010-12-12\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy utilise inconsciemment le Haki des Rois et empêche l'exécution d'Ace. Mais la Marine, consciente de la démonstration de sa puissance latente, conjugue ses efforts pour tenter de l'éliminer. A ce moment, Ivankov révèle enfin son dernier atout !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3281141.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":479,\"absoluteNumber\":479,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:35:41\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":3310201,\"seriesId\":81797,\"name\":\"Le chemin qu'ils ont choisi chacun - Luffy vs Garp!\",\"aired\":\"2010-12-19\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy avance le long du chemin créé par Inazuma avec l'intention d'atteindre Ace, mais Garp se met en travers de son chemin.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3310201.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":480,\"absoluteNumber\":480,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:36:12\",\"finaleType\":null,\"year\":\"2010\"},{\"id\":3324091,\"seriesId\":81797,\"name\":\"Ace libéré! L'ordre du Capitaine final de Barbe Blanche!\",\"aired\":\"2010-12-26\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Ace est enfin libéré ! L'image d'Ace et Luffy face à la Marine remonte le moral des Pirates de Barbe Blanche. Mais Barbe Blanche lui-même, envisageant un avenir lointain, prend sa propre décision !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3324091.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":481,\"absoluteNumber\":481,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:36:36\",\"finaleType\":\"season\",\"year\":\"2010\"},{\"id\":3428001,\"seriesId\":81797,\"name\":\"Le pouvoir qui brûle même le feu - La poursuite cruelle de Akainu\",\"aired\":\"2011-01-09\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Malheureusement, l'Amiral Akainu insulte Barbe Blanche et Ace, qui vient d'être libéré, décide de l'affronter afin de protéger l'honneur de son père. Il est toutefois aisément repoussé par l'Amiral qui en profite pour attaquer Luffy.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3428001.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":482,\"absoluteNumber\":482,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:37:17\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":3428011,\"seriesId\":81797,\"name\":\"Recherche d'une réponse - Ace aux Poings ardents meurt sur le champ de bataille\",\"aired\":\"2011-01-16\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Ace est transpercé par le poing d'Akainu alors qu'il protège Luffy. Jinbe et les Pirates de Barbe Blanche tentent de le sauver, mais Ace, conscient qu'il est sur le point de mourir, trouve la force de déclarer une dernière fois ses sentiments à ses compagnons.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3428011.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":483,\"absoluteNumber\":483,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:38:03\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":3428021,\"seriesId\":81797,\"name\":\"Le Q.G de la marine tombe en ruine ! La rage silencieuse de Barbe Blanche !\",\"aired\":\"2011-01-23\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"C'est une réalité trop dure à accepter. La mort cruelle d'Ace se concrétise sous les yeux de Luffy. Mais la bataille continue. La chasse s'intensifie et la colère de Barbe Blanche ébranle Marineford !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3428021.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":484,\"absoluteNumber\":484,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:38:32\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":3428031,\"seriesId\":81797,\"name\":\"Règlement de comptes - Barbe Blanche vs. Les pirates de Barbe Noire\",\"aired\":\"2011-01-30\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Barbe Noire, guidée par son ambition cachée, attaque Barbe Blanche. Celui-ci riposte, déterminée à venger Thatch. La bataille finale commence !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3428031.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":485,\"absoluteNumber\":485,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:39:01\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":3428041,\"seriesId\":81797,\"name\":\"Le début du spectacle - Le complot de Barbe Noire révélé\",\"aired\":\"2011-02-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La Marine avance pour décimer les pirates, dont la retraite a été ralentie par la perte de Barbe Blanche, et Akainu se relève devant Luffy inconscient. Pendant ce temps, Barbe Noire s'apprête à révéler ce qu'il prévoit pour le monde !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3428041.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":486,\"absoluteNumber\":486,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:39:18\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":3697371,\"seriesId\":81797,\"name\":\"La ténacité d'Akainu! Le poing de magma attaque Luffy\",\"aired\":\"2011-02-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Barbe Noire démontre les pouvoirs volés de Barbe Blanche pour faire des ravages. Pendant ce temps, Akainu et le reste de la Marine traquent les pirates au nom de la justice. La bataille ne semble pas proche de sa fin !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3697371.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":487,\"absoluteNumber\":487,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:39:41\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":3720791,\"seriesId\":81797,\"name\":\"Un cri désespéré - Les secondes de courage qui changent le sort du monde\",\"aired\":\"2011-02-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La chasse incessante de la Marine se poursuit. Alors que la bataille déjà insignifiante se poursuit sans fin, Koby se retrouve perdu dans un océan de tristesse sur le champ de bataille. La tristesse fait naître un grand pouvoir appelé courage, capable de faire changer de direction le monde !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3720791.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":488,\"absoluteNumber\":488,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:40:10\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":3720801,\"seriesId\":81797,\"name\":\"Shanks apparaît ! La grande guerre est enfin terminée\",\"aired\":\"2011-03-06\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les pirates du Roux apparaissent de manière inattendue ! Law essaie d'offrir à Luffy une chance de s'échapper pendant que les Marines reprennent leur souffle, mais les trois amiraux attaquent sans cesse. Ensuite, Shanks révèle les véritables raisons de sa présence sur le champ de bataille.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3720801.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":489,\"absoluteNumber\":489,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:40:43\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":3901001,\"seriesId\":81797,\"name\":\"Luttes de pouvoir. Le Début d'une nouvelle ère !\",\"aired\":\"2011-03-13\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"La fin de la guerre est le signal pour les pirates de mettre le cap sur une nouvelle ère. Barbe Blanche, qui représentait une énorme menace, a disparu et les mers deviennent désormais plus menaçantes.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3901001.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":490,\"absoluteNumber\":490,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:47:28\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":3937301,\"seriesId\":81797,\"name\":\"Retour sur l'île des femmes - Dure réalité pour Luffy !\",\"aired\":\"2011-03-20\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"À la suggestion de Hancock, Luffy est emmené sur l'île des Femmes pour se rétablir, et là, il reprend enfin conscience. Mais alors que Luffy retrouve ses souvenirs de la bataille, il est submergé par un profond désespoir.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3937301.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":491,\"absoluteNumber\":491,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:48:03\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":3949411,\"seriesId\":81797,\"name\":\"Le partenariat rêvé ! Luffy et Toriko s'affrontent !\",\"aired\":\"2011-04-03\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Luffy et Toriko font équipe dans une collaboration spéciale qui continue le premier épisode de Toriko ! Le duo le plus fort, formé par l'homme qui veut devenir le Roi Pirate et le Chasseur Gourmand qui veut composer son Menu Complet, affrontera la dure bataille de la découverte de nouveaux et délicieux ingrédients !\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/3949411.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":492,\"absoluteNumber\":492,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:49:05\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":4021961,\"seriesId\":81797,\"name\":\"Luffy et Ace - L'histoire de la rencontre des frères !\",\"aired\":\"2011-04-10\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Le cœur profondément blessé après avoir perdu Ace, Luffy se souvient de sa vie d'il y a dix ans. Ace, qui n'acceptait personne, et Luffy, qui le suivait partout. L'histoire de l'étrange lien qui les a rendus frères commence.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/4021961.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":493,\"absoluteNumber\":493,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:51:35\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":4076768,\"seriesId\":81797,\"name\":\"L'arrivée de Sabo ! Le garçon du Grey Terminal !\",\"aired\":\"2011-04-17\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Avec un sol recouvert de ferraille et air imprégné de fumée. Le Grey Terminal, une ville de hors-la-loi. Ace y a erré une fois, accumulant des fonds pour devenir pirate, aux côtés d'un autre compagnon.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/4076768.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":494,\"absoluteNumber\":494,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:52:14\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":4085288,\"seriesId\":81797,\"name\":\"Je ne fuirai pas! Le plan désespéré d'Ace !\",\"aired\":\"2011-04-24\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Ace et Sabo attaquent le repaire de Porchemy pour sauver Luffy, qui avait été capturé. Malgré l'incroyable force des pirates, Sabo trouve une opportunité de libérer Luffy et s'échappe, tandis qu'Ace prend une décision surprenante.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/4085288.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":495,\"absoluteNumber\":495,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:52:44\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":4085290,\"seriesId\":81797,\"name\":\"Un jour, nous prendrons la mer! La coupe de la fraternité des trois gamins!\",\"aired\":\"2011-05-01\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Un jour, ils décident de se rendre dans la ville haute du Royaume de Goa où Sabo est mystérieusement reconnu par un homme. Sabo avoue donc à Ace et Luffy qu'il est, en vérité, né de sang noble mais que puisqu'il n'avait pas le caractère des nobles il eu pris la décision de quitter la ville.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/4085290.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":496,\"absoluteNumber\":496,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:53:18\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":4093702,\"seriesId\":81797,\"name\":\"Quitter la famille Dadan ! La base secrète est terminée !\",\"aired\":\"2011-05-08\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Au Mont Corvo, Ace, Luffy et Sabo font vivre un enfer à Dadan. Suite à la visite de Garp, les 3 gamins décident de quitter leur maison et d'établir un repère en forêt.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/4093702.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":497,\"absoluteNumber\":497,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:54:04\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":4100124,\"seriesId\":81797,\"name\":\"Luffy apprenti ? L'homme qui s'était battu contre le Seigneur des Pirates !\",\"aired\":\"2011-05-15\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Sabo révèle à Naguri et Luffy que Gol D. Roger était le père de Ace. Cela provoquera par la suite la colère d'Ace. Au même moment, le père de Sabo conclut un marché avec Bluejam : celui-ci doit retrouver Sabo.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/4100124.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":498,\"absoluteNumber\":498,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:54:53\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":4103669,\"seriesId\":81797,\"name\":\"La lutte contre le gros tigre ! Qui sera le capitaine ?\",\"aired\":\"2011-05-22\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Les 3 frères commencent à se faire entraîner par Naguri. Ceux-ci l'aident en échange à construire un bateau pirate. Ace, Luffy et Sabo, étant devenus plus fort, partent combattre le tigre géant. Après s'être fait battre individuellement, ils décident d'unir leurs forces.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/4103669.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":499,\"absoluteNumber\":499,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:55:29\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":4103670,\"seriesId\":81797,\"name\":\"Liberté volée ! Le piège des Nobles arrive vers les trois frères\",\"aired\":\"2011-05-29\",\"runtime\":25,\"nameTranslations\":null,\"overview\":\"Sabo, d'abord réticent, accepte pour protéger ses frères. Une fois rentré, il apprend qu'un incendie va être déclenché dans le Grey Terminal. Il court donc dans le but de prévenir Ace et Luffy, qui au même moment travaillent pour Bluejam et ignorent tout de l'incendie.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/81797/4103670.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":500,\"absoluteNumber\":500,\"seasonNumber\":1,\"lastUpdated\":\"2026-07-04 08:56:06\",\"finaleType\":null,\"year\":\"2011\"}],\"overview\":\"かつてこの世の全てを手に入れた海賊王ゴールド・ロジャーが遺した「ひとつなぎの大秘宝（ワンピース）」をめぐり、幾多の海賊たちが覇権を賭けて争う大海賊時代。\\r\\n\\r\\nそんな時代に生まれ、幼い頃の命の恩人である海賊赤髪のシャンクスに憧れる少年モンキー・D・ルフィは、「ゴムゴムの実」という悪魔の実を食べてゴム人間となり、その副作用で泳げない体になりながらも、海賊王を目指して仲間と共に冒険と戦いを繰り広げていく。\",\"year\":\"1999\"},\"links\":{\"prev\":null,\"self\":\"https://api4.thetvdb.com/v4/series/81797/episodes/absolute/fra?page=0\",\"next\":\"https://api4.thetvdb.com/v4/series/81797/episodes/absolute/fra?page=1\",\"total_items\":1174,\"page_size\":500}}\n"