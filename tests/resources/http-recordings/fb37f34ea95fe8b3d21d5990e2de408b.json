e\":\"https://artworks.thetvdb.com/banners/episodes/161511/3456171.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":8,\"absoluteNumber\":8,\"seasonNumber\":1,\"lastUpdated\":\"2024-08-09 20:40:51\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":3650491,\"seriesId\":161511,\"name\":\"But at Last Came a Knock\",\"aired\":\"2011-03-06\",\"runtime\":51,\"nameTranslations\":[\"deu\",\"eng\",\"fin\",\"fra\",\"heb\",\"ita\",\"por\",\"rus\",\"spa\",\"pol\"],\"overview\":\"Monica comes back when Frank needs her to sign documents and decides to take Liam with her. Meanwhile, Steve and Fiona move together.\",\"overviewTranslations\":[\"deu\",\"eng\",\"fin\",\"fra\",\"heb\",\"ita\",\"por\",\"rus\",\"spa\",\"pol\"],\"image\":\"https://artworks.thetvdb.com/banners/episodes/161511/3650491.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":9,\"absoluteNumber\":9,\"seasonNumber\":1,\"lastUpdated\":\"2024-08-09 20:42:46\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":3650501,\"seriesId\":161511,\"name\":\"Nana Gallagher Had an Affair\",\"aired\":\"2011-03-13\",\"runtime\":49,\"nameTranslations\":[\"deu\",\"eng\",\"fin\",\"fra\",\"heb\",\"ita\",\"por\",\"rus\",\"spa\",\"pol\"],\"overview\":\"The children's paternity is put into question and Frank needs Carl's help.\",\"overviewTranslations\":[\"deu\",\"eng\",\"fin\",\"fra\",\"heb\",\"ita\",\"por\",\"rus\",\"spa\",\"pol\"],\"image\":\"https://artworks.thetvdb.com/banners/episodes/161511/3650501.jpg\",\"imageType\":11,\"isMovie\":0,\"seasons\":null,\"number\":10,\"absoluteNumber\":10,\"seasonNumber\":1,\"lastUpdated\":\"2024-08-09 20:43:06\",\"finaleType\":null,\"year\":\"2011\"},{\"id\":3650511,\"seriesId\":161511,\"name\":\"Daddyz Girl\",\"aired\":\"2011-03-20\",\"runtime\":46,\"nameTranslations\":[\"deu\",\"eng\",\"fin\",\"fra\",\"heb\",\"ita\",\"por\",\"rus\",\"spa\",\"pol\"],\"overview\":\"Tony comes closer to discovering what Steve is doing, while Fiona makes a new friend. In the meantime, Lip helps 