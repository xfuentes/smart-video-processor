\"},{\"id\":303871,\"seriesId\":79168,\"name\":\"The One with the Jam\",\"aired\":\"1996-10-03\",\"runtime\":22,\"nameTranslations\":null,\"overview\":\"Phoebe dates a man who thinks she is her twin sister. Monica uses her free time to make jam in an effort to get over Richard and considers insemination through a sperm bank.\\r\\n\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/79168/303871.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":3,\"absoluteNumber\":51,\"seasonNumber\":3,\"lastUpdated\":\"2024-10-07 20:16:44\",\"finaleType\":null,\"year\":\"1996\"},{\"id\":303872,\"seriesId\":79168,\"name\":\"The One with the Metaphorical Tunnel\",\"aired\":\"1996-10-10\",\"runtime\":22,\"nameTranslations\":null,\"overview\":\"Chandler tries to get over his fear of commitment. Phoebe poses as Joey's agent after she forgets to tell him about an audition. Ross panics after seeing Ben play with a Barbie doll and tries to convince him to play with more manly toys.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/79168/303872.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":4,\"absoluteNumber\":52,\"seasonNumber\":3,\"lastUpdated\":\"2024-10-07 20:18:09\",\"finaleType\":null,\"year\":\"1996\"},{\"id\":303873,\"seriesId\":79168,\"name\":\"The One with Frank Jr.\",\"aired\":\"1996-10-17\",\"runtime\":22,\"nameTranslations\":null,\"overview\":\"Phoebe's half-brother visits, but they have trouble bonding. Joey attempts to build an entertainment center. Ross is challenged to name the five celebrities he'd like to sleep with most.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/79168/303873.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":5,\"absoluteNumber\":53,\"seasonNumber\":3,\"lastUpdated\":\"2024-10-07 20:18:38\",\"finaleType\":null,\"year\":\"1996\"},{\"id\":303874,\"seriesId\":79168,\"name\":\"The One with the Flashback\",\"aired\":\"1996-10-31\",\"runtime\":22,\"nameTranslations\":null,