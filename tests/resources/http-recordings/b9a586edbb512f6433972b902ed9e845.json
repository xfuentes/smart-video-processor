":\"1994\"},{\"id\":303827,\"seriesId\":79168,\"name\":\"The One with the Blackout\",\"aired\":\"1994-11-03\",\"runtime\":22,\"nameTranslations\":null,\"overview\":\"When New York suffers from a blackout, Ross tries to tell Rachel that he likes her, and Chandler gets stuck in an ATM vestibule with a model.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/79168/303827.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":7,\"absoluteNumber\":7,\"seasonNumber\":1,\"lastUpdated\":\"2024-10-07 19:16:24\",\"finaleType\":null,\"year\":\"1994\"},{\"id\":303828,\"seriesId\":79168,\"name\":\"The One Where Nana Dies Twice\",\"aired\":\"1994-11-10\",\"runtime\":22,\"nameTranslations\":null,\"overview\":\"Monica and Ross mourn the death of their grandmother. Meanwhile, Chandler is irritated by office speculation that he's gay.\\r\\n\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/79168/303828.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":8,\"absoluteNumber\":8,\"seasonNumber\":1,\"lastUpdated\":\"2024-10-07 19:39:41\",\"finaleType\":null,\"year\":\"1994\"},{\"id\":303829,\"seriesId\":79168,\"name\":\"The One Where Underdog Gets Away\",\"aired\":\"1994-11-17\",\"runtime\":22,\"nameTranslations\":null,\"overview\":\"The gang's plans for Thanksgiving go awry after they get locked out of Monica and Rachel's apartment. Joey wins his first modeling gig.\",\"overviewTranslations\":null,\"image\":\"/banners/episodes/79168/303829.jpg\",\"imageType\":12,\"isMovie\":0,\"seasons\":null,\"number\":9,\"absoluteNumber\":9,\"seasonNumber\":1,\"lastUpdated\":\"2024-10-07 19:40:40\",\"finaleType\":null,\"year\":\"1994\"},{\"id\":303830,\"seriesId\":79168,\"name\":\"The One with the Monkey\",\"aired\":\"1994-12-15\",\"runtime\":22,\"nameTranslations\":null,\"overview\":\"The gang make (and break) a pact not to bring dates to their New Years Eve party. Phoebe starts dating a scientist. Ross compensates for his loneliness by getting a monkey.